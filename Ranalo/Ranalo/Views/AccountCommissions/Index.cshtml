@model Ranalo.Models.AccountCommissionsViewModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    const int pageSize = 20;
    const string key = "account-commissions";
    var agentView = Model.IsAgentView;
}

<link rel="stylesheet" href="~/css/watchlist-table.css?v=4">

<div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between">
            <div class="nk-block-head-content">
                <h3 class="nk-block-title page-title">Account Commissions</h3>
                <div class="nk-block-des text-soft">
                    @if (agentView)
                    {
                        <p>Your commission on each of your accounts. Upfront is 50% of the deposit. The bonus is 25% of the deposit once the contract is 90 days old. Arrears on an account past its lock date are deducted.</p>
                    }
                    else
                    {
                        <p>Agent commission: 50% of the deposit upfront, plus a 25% bonus once the contract is 90 days old, minus arrears on accounts past their lock date. Dealer commission: 30% of (total paid &minus; buying price &minus; agent commission).</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="nk-block">
        <div class="row g-gs">
            <div class="col-6 col-lg-3">
                <div class="card card-bordered h-100"><div class="card-inner">
                    <span class="sub-text">Agent commission earned</span>
                    <span class="d-block fs-5 fw-bold">KES @Model.AgentEarnedTotal.ToString("N0")</span>
                    <span class="d-block text-soft small">Upfront + bonus, before deductions</span>
                </div></div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card card-bordered h-100"><div class="card-inner">
                    <span class="sub-text">Arrears deducted</span>
                    <span class="d-block fs-5 fw-bold text-warning">KES @Model.AgentDeductedTotal.ToString("N0")</span>
                    <span class="d-block text-soft small">Accounts past their lock date</span>
                </div></div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card card-bordered h-100"><div class="card-inner">
                    <span class="sub-text">Paid to @(agentView ? "you" : "agents")</span>
                    <span class="d-block fs-5 fw-bold text-success">KES @Model.AgentPaidTotal.ToString("N0")</span>
                    <span class="d-block text-soft small">Commission payments recorded</span>
                </div></div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card card-bordered h-100"><div class="card-inner">
                    <span class="sub-text">Agent net balance</span>
                    <span class="d-block fs-5 fw-bold @(Model.AgentNetTotal < 0 ? "text-danger" : "")">KES @Model.AgentNetTotal.ToString("N0")</span>
                    <span class="d-block text-soft small">Earned &minus; deducted &minus; paid</span>
                </div></div>
            </div>
            @if (!agentView)
            {
                <div class="col-6 col-lg-3">
                    <div class="card card-bordered h-100"><div class="card-inner">
                        <span class="sub-text">Dealer commission</span>
                        <span class="d-block fs-5 fw-bold">KES @Model.DealerCommissionTotal.ToString("N0")</span>
                        <span class="d-block text-soft small">30% of dealer base</span>
                    </div></div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="card card-bordered h-100"><div class="card-inner">
                        <span class="sub-text">Paid to dealer</span>
                        <span class="d-block fs-5 fw-bold text-success">KES @Model.DealerPaidTotal.ToString("N0")</span>
                        <span class="d-block text-soft small">Dealer commission payments recorded</span>
                    </div></div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="card card-bordered h-100"><div class="card-inner">
                        <span class="sub-text">Dealer balance</span>
                        <span class="d-block fs-5 fw-bold">KES @Model.DealerBalanceTotal.ToString("N0")</span>
                        <span class="d-block text-soft small">Commission &minus; paid</span>
                    </div></div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="card card-bordered h-100"><div class="card-inner">
                        <span class="sub-text">Missing buying price</span>
                        <span class="d-block fs-5 fw-bold @(Model.MissingBuyingPriceCount > 0 ? "text-warning" : "")">@Model.MissingBuyingPriceCount</span>
                        <span class="d-block text-soft small">Accounts with no dealer commission yet</span>
                    </div></div>
                </div>
            }
        </div>
    </div>

    <div class="nk-block">
        <div class="card card-bordered card-stretch">
            <div class="card-inner-group">
                <div class="card-inner p-0">
                    @if (Model.Rows.Count == 0)
                    {
                        <div class="card-inner text-soft">No accounts found.</div>
                    }
                    else
                    {
                    <div class="table-responsive">
                        <table class="table mb-0" style="white-space:nowrap;" data-key="@key" data-page-size="@pageSize">
                            <thead>
                                <tr>
                                    <th class="wl-th" onclick="Ranalo.sortTable(this)">Customer</th>
                                    @if (Model.ShowDealer)
                                    {
                                        <th class="wl-th" onclick="Ranalo.sortTable(this)">Dealer</th>
                                    }
                                    @if (!agentView)
                                    {
                                        <th class="wl-th" onclick="Ranalo.sortTable(this)">Agent</th>
                                    }
                                    <th class="wl-th" onclick="Ranalo.sortTable(this)">Deposit</th>
                                    <th class="wl-th" onclick="Ranalo.sortTable(this)" title="50% of deposit">Agent Upfront</th>
                                    <th class="wl-th" onclick="Ranalo.sortTable(this)" title="25% of deposit once the contract is 90 days old">Agent Bonus</th>
                                    <th class="wl-th" onclick="Ranalo.sortTable(this)" title="Arrears on this account while it is past its lock date">Arrears Deducted</th>
                                    <th class="wl-th" onclick="Ranalo.sortTable(this)">Agent Paid</th>
                                    <th class="wl-th" onclick="Ranalo.sortTable(this)" title="Upfront + bonus - arrears deducted - paid">Agent Net</th>
                                    @if (!agentView)
                                    {
                                        <th class="wl-th" onclick="Ranalo.sortTable(this)">Total Paid</th>
                                        <th class="wl-th" onclick="Ranalo.sortTable(this)">Buying Price</th>
                                        <th class="wl-th" onclick="Ranalo.sortTable(this)" title="Total paid - buying price - agent commission">Dealer Base</th>
                                        <th class="wl-th" onclick="Ranalo.sortTable(this)" title="30% of dealer base">Dealer Comm.</th>
                                        <th class="wl-th" onclick="Ranalo.sortTable(this)">Dealer Paid</th>
                                        <th class="wl-th" onclick="Ranalo.sortTable(this)" title="Dealer commission - dealer paid">Dealer Balance</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.Rows.Count; i++)
                                {
                                    var r = Model.Rows[i];
                                    var noAgent = r.AgentName == null;
                                    <tr class="@(i >= pageSize ? "d-none" : "")" data-watchlist-row="@key">
                                        <td>
                                            <a href="/account-details/@r.AccountId" class="fw-medium">@r.CustomerName</a>
                                            <span class="d-block sub-text">AC: @r.AccountId &middot; @r.DaysSinceStart days</span>
                                        </td>
                                        @if (Model.ShowDealer)
                                        {
                                            <td>@r.DealerName</td>
                                        }
                                        @if (!agentView)
                                        {
                                            <td>@(noAgent ? "Direct sale" : r.AgentName)</td>
                                        }
                                        <td>KES @r.Deposit.ToString("N0")</td>
                                        @if (noAgent)
                                        {
                                            <td class="text-soft">-</td>
                                            <td class="text-soft">-</td>
                                            <td class="text-soft">-</td>
                                            <td class="text-soft">-</td>
                                            <td class="text-soft">-</td>
                                        }
                                        else
                                        {
                                            <td>KES @r.AgentUpfront.ToString("N0")</td>
                                            <td>
                                                @if (r.AgentBonusEarned)
                                                {
                                                    <span>KES @r.AgentBonus.ToString("N0")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-soft">in @r.DaysToBonus days</span>
                                                }
                                            </td>
                                            <td class="@(r.ArrearsDeducted > 0 ? "text-danger" : "")">KES @r.ArrearsDeducted.ToString("N0")</td>
                                            <td>KES @r.AgentPaid.ToString("N0")</td>
                                            <td class="fw-medium @(r.AgentNet < 0 ? "text-danger" : "")">KES @r.AgentNet.ToString("N0")</td>
                                        }
                                        @if (!agentView)
                                        {
                                            <td>KES @r.TotalPaid.ToString("N0")</td>
                                            @if (r.BuyingPrice.HasValue)
                                            {
                                                <td>KES @r.BuyingPrice.Value.ToString("N0")</td>
                                                <td class="@(r.DealerBase < 0 ? "text-danger" : "")">KES @r.DealerBase!.Value.ToString("N0")</td>
                                                <td>KES @r.DealerCommission!.Value.ToString("N0")</td>
                                                <td>KES @r.DealerPaid.ToString("N0")</td>
                                                <td class="fw-medium @(r.DealerBalance < 0 ? "text-danger" : "")">KES @r.DealerBalance!.Value.ToString("N0")</td>
                                            }
                                            else
                                            {
                                                <td class="text-warning">Not set</td>
                                                <td class="text-soft">-</td>
                                                <td class="text-soft">-</td>
                                                <td>KES @r.DealerPaid.ToString("N0")</td>
                                                <td class="text-soft">-</td>
                                            }
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.Rows.Count > pageSize)
                    {
                        <div class="card-inner d-flex" style="column-gap:1rem;">
                            <a href="#" class="link link-primary" data-more-for="@key" onclick="event.preventDefault(); Ranalo.showMoreRows(this, '@key', @pageSize);">Show @Math.Min(pageSize, Model.Rows.Count - pageSize) more</a>
                            <a href="#" class="link link-primary" data-less-for="@key" style="display:none;" onclick="event.preventDefault(); Ranalo.showLessRows(this, '@key', @pageSize);">Show less</a>
                        </div>
                    }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/watchlist-table.js"></script>
}
