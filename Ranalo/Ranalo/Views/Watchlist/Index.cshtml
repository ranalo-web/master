@using Ranalo.DataStore.DataModels
@using Ranalo.Models
@model WatchlistViewModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/watchlist-table.css?v=4">

<div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between">
            <div class="nk-block-head-content">
                <h3 class="nk-block-title page-title">Watchlist</h3>
                <div class="nk-block-des text-soft">
                    <p>Search for an account and flag it for attention. Admin sees every flagged account, dealers see their own, agents see their assigned accounts.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="nk-block">
        <div class="card card-bordered card-preview">
            <div class="card-inner">
                <span class="preview-title-lg overline-title">Add an account</span>
                <form action="/watchlist" method="get" class="form-inline">
                    <div class="form-group d-flex" style="gap: 8px;">
                        <input type="text" name="searchTerm" class="form-control" placeholder="Search by name, account no, or phone" value="@Model.SearchTerm">
                        <button type="submit" class="btn btn-primary">Search</button>
                    </div>
                </form>

                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <div class="mt-3">
                        @if (Model.SearchResults.Count == 0)
                        {
                            <p class="text-soft">No accounts matched "@Model.SearchTerm".</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                            <table class="table mb-0" style="white-space:nowrap;" data-key="watchlist-search" data-page-size="10">
                                <thead>
                                    <tr>
                                        <th class="wl-th" onclick="Ranalo.sortTable(this)">Account No</th>
                                        <th class="wl-th" onclick="Ranalo.sortTable(this)">Customer</th>
                                        <th class="wl-th" onclick="Ranalo.sortTable(this)">Device</th>
                                        <th class="wl-th"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var account in Model.SearchResults)
                                {
                                    <tr>
                                        <td><span class="fw-medium">@account.AccountNo</span></td>
                                        <td>@account.CustomerName</td>
                                        <td>@account.Make @account.Model</td>
                                        <td class="text-end">
                                            <form action="/watchlist/add" method="post">
                                                <input type="hidden" name="accountId" value="@account.AccountNo">
                                                <input type="hidden" name="searchTerm" value="@Model.SearchTerm">
                                                <button type="submit" class="btn btn-sm btn-outline-primary">Add to watchlist</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                            </div><!-- .table-responsive -->
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="nk-block">
        <div class="card card-bordered">
            <div class="card-inner card-inner-md">
                <span class="preview-title-lg overline-title">Current watchlist</span>
            </div>
            <div class="card-inner p-0">
                @if (Model.Watchlist.Count == 0)
                {
                    <div class="card-inner">
                        <p class="text-soft">No accounts on the watchlist yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                    <table class="table mb-0" style="white-space:nowrap;" data-key="watchlist" data-page-size="10">
                        <thead>
                            <tr>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Account</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Customer</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Dealer</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Agent</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Added By</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Added</th>
                                <th class="wl-th"></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var entry in Model.Watchlist)
                        {
                            <tr>
                                <td><span class="fw-medium">@entry.AccountId</span></td>
                                <td>@entry.CustomerName</td>
                                <td>@entry.DealerName</td>
                                <td>@(entry.AgentName ?? "-")</td>
                                <td>@entry.AddedByName <span class="text-soft">(@entry.AddedByRole)</span></td>
                                <td>@entry.AddedAtUtc.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    @if (entry.CanCurrentUserRemove)
                                    {
                                        <form action="/watchlist/remove" method="post">
                                            <input type="hidden" name="watchlistId" value="@entry.Id">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    </div><!-- .table-responsive -->
                }
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/js/watchlist-table.js"></script>
}
