@using Ranalo.DataStore.DataModels
@using Ranalo.Models
@model WatchlistViewModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between">
            <div class="nk-block-head-content">
                <h3 class="nk-block-title page-title">Watchlist</h3>
                <div class="nk-block-des text-soft">
                    <p>Search for an account and flag it for attention. Admin sees every flagged account, dealers see their own, agents see their assigned accounts.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="nk-block">
        <div class="card card-bordered card-preview">
            <div class="card-inner">
                <span class="preview-title-lg overline-title">Add an account</span>
                <form action="/watchlist" method="get" class="form-inline">
                    <div class="form-group d-flex" style="gap: 8px;">
                        <input type="text" name="searchTerm" class="form-control" placeholder="Search by name, account no, or phone" value="@Model.SearchTerm">
                        <button type="submit" class="btn btn-primary">Search</button>
                    </div>
                </form>

                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <div class="mt-3">
                        @if (Model.SearchResults.Count == 0)
                        {
                            <p class="text-soft">No accounts matched "@Model.SearchTerm".</p>
                        }
                        else
                        {
                            <div class="nk-tb-list nk-tb-ulist is-compact">
                                <div class="nk-tb-item nk-tb-head">
                                    <div class="nk-tb-col"><span class="sub-text">Account No</span></div>
                                    <div class="nk-tb-col"><span class="sub-text">Customer</span></div>
                                    <div class="nk-tb-col"><span class="sub-text">Device</span></div>
                                    <div class="nk-tb-col nk-tb-col-tools text-end"></div>
                                </div>
                                @foreach (var account in Model.SearchResults)
                                {
                                    <div class="nk-tb-item">
                                        <div class="nk-tb-col">@account.AccountNo</div>
                                        <div class="nk-tb-col">@account.CustomerName</div>
                                        <div class="nk-tb-col">@account.Make @account.Model</div>
                                        <div class="nk-tb-col nk-tb-col-tools text-end">
                                            <form action="/watchlist/add" method="post">
                                                <input type="hidden" name="accountId" value="@account.AccountNo">
                                                <input type="hidden" name="searchTerm" value="@Model.SearchTerm">
                                                <button type="submit" class="btn btn-sm btn-outline-primary">Add to watchlist</button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="nk-block">
        <div class="card card-bordered">
            <div class="card-inner card-inner-md">
                <span class="preview-title-lg overline-title">Current watchlist</span>
            </div>
            <div class="card-inner p-0">
                @if (Model.Watchlist.Count == 0)
                {
                    <div class="card-inner">
                        <p class="text-soft">No accounts on the watchlist yet.</p>
                    </div>
                }
                else
                {
                    <div class="nk-tb-list nk-tb-ulist is-compact">
                        <div class="nk-tb-item nk-tb-head">
                            <div class="nk-tb-col"><span class="sub-text">Account</span></div>
                            <div class="nk-tb-col"><span class="sub-text">Customer</span></div>
                            <div class="nk-tb-col tb-col-md"><span class="sub-text">Dealer</span></div>
                            <div class="nk-tb-col tb-col-md"><span class="sub-text">Agent</span></div>
                            <div class="nk-tb-col tb-col-md"><span class="sub-text">Added By</span></div>
                            <div class="nk-tb-col tb-col-sm"><span class="sub-text">Added</span></div>
                            <div class="nk-tb-col nk-tb-col-tools text-end"></div>
                        </div>
                        @foreach (var entry in Model.Watchlist)
                        {
                            <div class="nk-tb-item">
                                <div class="nk-tb-col">@entry.AccountId</div>
                                <div class="nk-tb-col">@entry.CustomerName</div>
                                <div class="nk-tb-col tb-col-md">@entry.DealerName</div>
                                <div class="nk-tb-col tb-col-md">@(entry.AgentName ?? "-")</div>
                                <div class="nk-tb-col tb-col-md">@entry.AddedByName <span class="text-soft">(@entry.AddedByRole)</span></div>
                                <div class="nk-tb-col tb-col-sm">@entry.AddedAtUtc.ToString("dd MMM yyyy")</div>
                                <div class="nk-tb-col nk-tb-col-tools text-end">
                                    @if (entry.CanCurrentUserRemove)
                                    {
                                        <form action="/watchlist/remove" method="post">
                                            <input type="hidden" name="watchlistId" value="@entry.Id">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
