@model List<Ranalo.Models.DealerCompletedContract>
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    const int pageSize = 20;
    const string key = "report-completed";
}

<link rel="stylesheet" href="~/css/watchlist-table.css?v=2">

<div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between">
            <div class="nk-block-head-content">
                <h3 class="nk-block-title page-title">Completed Contracts</h3>
                <div class="nk-block-des text-soft"><p>Fully paid off, most recent first (also includes near-complete accounts at 80%+ paid).</p></div>
            </div>
            <div class="nk-block-head-content">
                <a href="/@(ViewBag.BackLink)" class="btn btn-outline-light btn-white"><em class="icon ni ni-arrow-left"></em><span>Back to Dashboard</span></a>
            </div>
        </div>
    </div>

    <div class="nk-block">
        <div class="card card-bordered card-stretch">
            <div class="card-inner-group">
                <div class="card-inner p-0">
                    <div class="table-responsive">
                    <table class="table mb-0" style="white-space:nowrap;" data-key="@key" data-page-size="@pageSize">
                        <thead>
                            <tr>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Customer</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Product</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Completed</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Total Paid</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Duration</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Count; i++)
                            {
                                var c = Model[i];
                                <tr class="@(i >= pageSize ? "d-none" : "")" data-watchlist-row="@key">
                                    <td><span class="fw-medium">@c.CustomerName</span></td>
                                    <td>@c.ProductName</td>
                                    <td>@c.CompletedDate</td>
                                    <td>KES @c.TotalPaid.ToString("N0")</td>
                                    <td>@c.DurationMonths mo</td>
                                    <td><span class="badge @(c.Status == "Completed" ? "badge-dim bg-success" : "badge-dim bg-info")">@c.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                    @if (Model.Count > pageSize)
                    {
                        <div class="card-inner d-flex" style="column-gap:1rem;">
                            <a href="#" class="link link-primary" data-more-for="@key" onclick="event.preventDefault(); Ranalo.showMoreRows(this, '@key', @pageSize);">Show @Math.Min(pageSize, Model.Count - pageSize) more</a>
                            <a href="#" class="link link-primary" data-less-for="@key" style="display:none;" onclick="event.preventDefault(); Ranalo.showLessRows(this, '@key', @pageSize);">Show less</a>
                        </div>
                    }
                    @if (Model.Count == 0)
                    {
                        <div class="card-inner text-soft">No completed contracts found.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/watchlist-table.js"></script>
}
