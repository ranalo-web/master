@model List<Ranalo.Models.DealerWatchlistEntry>
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    const int pageSize = 20;
    const string key = "report-slowpayers";
}

<link rel="stylesheet" href="~/css/watchlist-table.css?v=2">

<div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between">
            <div class="nk-block-head-content">
                <h3 class="nk-block-title page-title">Slow Payers</h3>
                <div class="nk-block-des text-soft"><p>Behind schedule, still paying -- 1 to 7 days past the scheduled lock date.</p></div>
            </div>
            <div class="nk-block-head-content">
                <a href="/@(ViewBag.BackLink)" class="btn btn-outline-light btn-white"><em class="icon ni ni-arrow-left"></em><span>Back to Dashboard</span></a>
            </div>
        </div>
    </div>

    <div class="nk-block">
        <div class="card card-bordered card-stretch">
            <div class="card-inner-group">
                <div class="card-inner p-0">
                    <div class="table-responsive">
                    <table class="table mb-0" style="white-space:nowrap;" data-key="@key" data-page-size="@pageSize">
                        <thead>
                            <tr>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Customer</th>
                                @if (!(ViewBag.IsAgent is true))
                                {
                                    <th class="wl-th" onclick="Ranalo.sortTable(this)">Agent</th>
                                }
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Phone</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Next of Kin</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">2nd Next of Kin</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Amount Due</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Count; i++)
                            {
                                var e = Model[i];
                                <tr class="@(i >= pageSize ? "d-none" : "")" data-watchlist-row="@key">
                                    <td>
                                        <a href="/account-details/@e.AccountId" class="fw-medium">@e.CustomerName</a>
                                        <span class="d-block sub-text">AC: @e.AccountId</span>
                                    </td>
                                    @if (!(ViewBag.IsAgent is true))
                                    {
                                        <td>@(string.IsNullOrWhiteSpace(e.AgentName) ? "Unassigned" : e.AgentName)</td>
                                    }
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(e.Phone))
                                        {
                                            <span class="text-soft">-</span>
                                        }
                                        else
                                        {
                                            <a href="tel:@e.Phone">@e.Phone</a>
                                        }
                                    </td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(e.NextOfKinPhone))
                                        {
                                            <span class="text-soft">-</span>
                                        }
                                        else
                                        {
                                            <a href="tel:@e.NextOfKinPhone">@e.NextOfKinPhone</a>
                                            <span class="d-block sub-text">@e.NextOfKinName</span>
                                            @if (!string.IsNullOrWhiteSpace(e.NextOfKinIdNumber)) { <span class="d-block sub-text">ID: @e.NextOfKinIdNumber</span> }
                                        }
                                    </td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(e.NextOfKin2Phone))
                                        {
                                            <span class="text-soft">-</span>
                                        }
                                        else
                                        {
                                            <a href="tel:@e.NextOfKin2Phone">@e.NextOfKin2Phone</a>
                                            <span class="d-block sub-text">@e.NextOfKin2Name</span>
                                            @if (!string.IsNullOrWhiteSpace(e.NextOfKin2IdNumber)) { <span class="d-block sub-text">ID: @e.NextOfKin2IdNumber</span> }
                                        }
                                    </td>
                                    <td><span style="color:#b8860b;">@e.Detail</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                    @if (Model.Count > pageSize)
                    {
                        <div class="card-inner d-flex" style="column-gap:1rem;">
                            <a href="#" class="link link-primary" data-more-for="@key" onclick="event.preventDefault(); Ranalo.showMoreRows(this, '@key', @pageSize);">Show @Math.Min(pageSize, Model.Count - pageSize) more</a>
                            <a href="#" class="link link-primary" data-less-for="@key" style="display:none;" onclick="event.preventDefault(); Ranalo.showLessRows(this, '@key', @pageSize);">Show less</a>
                        </div>
                    }
                    @if (Model.Count == 0)
                    {
                        <div class="card-inner text-soft">No slow payers right now.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/watchlist-table.js"></script>
}
