@model Ranalo.Models.DealerDashboardViewModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<style>
    .wl-th {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: .03em;
        font-weight: 700;
        color: #526484;
        white-space: nowrap;
        text-align: left;
        cursor: pointer;
        user-select: none;
        background-color: #f5f6fa !important;
        padding: 10px 16px !important;
        border-bottom: 2px solid #e5e9f2 !important;
    }
    .wl-th:hover {
        color: #6576ff;
        background-color: #eef1fd !important;
    }
    .wl-sort-indicator {
        font-size: 9px;
    }
</style>

<div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between">
            <div class="nk-block-head-content">
                <h3 class="nk-block-title page-title">Dealer Dashboard</h3>
                <div class="nk-block-des text-soft">
                    <p>Welcome back, @Model.DealerName &mdash; here's how your store is performing.</p>
                </div>
            </div>
            <div class="nk-block-head-content">
                <ul class="nk-block-tools g-3">
                    <li>
                        <div class="btn-group">
                            <button type="button" id="revenuePeriodToggle" class="btn btn-outline-light btn-white dropdown-toggle" data-bs-toggle="dropdown">
                                <em class="icon ni ni-calendar"></em><span>Month</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end">
                                <ul class="link-list-opt no-bdr">
                                    <li><a href="#" class="revenue-period-opt" data-period="week"><span>Week</span></a></li>
                                    <li><a href="#" class="revenue-period-opt" data-period="month"><span>Month</span></a></li>
                                    <li><a href="#" class="revenue-period-opt" data-period="ytd"><span>Year to Date</span></a></li>
                                    <li><a href="#" class="revenue-period-opt" data-period="year"><span>Last 12 Months</span></a></li>
                                </ul>
                            </div>
                        </div>
                    </li>
                    <li>
                        <a href="#" class="btn btn-primary"><em class="icon ni ni-plus"></em><span>New Enrolment</span></a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="nk-block">
        <div class="row g-gs">
            @{
                // goodCount: used by the My Portfolio doughnut chart below
                // (accrual-based Good tier, unrelated to the lock-based
                // classification the Paying vs Non-Paying card uses).
                var goodCount = Math.Round(Model.TotalAccounts * Model.PortfolioGoodPct / 100);

                // Paying vs Non-Paying card: classified from Devices.NextLockDateIsoFormat
                // (Model.LockGoodCount/LockNonPayingCount), not the accrual-based
                // PortfolioGoodPct/InDefault used elsewhere -- see
                // DealerDashboardViewModel.LockGoodCount's doc comment for why.
                var lockTotal = Model.LockGoodCount + Model.LockNonPayingCount;
                var lockGoodPct = lockTotal > 0 ? Math.Round((decimal)Model.LockGoodCount / lockTotal * 100, 1) : 0;

                // New Accounts card's "in default" bottom line: PortfolioArrearsPct
                // is already lock-based (see the My Portfolio fix above), so
                // reuse it here too instead of the still-accrual-based
                // Model.DefaultRatePct/ActivePct/InDefault (those stay
                // untouched -- Total Arrears/Bad Debt below still depend on
                // Model.InDefault and are deliberately out of scope for now).
                var lockActivePct = 100 - Model.PortfolioArrearsPct;

                // Total Arrears card: ArrearsTotal is now "true" arrears only
                // (locked accounts -- see GetDealerArrearsClassificationAsync),
                // so ArrearsChangePct (still accrual-based, "vs last month")
                // no longer applies to it and isn't shown -- same reasoning
                // as the Paying vs Non-Paying card's dropped comparison.
                var arrearsAvgPerAccount = Model.ArrearsTrueCount > 0 ? Model.ArrearsTotal / Model.ArrearsTrueCount : 0;

                // Commissions are a lifetime calculation, not "this month" --
                // No trend/vs-last-month line for either commission card --
                // these are lifetime totals ("what's owed in total"), not
                // periodic like Revenue/Arrears/Bad Debt above. Both cards'
                // "paid" lines are period-*filtered* instead (share the
                // top-of-page toggle), not a trend -- see the JS below.
                // Agent-facing and dealer-facing figures split into their
                // own card rather than one combined "Commissions Paid" card,
                // since they're two different audiences' numbers (what the
                // dealer owes agents vs. what Ranalo owes the dealer) and,
                // as of this pass, two genuinely independent populations --
                // dealer commission is earned on every paid account
                // (including direct sales with no agent), agent commission
                // only on agent-assigned ones.

                // Bad Debt / Write-offs & Collections cards -- both live off
                // GetDealerArrearsClassificationAsync (see the Total Arrears
                // card above). No "vs last month" on either -- same no-history
                // reasoning as Total Arrears' dropped comparison.
                var badDebtAvgPerAccount = Model.BadDebtCount > 0 ? Model.BadDebtThisMonth / Model.BadDebtCount : 0;
                var writeOffAvgPerAccount = Model.WriteOffCount > 0 ? Model.WriteOffTotal / Model.WriteOffCount : 0;
            }
            @{
                var revenueGrowthUp = Model.RevenueGrowthPct >= 0;
                var revenueTargetPct = Model.RevenueTarget > 0
                    ? Math.Min(100m, Math.Round(Model.RevenueThisMonth / Model.RevenueTarget * 100, 1))
                    : 0;
            }
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <div class="card-title-group align-start mb-2">
                            <div class="card-title">
                                <h6 class="title">My Revenue <span class="badge badge-dim bg-primary ms-1">Live</span></h6>
                            </div>
                        </div>
                        <div class="nk-sale-data" style="flex:1 1 auto; width:100%;">
                            <div class="d-flex flex-column">
                                <span class="amount" id="revenueAmount">KES @Model.RevenueThisMonth.ToString("N0")</span>
                                <span class="sub-title d-block mt-1">
                                    <span id="revenueGrowth" class="change @(revenueGrowthUp ? "up text-success" : "down text-danger")">
                                        <em id="revenueGrowthIcon" class="icon ni ni-arrow-long-@(revenueGrowthUp ? "up" : "down")"></em><span id="revenueGrowthPct">@Model.RevenueGrowthPct.ToString("0.0")</span>%
                                    </span> <span id="revenuePeriodLabel">this month</span>
                                </span>
                            </div>
                        </div>
                        <div class="mt-3 d-flex flex-column" style="font-size:11px; row-gap:4px;">
                            <span class="text-soft"><span id="revenueTargetPct">@revenueTargetPct.ToString("0")</span>% of KES <span id="revenueTargetAmount">@Model.RevenueTarget.ToString("N0")</span> target</span>
                            <span class="text-soft"><span id="revenueAvgPerAccount">KES @Model.AvgPerAccount.ToString("N0")</span> avg / account</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <div class="card-title-group align-start mb-2">
                            <div class="card-title"><h6 class="title">New Accounts <span class="badge badge-dim bg-primary ms-1">Live</span></h6></div>
                        </div>
                        <div class="nk-sale-data" style="flex:1 1 auto; width:100%;">
                            <div class="d-flex flex-column">
                                <span class="amount" id="totalAccountsAmount">@Model.NewThisMonth.ToString("N0")</span>
                                <span class="sub-title d-block mt-1">
                                    <span id="totalAccountsChange" class="change text-soft">
                                        <em id="totalAccountsChangeIcon" class="icon ni ni-minus"></em><span id="totalAccountsChangePct">&mdash;</span>
                                    </span> new <span id="totalAccountsPeriodLabel">this month</span>
                                </span>
                            </div>
                        </div>
                        <div class="mt-3 d-flex flex-column" style="font-size:11px; row-gap:4px;">
                            <span class="text-soft"><span id="totalAccountsTotal">@Model.TotalAccounts.ToString("N0")</span> total accounts &middot; @lockActivePct.ToString("0")% active</span>
                            <span class="text-danger">@Model.LockNonPayingCount in default &middot; @Model.PortfolioArrearsPct.ToString("0.0")% default rate</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <div class="card-title-group align-start mb-2">
                            <div class="card-title"><h6 class="title">Paying vs Non-Paying <span class="badge badge-dim bg-primary ms-1">Live</span></h6></div>
                        </div>
                        <div class="nk-sale-data" style="flex:1 1 auto; width:100%;">
                            <div class="d-flex flex-column">
                                <span class="amount">@Model.LockGoodCount.ToString("N0")</span>
                                <span class="sub-title d-block mt-1">of @lockTotal.ToString("N0") accounts paying</span>
                            </div>
                        </div>
                        <div class="mt-3 d-flex flex-column" style="font-size:11px; row-gap:4px;">
                            <span class="text-soft">@lockGoodPct.ToString("0")% of accounts paying</span>
                            <span class="text-danger">@Model.LockNonPayingCount.ToString("N0") not paying &middot; locked 7+ days past due</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <div class="card-title-group align-start mb-2">
                            <div class="card-title"><h6 class="title">Total Arrears <span class="badge badge-dim bg-primary ms-1">Live</span></h6></div>
                        </div>
                        <div class="nk-sale-data" style="flex:1 1 auto; width:100%;">
                            <div class="d-flex flex-column">
                                <span class="amount text-danger">KES @Model.ArrearsTotal.ToString("N0")</span>
                                <span class="sub-title d-block mt-1">@Model.ArrearsTrueCount.ToString("N0") accounts locked past due</span>
                            </div>
                        </div>
                        <div class="mt-3 d-flex flex-column" style="font-size:11px; row-gap:4px;">
                            <span class="text-warning">KES @Model.RestructuredArrearsTotal.ToString("N0") restructured &middot; being managed</span>
                            <span class="text-soft">KES @arrearsAvgPerAccount.ToString("N0") avg / &middot; @Model.ArrearsAvgDaysLocked.ToString("0") days</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <div class="card-title-group align-start mb-2">
                            <div class="card-title"><h6 class="title">Bad Debt <span class="badge badge-dim bg-primary ms-1">Live</span></h6></div>
                        </div>
                        <div class="nk-sale-data" style="flex:1 1 auto; width:100%;">
                            <div class="d-flex flex-column">
                                <span class="amount text-danger">KES @Model.BadDebtThisMonth.ToString("N0")</span>
                                <span class="sub-title d-block mt-1">@Model.BadDebtCount.ToString("N0") accounts &middot; 90+ days locked</span>
                            </div>
                        </div>
                        <div class="mt-3 d-flex flex-column" style="font-size:11px; row-gap:4px;">
                            <span class="text-soft">KES @badDebtAvgPerAccount.ToString("N0") avg / account</span>
                            <span class="text-soft">@Model.BadDebtAvgDaysLocked.ToString("0") days locked avg</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <div class="card-title-group align-start mb-2">
                            <div class="card-title"><h6 class="title">Write-offs &amp; Collections <span class="badge badge-dim bg-primary ms-1">Live</span></h6></div>
                        </div>
                        <div class="nk-sale-data" style="flex:1 1 auto; width:100%;">
                            <div class="d-flex flex-column">
                                <span class="amount text-danger">KES @Model.WriteOffTotal.ToString("N0")</span>
                                <span class="sub-title d-block mt-1">@Model.WriteOffCount.ToString("N0") accounts &middot; term ended</span>
                            </div>
                        </div>
                        <div class="mt-3 d-flex flex-column" style="font-size:11px; row-gap:4px;">
                            <span class="text-soft">KES @Model.WriteOffRecoveredThisMonth.ToString("N0") recovered this month</span>
                            <span class="text-success">@Model.WriteOffRecoveryRatePct.ToString("0.0")% recovery rate</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <div class="card-title-group align-start mb-2">
                            <div class="card-title">
                                <h6 class="title">Agent Commissions</h6>
                            </div>
                        </div>
                        <div class="nk-sale-data" style="flex:1 1 auto; width:100%;">
                            <div class="d-flex flex-column">
                                <span class="amount">KES @Model.CommissionOutstanding.ToString("N0")</span>
                                <span class="sub-title d-block mt-1">still owed to your agents, in total</span>
                            </div>
                        </div>
                        <div class="mt-3 d-flex flex-column" style="font-size:11px; row-gap:4px;">
                            <span class="text-soft">KES <span id="commissionPaidThisPeriod">@Model.CommissionPaidThisPeriod.ToString("N0")</span> paid <span id="commissionPaidPeriodLabel">this month</span></span>
                            <span class="text-soft">@Model.CommissionAccountCount.ToString("N0") accounts &middot; KES @Model.CommissionWithheldForArrears.ToString("N0") withheld (arrears)</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <div class="card-title-group align-start mb-2">
                            <div class="card-title">
                                <h6 class="title">Dealer Commissions</h6>
                            </div>
                        </div>
                        <div class="nk-sale-data" style="flex:1 1 auto; width:100%;">
                            <div class="d-flex flex-column">
                                <span class="amount">KES @Model.DealerCommissionOutstanding.ToString("N0")</span>
                                <span class="sub-title d-block mt-1">still owed to you by Ranalo, in total</span>
                            </div>
                        </div>
                        <div class="mt-3 d-flex flex-column" style="font-size:11px; row-gap:4px;">
                            <span class="text-soft">KES @Model.CommissionReceived.ToString("N0") earned to date</span>
                            <span class="text-soft">@Model.DealerCommissionAccountCount.ToString("N0") accounts &middot; KES <span id="dealerCommissionPaidThisPeriod">@Model.DealerCommissionPaidThisPeriod.ToString("N0")</span> paid <span id="dealerCommissionPaidPeriodLabel">this month</span></span>
                            <span class="@(Model.DealerCommissionMissingCostCount > 0 ? "text-warning" : "text-soft")">@Model.DealerCommissionMissingCostCount.ToString("N0") accounts missing cost data</span>
                            <span class="text-soft">KES @Model.DealerCommissionWithheldForArrears.ToString("N0") potential if arrears collected</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div><!-- .nk-block -->

    <div class="nk-block">
        <div class="row g-gs">
            <div class="col-12 col-lg-8">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <div class="card-title-group mb-3">
                            <div class="card-title">
                                <h6 class="title">My Revenue &amp; Accounts Growth</h6>
                                <p class="text-soft">Last 8 months</p>
                            </div>
                        </div>
                        <div style="height:260px;">
                            <canvas id="dealerRevenueGrowthChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="card card-bordered">
                    <div class="card-inner">
                        <div class="card-title-group mb-3">
                            <div class="card-title">
                                <h6 class="title">My Portfolio</h6>
                                <p class="text-soft">Risk mix &amp; collections health</p>
                            </div>
                        </div>
                        @{
                            // goodCount already computed above for the Paying
                            // vs Non-Paying card -- reused here so both cards
                            // always agree.
                            var slowCount = Math.Round(Model.TotalAccounts * Model.PortfolioSlowPct / 100);
                            var arrearsCount = Math.Round(Model.TotalAccounts * Model.PortfolioArrearsPct / 100);
                            var nonPayCount = Math.Round(Model.TotalAccounts * Model.PortfolioNonPayingPct / 100);
                            var goodTrendUp = Model.PortfolioGoodPctChange >= 0;
                            var collectionTrendUp = Model.CollectionRateChangePct >= 0;
                            var parImproved = Model.PortfolioAtRiskChangePct <= 0;
                        }
                        <div class="row g-3 align-items-start gx-3">
                            <div class="col-12 col-sm-5">
                                <div style="position:relative; width:130px; max-width:100%; aspect-ratio:1/1; margin:0 auto;">
                                    <canvas id="dealerPortfolioCompositionChart" width="130" height="130" style="width:100%; height:100%;"></canvas>
                                    <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); text-align:center; pointer-events:none;">
                                        <div style="font-weight:800; font-size:20px; color:#364a63; line-height:1.1;">@Model.PortfolioGoodPct.ToString("0")%</div>
                                        <div style="font-size:10px; color:#8091a7;">good</div>
                                        <div style="font-size:10px;" class="@(goodTrendUp ? "text-success" : "text-danger")">
                                            <em class="icon ni ni-arrow-long-@(goodTrendUp ? "up" : "down")"></em>@Math.Abs(Model.PortfolioGoodPctChange).ToString("0.0")pp
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="d-flex align-items-center text-truncate" style="font-size:11px; min-width:0;"><span class="dot flex-shrink-0 me-1" style="background-color:#1ee0ac;"></span>Good</span>
                                        <span class="fw-bold flex-shrink-0" style="font-size:11px;">@goodCount.ToString("N0") &middot; @Model.PortfolioGoodPct.ToString("0")%</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="d-flex align-items-center text-truncate" style="font-size:11px; min-width:0;"><span class="dot flex-shrink-0 me-1" style="background-color:#f4bd0e;"></span>Slow</span>
                                        <span class="fw-bold flex-shrink-0" style="font-size:11px;">@slowCount.ToString("N0") &middot; @Model.PortfolioSlowPct.ToString("0")%</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="d-flex align-items-center text-truncate" style="font-size:11px; min-width:0;"><span class="dot flex-shrink-0 me-1" style="background-color:#e85347;"></span>Arrears</span>
                                        <span class="fw-bold flex-shrink-0" style="font-size:11px;">@arrearsCount.ToString("N0") &middot; @Model.PortfolioArrearsPct.ToString("0")%</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="d-flex align-items-center text-truncate" style="font-size:11px; min-width:0;"><span class="dot flex-shrink-0 me-1" style="background-color:#364a63;"></span>Non-Pay</span>
                                        <span class="fw-bold flex-shrink-0" style="font-size:11px;">@nonPayCount.ToString("N0") &middot; @Model.PortfolioNonPayingPct.ToString("0")%</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-7" style="min-width:0;">
                                <div class="mb-4">
                                    <div class="d-flex justify-content-between align-items-baseline flex-wrap mb-1">
                                        <span class="text-soft" style="font-size:12px;">Collection Rate</span>
                                        <span class="fw-bold text-success" style="font-size:12px;">@Model.CollectionRatePct.ToString("0.0")%</span>
                                    </div>
                                    <div class="progress progress-md progress-alt">
                                        <div class="progress-bar bg-success" data-progress="@Model.CollectionRatePct.ToString("0.0")"></div>
                                    </div>
                                    <div class="mt-1">
                                        <div class="text-soft" style="font-size:11px;">of amount due this month, collected</div>
                                        <div class="@(collectionTrendUp ? "text-success" : "text-danger")" style="font-size:11px;">
                                            <em class="icon ni ni-arrow-long-@(collectionTrendUp ? "up" : "down")"></em>@Math.Abs(Model.CollectionRateChangePct).ToString("0.0")pp <span class="text-soft">vs last month</span>
                                        </div>
                                    </div>
                                </div>
                                <div>
                                    <div class="d-flex justify-content-between align-items-baseline flex-wrap mb-1">
                                        <span class="text-soft" style="font-size:12px;">Portfolio at Risk (PAR30)</span>
                                        <span class="fw-bold text-danger" style="font-size:12px;">@Model.PortfolioAtRiskPct.ToString("0.0")%</span>
                                    </div>
                                    <div class="progress progress-md progress-alt">
                                        <div class="progress-bar bg-danger" data-progress="@Model.PortfolioAtRiskPct.ToString("0.0")"></div>
                                    </div>
                                    <div class="mt-1">
                                        <div class="text-soft" style="font-size:11px;">outstanding balance 30+ days overdue</div>
                                        <div class="@(parImproved ? "text-success" : "text-danger")" style="font-size:11px;">
                                            <em class="icon ni ni-arrow-long-@(parImproved ? "down" : "up")"></em>@Math.Abs(Model.PortfolioAtRiskChangePct).ToString("0.0")pp <span class="text-soft">vs last month</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div><!-- .nk-block -->

    @{
        const int tablePageSize = 5;

        int NonPayersMoreCount = Math.Max(0, Model.NonPayers.Count - tablePageSize);
        int SlowPayersMoreCount = Math.Max(0, Model.SlowPayers.Count - tablePageSize);
        int GoodPayersMoreCount = Math.Max(0, Model.GoodPayers.Count - tablePageSize);
        int AgentMoreCount = Math.Max(0, Model.AgentPerformance.Count - tablePageSize);
        int ContractsMoreCount = Math.Max(0, Model.Contracts.Count - tablePageSize);
        int EndingSoonMoreCount = Math.Max(0, Model.ContractsEndingSoon.Count - tablePageSize);
        int DeviceMoreCount = Math.Max(0, Model.DeviceStock.Count - tablePageSize);
        int CompletedMoreCount = Math.Max(0, Model.CompletedContracts.Count - tablePageSize);
    }

    <div class="nk-block">
        <div class="card card-bordered card-stretch">
            <div class="card-inner-group">
                <div class="card-inner">
                    <div class="card-title-group">
                        <div class="card-title">
                            <h6 class="title"><span class="dot dot-lg bg-dark me-1"></span>Non-Payers</h6>
                            <p class="text-soft">No payment in 30+ days</p>
                        </div>
                    </div>
                </div>
                <div class="card-inner p-0">
                    <div class="table-responsive">
                    <table class="table mb-0" style="white-space:nowrap;" data-key="dealer-nonpayers" data-page-size="@tablePageSize">
                        <thead>
                            <tr>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Customer</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Agent</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Days Overdue</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.NonPayers.Count; i++)
                            {
                                var e = Model.NonPayers[i];
                                <tr class="@(i >= tablePageSize ? "d-none" : "")" data-watchlist-row="dealer-nonpayers">
                                    <td><span class="fw-medium">@e.CustomerName</span></td>
                                    <td>@e.AgentName</td>
