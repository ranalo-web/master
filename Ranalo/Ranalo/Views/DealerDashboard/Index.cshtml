@section Scripts {
    <script src="~/js/watchlist-table.js"></script>
    <script>
        (function () {
            var portfolio = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new[] {
                Model.PortfolioGoodPct, Model.PortfolioSlowPct, Model.PortfolioArrearsPct, Model.PortfolioNonPayingPct
            }));
            var portfolioCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new[] {
                Math.Round(Model.TotalAccounts * Model.PortfolioGoodPct / 100),
                Math.Round(Model.TotalAccounts * Model.PortfolioSlowPct / 100),
                Math.Round(Model.TotalAccounts * Model.PortfolioArrearsPct / 100),
                Math.Round(Model.TotalAccounts * Model.PortfolioNonPayingPct / 100)
            }));

            var portfolioCanvas = document.getElementById('dealerPortfolioCompositionChart');
            if (portfolioCanvas && window.Chart) {
                new Chart(portfolioCanvas.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: ['Good Customers', 'Slow Payers', 'In Arrears', 'Non-Payers'],
                        datasets: [{
                            data: portfolio,
                            backgroundColor: ['#1ee0ac', '#f4bd0e', '#e85347', '#364a63'],
                            borderColor: '#fff',
                            borderWidth: 2,
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        maintainAspectRatio: false,
                        cutout: '72%',
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: '#fff',
                                borderColor: '#eff6ff',
                                borderWidth: 1,
                                titleColor: '#6783b8',
                                bodyColor: '#364a63',
                                padding: 10,
                                callbacks: {
                                    label: function (context) {
                                        var count = portfolioCounts[context.dataIndex];
                                        return context.label + ': ' + count.toLocaleString() + ' (' + context.parsed + '%)';
                                    }
                                }
                            }
                        }
                    }
                });
            }
        })();
    </script>
    <script>
        (function () {
            var toggle = document.getElementById('revenuePeriodToggle');
            var opts = document.querySelectorAll('.revenue-period-opt');
            if (!toggle || opts.length === 0) return;

            var amountEl = document.getElementById('revenueAmount');
            var growthEl = document.getElementById('revenueGrowth');
            var growthIconEl = document.getElementById('revenueGrowthIcon');
            var growthPctEl = document.getElementById('revenueGrowthPct');
            var periodLabelEl = document.getElementById('revenuePeriodLabel');
            var avgPerAccountEl = document.getElementById('revenueAvgPerAccount');
            var targetPctEl = document.getElementById('revenueTargetPct');
            var targetAmountEl = document.getElementById('revenueTargetAmount');
            var toggleLabel = toggle.querySelector('span');

            var totalAccountsAmountEl = document.getElementById('totalAccountsAmount');
            var totalAccountsChangeEl = document.getElementById('totalAccountsChange');
            var totalAccountsChangeIconEl = document.getElementById('totalAccountsChangeIcon');
            var totalAccountsChangePctEl = document.getElementById('totalAccountsChangePct');
            var totalAccountsPeriodLabelEl = document.getElementById('totalAccountsPeriodLabel');
            var totalAccountsTotalEl = document.getElementById('totalAccountsTotal');

            var commissionPaidThisPeriodEl = document.getElementById('commissionPaidThisPeriod');
            var commissionPaidPeriodLabelEl = document.getElementById('commissionPaidPeriodLabel');
            var dealerCommissionPaidThisPeriodEl = document.getElementById('dealerCommissionPaidThisPeriod');
            var dealerCommissionPaidPeriodLabelEl = document.getElementById('dealerCommissionPaidPeriodLabel');
            var completedContractsPeriodCountEl = document.getElementById('completedContractsPeriodCount');
            var completedContractsPeriodLabelEl = document.getElementById('completedContractsPeriodLabel');
            var collectionRatePctTextEl = document.getElementById('collectionRatePctText');
            var collectionRateProgressBarEl = document.getElementById('collectionRateProgressBar');
            var collectionRatePeriodLabelEl = document.getElementById('collectionRatePeriodLabel');
            var portfolioAtRiskPctTextEl = document.getElementById('portfolioAtRiskPctText');
            var portfolioAtRiskProgressBarEl = document.getElementById('portfolioAtRiskProgressBar');
            var portfolioAtRiskPeriodLabelEl = document.getElementById('portfolioAtRiskPeriodLabel');

            var periodNames = { week: 'Week', month: 'Month', ytd: 'Year to Date', year: 'Last 12 Months' };

            opts.forEach(function (opt) {
                opt.addEventListener('click', function (e) {
                    e.preventDefault();
                    var period = opt.getAttribute('data-period');
                    loadRevenueForPeriod(period);
                });
            });

            function loadRevenueForPeriod(period) {
                toggle.disabled = true;
                fetch('/dealer-dashboard/revenue?period=' + encodeURIComponent(period), {
                    headers: { 'Accept': 'application/json' }
                })
                    .then(function (res) {
                        if (!res.ok) throw new Error('Request failed: ' + res.status);
                        return res.json();
                    })
                    .then(function (data) {
                        amountEl.textContent = 'KES ' + Math.round(data.revenue).toLocaleString();
                        avgPerAccountEl.textContent = 'KES ' + Math.round(data.avgPerAccount).toLocaleString();
                        periodLabelEl.textContent = data.label;

                        targetAmountEl.textContent = Math.round(data.targetRevenue).toLocaleString();
                        var targetPct = data.targetRevenue > 0 ? Math.min(100, Math.round(data.revenue / data.targetRevenue * 100)) : 0;
                        targetPctEl.textContent = targetPct;

                        if (data.growthPct === null || data.growthPct === undefined) {
                            growthEl.classList.remove('up', 'text-success', 'down', 'text-danger');
                            growthEl.classList.add('text-soft');
                            growthIconEl.className = 'icon ni ni-minus';
                            growthPctEl.textContent = '—';
                        } else {
                            var up = data.growthPct >= 0;
                            growthEl.classList.remove('text-soft');
                            growthEl.classList.toggle('up', up);
                            growthEl.classList.toggle('text-success', up);
                            growthEl.classList.toggle('down', !up);
                            growthEl.classList.toggle('text-danger', !up);
                            growthIconEl.className = 'icon ni ni-arrow-long-' + (up ? 'up' : 'down');
                            growthPctEl.textContent = Math.abs(data.growthPct).toFixed(1);
                        }

                        toggleLabel.textContent = periodNames[period] || periodNames.month;

                        totalAccountsAmountEl.textContent = Math.round(data.newInPeriod).toLocaleString();
                        totalAccountsTotalEl.textContent = Math.round(data.totalAccounts).toLocaleString();
                        totalAccountsPeriodLabelEl.textContent = data.label;

                        if (data.newInPeriodChangePct === null || data.newInPeriodChangePct === undefined) {
                            totalAccountsChangeEl.classList.remove('up', 'text-success', 'down', 'text-danger');
                            totalAccountsChangeEl.classList.add('text-soft');
                            totalAccountsChangeIconEl.className = 'icon ni ni-minus';
                            totalAccountsChangePctEl.textContent = '—';
                        } else {
                            var accountsUp = data.newInPeriodChangePct >= 0;
                            totalAccountsChangeEl.classList.remove('text-soft');
                            totalAccountsChangeEl.classList.toggle('up', accountsUp);
                            totalAccountsChangeEl.classList.toggle('text-success', accountsUp);
                            totalAccountsChangeEl.classList.toggle('down', !accountsUp);
                            totalAccountsChangeEl.classList.toggle('text-danger', !accountsUp);
                            totalAccountsChangeIconEl.className = 'icon ni ni-arrow-long-' + (accountsUp ? 'up' : 'down');
                            totalAccountsChangePctEl.textContent = Math.abs(data.newInPeriodChangePct).toFixed(1) + '%';
                        }

                        // Agent/Dealer Commissions cards are hidden on the
                        // Approver Dashboard (see the @@if (ViewBag.IsApprover...)
                        // wrappers above) -- these elements won't exist there.
                        if (commissionPaidThisPeriodEl) {
                            commissionPaidThisPeriodEl.textContent = Math.round(data.commissionPaidThisPeriod).toLocaleString();
                        }
                        if (commissionPaidPeriodLabelEl) {
                            commissionPaidPeriodLabelEl.textContent = data.label;
                        }

                        if (dealerCommissionPaidThisPeriodEl) {
                            dealerCommissionPaidThisPeriodEl.textContent = Math.round(data.dealerCommissionPaidThisPeriod).toLocaleString();
                        }
                        if (dealerCommissionPaidPeriodLabelEl) {
                            dealerCommissionPaidPeriodLabelEl.textContent = data.label;
                        }

                        // Count-based, not value-based -- how many contracts
                        // were completed within the selected period.
                        completedContractsPeriodCountEl.textContent = Math.round(data.completedContractsInPeriod).toLocaleString();
                        completedContractsPeriodLabelEl.textContent = data.label;

                        // Collection Rate / PAR30: of accounts enrolled within
                        // the selected period, count-based, not value-based.
                        collectionRatePctTextEl.textContent = data.collectionRatePct.toFixed(1) + '%';
                        collectionRateProgressBarEl.style.width = data.collectionRatePct + '%';
                        collectionRateProgressBarEl.setAttribute('data-progress', data.collectionRatePct);
                        collectionRatePeriodLabelEl.textContent = data.label;

                        portfolioAtRiskPctTextEl.textContent = data.portfolioAtRiskPct.toFixed(1) + '%';
                        portfolioAtRiskProgressBarEl.style.width = data.portfolioAtRiskPct + '%';
                        portfolioAtRiskProgressBarEl.setAttribute('data-progress', data.portfolioAtRiskPct);
                        portfolioAtRiskPeriodLabelEl.textContent = data.label;
                    })
                    .catch(function (err) {
                        console.error('Failed to load revenue for period ' + period, err);
                    })
                    .finally(function () {
                        toggle.disabled = false;
                    });
            }
        })();
    </script>
}
