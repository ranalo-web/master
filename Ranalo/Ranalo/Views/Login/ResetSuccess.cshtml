@{
    Layout = "_LoginLayout";
}


<div class="nk-block nk-block-middle nk-auth-body">
    <div class="brand-logo pb-5">
        <a href="/index" class="logo-link">
            <img class="logo-light logo-img logo-img-lg" src="./images/Ranalo_Credit_Logo.png" srcset="./images/lRanalo_Credit_Logo.png 2x" alt="logo">
            <img class="logo-dark logo-img logo-img-lg" src="./images/Ranalo_Credit_Logo.png" srcset="./images/Ranalo_Credit_Logo.png 2x" alt="logo-dark">
        </a>
    </div>
    <div class="nk-block-head">
        <div class="nk-block-head-content">
            <h5 class="nk-block-title">Thank you for submitting form</h5>
            <div class="nk-block-des">
                <p class="text-success">You can now sign in with your new password</p>

                <p>Continue to the application. <a href="/reset-success">Continue</a></p>
            </div>
        </div>
    </div>
</div><!-- .nk-block -->