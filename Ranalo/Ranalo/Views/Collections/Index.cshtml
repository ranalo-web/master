@using Ranalo.Models
@using Ranalo.Services
@model CollectorDashboardViewModel
@{
    // Collector logins get the collections layout; a dealer or agent who
    // also collects keeps their own menus.
    Layout = ViewBag.CollectorOnly is true ? "~/Pages/Shared/_LayoutCollections.cshtml" : "~/Pages/Shared/_Layout.cshtml";
    var s = Model.Summary;
    var share = (CollectionsRules.CollectorShareRate * 100).ToString("0");
}

<style>
    @@media (max-width: 767.98px) {
        .cd-md { display: none !important; }
        .cd-table td, .cd-table th { padding-left: .5rem; padding-right: .5rem; }
    }
</style>

<div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">My Collections</h3>
            <div class="nk-block-des text-soft">
                <p>The accounts you hold. You earn @share% of every payment on an account while it is with you. Accounts with no payment for @CollectionsRules.ReassignAfterDaysWithoutPayment days may be reassigned. Can't reach a customer? Flag it with a note.</p>
            </div>
        </div>
    </div>

    @if (TempData["CollectionsSuccess"] is string success)
    {
        <div class="alert alert-success alert-icon alert-dismissible">
            <em class="icon ni ni-check-circle"></em> @success
            <button class="close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["CollectionsError"] is string error)
    {
        <div class="alert alert-danger alert-icon alert-dismissible">
            <em class="icon ni ni-cross-circle"></em> @error
            <button class="close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (Model.SetupMissing)
    {
        <div class="alert alert-warning alert-icon"><em class="icon ni ni-alert-circle"></em> Collections isn't switched on yet.</div>
    }

    <div class="nk-block">
        <div class="row g-gs">
            <div class="col-6 col-lg-3">
                <div class="card card-bordered h-100"><div class="card-inner">
                    <span class="sub-text">Accounts I hold</span>
                    <span class="d-block fs-5 fw-bold">@s.CasesHeld</span>
                    <span class="d-block text-soft small">KES @s.ShortfallAtHandover.ToString("N0") owed at handover</span>
                </div></div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card card-bordered h-100"><div class="card-inner">
                    <span class="sub-text">Recovered</span>
                    <span class="d-block fs-5 fw-bold">KES @s.Recovered.ToString("N0")</span>
                    <span class="d-block text-soft small">KES @s.RecoveredThisMonth.ToString("N0") this month · @s.RecoveryRatePct.ToString("0.#")% of what's owed</span>
                </div></div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card card-bordered h-100"><div class="card-inner">
                    <span class="sub-text">Earned (@share%)</span>
                    <span class="d-block fs-5 fw-bold">KES @s.Earned.ToString("N0")</span>
                    <span class="d-block text-soft small">KES @s.Paid.ToString("N0") paid to you</span>
                </div></div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card card-bordered h-100"><div class="card-inner">
                    <span class="sub-text">Due to you</span>
                    <span class="d-block fs-5 fw-bold text-success">KES @s.Due.ToString("N0")</span>
                    <span class="d-block text-soft small">@(s.DueForReassignment > 0 ? $"{s.DueForReassignment} account(s) at risk of reassignment" : "Paid by admin")</span>
                </div></div>
            </div>
        </div>
    </div>

    <div class="nk-block">
        <div class="card card-bordered">
            <div class="card-inner border-bottom py-2"><h6 class="title mb-0">My accounts</h6></div>
            @if (Model.Cases.Count == 0)
            {
                <div class="card-inner text-soft">No accounts are assigned to you right now.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0 cd-table" style="font-size:13px;">
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th class="cd-md" title="Shortfall when the account went to collections">Owed at handover</th>
                                <th>Recovered by me</th>
                                <th>Last payment</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Cases)
                            {
                                <tr class="@(c.DueForReassignment ? "table-danger" : "")">
                                    <td>
                                        <a href="/customer-details/@c.AccountNo" class="fw-medium">@(string.IsNullOrWhiteSpace(c.CustomerName) ? "(no name)" : c.CustomerName)</a>
                                        <span class="d-block sub-text">AC @c.AccountNo · @(c.ProductName ?? "Unknown device") · yours since @c.HeldSince?.ToString("dd MMM yyyy")</span>
                                        @if (c.ContractEnded) { <span class="badge badge-dim bg-info">Resold -- you earn on the new customer's payments</span> }
                                        @if (c.OpenFlagCount > 0) { <span class="d-block small text-warning"><em class="icon ni ni-flag"></em> Flagged: @c.LatestFlagNote</span> }
                                    </td>
                                    <td class="cd-md">KES @c.ShortfallAtHandover.ToString("N0")</td>
                                    <td>KES @c.RecoveredByHolder.ToString("N0")<span class="d-block sub-text">earns KES @CollectionsRules.CollectorShare(c.RecoveredByHolder).ToString("N0")</span></td>
                                    <td>
                                        @(c.LastPaymentAt.HasValue && c.LastPaymentAt >= c.HeldSince ? c.LastPaymentAt.Value.ToString("dd MMM yyyy") : "None yet")
                                        <span class="d-block sub-text @(c.DueForReassignment ? "text-danger fw-bold" : "")">@c.DaysWithoutPaymentWhileHeld days without payment</span>
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#flag-modal"
                                                data-case="@c.CaseId" data-name="@c.CustomerName">Can't reach</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (Model.Earnings.Any(e => !e.HeldNow))
    {
        <div class="nk-block">
            <div class="card card-bordered">
                <div class="card-inner border-bottom py-2"><h6 class="title mb-0">Accounts you no longer hold</h6><span class="sub-text">You keep what you earned while you held them</span></div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0 cd-table" style="font-size:13px;">
                        <thead><tr><th>Customer</th><th>Recovered by you</th><th>Earned</th><th>Due</th></tr></thead>
                        <tbody>
                            @foreach (var e in Model.Earnings.Where(e => !e.HeldNow))
                            {
                                <tr>
                                    <td>@e.CustomerName<span class="d-block sub-text">AC @e.AccountNo</span></td>
                                    <td>KES @e.Recovered.ToString("N0")</td>
                                    <td>KES @e.Earned.ToString("N0")</td>
                                    <td>KES @e.Due.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="nk-block">
        <div class="card card-bordered">
            <div class="card-inner border-bottom py-2 d-flex justify-content-between">
                <h6 class="title mb-0">Payments to me</h6>
                <a href="/commission-payouts/history" class="link link-primary small">All payments</a>
            </div>
            @if (Model.Payouts.Count == 0)
            {
                <div class="card-inner text-soft">No payments yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0" style="font-size:13px;">
                        <tbody>
                            @foreach (var p in Model.Payouts)
                            {
                                <tr><td>@p.PaidDate.ToString("dd MMM yyyy")</td><td>@p.Method @p.Reference</td><td class="text-end fw-medium">KES @p.Amount.ToString("N0")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" id="flag-modal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form method="post" action="/collections/flag">
                <div class="modal-header">
                    <h5 class="modal-title">Can't reach <span id="flag-name"></span></h5>
                    <a href="#" class="close" data-bs-dismiss="modal" aria-label="Close"><em class="icon ni ni-cross"></em></a>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="caseId" id="flag-case" />
                    <label class="form-label" for="flag-note">What have you tried?</label>
                    <textarea class="form-control" name="note" id="flag-note" rows="3" maxlength="500" required
                              placeholder="e.g. Phone off for 2 weeks, not at the address on file"></textarea>
                    <p class="text-soft small mt-2 mb-0">The admin team will see this and may reassign the account.</p>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-warning">Flag for admin</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('flag-modal').addEventListener('show.bs.modal', function (e) {
            var b = e.relatedTarget;
            document.getElementById('flag-case').value = b.dataset.case;
            document.getElementById('flag-name').textContent = b.dataset.name || 'customer';
        });
    </script>
}
