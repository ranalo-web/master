@using Ranalo.Models
@using Ranalo.Services
@model CollectorDashboardViewModel
@{
    // Same layout and menu for every role (collectors included).
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var s = Model.Summary;
    var share = (CollectionsRules.CollectorShareRate * 100).ToString("0");
}

<style>
    @@media (max-width: 767.98px) {
        .cd-md { display: none !important; }
        .cd-table td, .cd-table th { padding-left: .5rem; padding-right: .5rem; }
    }
</style>

<div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">My Collections</h3>
            <div class="nk-block-des text-soft">
                <p>The accounts you hold. You earn @share% of every payment on an account while it is with you. Accounts with no payment for @CollectionsRules.ReassignAfterDaysWithoutPayment days may be reassigned. Can't reach a customer? Flag it with a note.</p>
            </div>
        </div>
    </div>

    @if (TempData["CollectionsSuccess"] is string success)
    {
        <div class="alert alert-success alert-icon alert-dismissible">
            <em class="icon ni ni-check-circle"></em> @success
            <button class="close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["CollectionsError"] is string error)
    {
        <div class="alert alert-danger alert-icon alert-dismissible">
            <em class="icon ni ni-cross-circle"></em> @error
            <button class="close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (Model.SetupMissing)
    {
        <div class="alert alert-warning alert-icon"><em class="icon ni ni-alert-circle"></em> Collections isn't switched on yet.</div>
    }

    <div class="nk-block">
        <div class="row g-gs">
            <div class="col-6 col-lg-3">
                <div class="card card-bordered h-100"><div class="card-inner">
                    <span class="sub-text">Accounts I hold</span>
                    <span class="d-block fs-5 fw-bold">@s.CasesHeld</span>
                    <span class="d-block text-soft small">KES @s.ShortfallAtHandover.ToString("N0") owed at handover</span>
                </div></div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card card-bordered h-100"><div class="card-inner">
                    <span class="sub-text">Recovered</span>
                    <span class="d-block fs-5 fw-bold">KES @s.Recovered.ToString("N0")</span>
                    <span class="d-block text-soft small">KES @s.RecoveredThisMonth.ToString("N0") this month · @s.RecoveryRatePct.ToString("0.#")% of what's owed</span>
                </div></div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card card-bordered h-100"><div class="card-inner">
                    <span class="sub-text">Earned (@share%)</span>
                    <span class="d-block fs-5 fw-bold">KES @s.Earned.ToString("N0")</span>
                    <span class="d-block text-soft small">KES @s.Paid.ToString("N0") paid to you</span>
                </div></div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card card-bordered h-100"><div class="card-inner">
                    <span class="sub-text">Due to you</span>
                    <span class="d-block fs-5 fw-bold text-success">KES @s.Due.ToString("N0")</span>
                    <span class="d-block text-soft small">@(s.DueForReassignment > 0 ? $"{s.DueForReassignment} account(s) at risk of reassignment" : "Paid by admin")</span>
                </div></div>
            </div>
        </div>
    </div>

    <div class="nk-block">
        <div class="card card-bordered">
            <div class="card-inner border-bottom py-2 d-flex flex-wrap justify-content-between align-items-center" style="gap:.5rem;">
                <h6 class="title mb-0">My accounts
                    <span class="text-soft small fw-normal">@(Model.Search != null || Model.Filter != CollectionsRules.Filter.All ? $"{Model.Cases.Count} of {Model.HeldCount}" : Model.HeldCount.ToString())</span>
                </h6>
                @if (Model.HeldCount > 0)
                {
                    <form method="get" action="/collections-home" class="d-flex" style="gap:.5rem;">
                        @if (Model.Filter != CollectionsRules.Filter.All)
                        {
                            <input type="hidden" name="show" value="@Model.Filter" />
                        }
                        <input type="search" name="search" class="form-control form-control-sm" style="min-width:220px;" value="@Model.Search"
                               placeholder="Name, account no or phone" aria-label="Search my accounts" />
                        <button type="submit" class="btn btn-sm btn-primary"><em class="icon ni ni-search"></em><span>Search</span></button>
                        @if (Model.Search != null)
                        {
                            <a href="/collections-home@(Model.Filter != CollectionsRules.Filter.All ? $"?show={Model.Filter}" : "")" class="btn btn-sm btn-outline-light btn-white">Clear</a>
                        }
                    </form>
                }
            </div>
            @if (Model.HeldCount > 0)
            {
                var filters = new[]
                {
                    (Key: CollectionsRules.Filter.All, Label: "All", Count: Model.MatchedCount, Title: "Every account you hold"),
                    (Key: CollectionsRules.Filter.NotWorked, Label: "Not worked on", Count: Model.NotWorkedCount, Title: "No call logged since you got the account, and not flagged"),
                    (Key: CollectionsRules.Filter.Worked, Label: "Worked on", Count: Model.WorkedCount, Title: "You've logged a call, or flagged it can't reach"),
                    (Key: CollectionsRules.Filter.FollowUp, Label: "Follow up", Count: Model.FollowUpCount, Title: $"Promised date has passed, or {CollectionsRules.FollowUpAfterDays}+ days since your call -- check the promise was kept"),
                };
                <div class="card-inner border-bottom py-2 d-flex flex-wrap" style="gap:.5rem;">
                    @foreach (var f in filters)
                    {
                        var query = new List<string>();
                        if (f.Key != CollectionsRules.Filter.All) query.Add("show=" + f.Key);
                        if (Model.Search != null) query.Add("search=" + Uri.EscapeDataString(Model.Search));
                        var href = "/collections-home" + (query.Count > 0 ? "?" + string.Join("&", query) : "");
                        var active = Model.Filter == f.Key;
                        <a href="@href" title="@f.Title"
                           class="btn btn-sm @(active ? (f.Key == CollectionsRules.Filter.FollowUp ? "btn-warning" : "btn-primary") : "btn-outline-light btn-white")">
                            @f.Label <span class="badge @(active ? "bg-white text-dark" : "badge-dim bg-light text-dark") ms-1">@f.Count</span>
                        </a>
                    }
                </div>
            }
            @if (Model.HeldCount == 0)
            {
                <div class="card-inner text-soft">No accounts are assigned to you right now.</div>
            }
            else if (Model.Cases.Count == 0 && Model.MatchedCount == 0)
            {
                <div class="card-inner text-soft">None of your accounts match "@Model.Search". Search by customer or next-of-kin name, account number, or phone.</div>
            }
            else if (Model.Cases.Count == 0)
            {
                <div class="card-inner text-soft">
                    @(Model.Filter switch
                    {
                        CollectionsRules.Filter.NotWorked => "You've worked on every account here.",
                        CollectionsRules.Filter.Worked => "You haven't logged a call or flag on any of these yet.",
                        CollectionsRules.Filter.FollowUp => "Nothing to follow up yet.",
                        _ => "No accounts."
                    })
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0 cd-table" style="font-size:13px;">
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th class="cd-md" title="Shortfall when the account went to collections">Owed at handover</th>
                                <th>Recovered by me</th>
                                <th>Last payment</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Cases)
                            {
                                <tr class="@(c.DueForReassignment ? "table-danger" : "")">
                                    <td>
                                        <a href="/customer-details/@c.AccountNo" class="fw-medium">@(string.IsNullOrWhiteSpace(c.CustomerName) ? "(no name)" : c.CustomerName)</a>
                                        <span class="d-block sub-text">AC @c.AccountNo · @(c.ProductName ?? "Unknown device") · yours since @c.HeldSince?.ToString("dd MMM yyyy")</span>
                                        @if (c.ContractEnded) { <span class="badge badge-dim bg-info">Resold -- you earn on the new customer's payments</span> }
                                        @if (c.Contact?.CustomerPhone is { Length: > 0 } phone)
                                        {
                                            <a href="tel:@phone" class="d-block small"><em class="icon ni ni-call"></em> @phone</a>
                                        }
                                        @{ var kins = CollectionsRules.NextOfKin(c.Contact); }
                                        @if (kins.Count == 0)
                                        {
                                            <span class="d-block small text-soft">No next of kin on file</span>
                                        }
                                        @for (var i = 0; i < kins.Count; i++)
                                        {
                                            var k = kins[i];
                                            <span class="d-block small">Next of kin@(kins.Count > 1 ? $" {i + 1}" : ""): @(string.IsNullOrWhiteSpace(k.Name) ? "(no name)" : k.Name)@if (k.Phone is { Length: > 0 } kinPhone) { <text> · </text><a href="tel:@kinPhone">@kinPhone</a> }@if (k.IdNumber is { Length: > 0 } kinId) { <text> · ID @kinId</text> }</span>
                                        }
                                        @if (c.LastCall != null)
                                        {
                                            <span class="d-block small text-success"><em class="icon ni ni-chat"></em> Spoke @c.LastCall.CreatedAt.ToString("dd MMM"): @c.LastCall.Note@if (c.LastCall.PromisedDate.HasValue) { <text> · promised to pay by @c.LastCall.PromisedDate.Value.ToString("dd MMM")</text> }</span>
                                            if (CollectionsRules.IsDueForFollowUp(c, DateTime.Today))
                                            {
                                                if (CollectionsRules.PaidSinceCall(c))
                                                {
                                                    <span class="badge badge-dim bg-success">Promise kept · paid @c.LastPaymentAt!.Value.ToString("dd MMM")</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-dim bg-danger">@(c.LastCall.PromisedDate.HasValue ? "Promise not kept" : "No payment since call") · follow up</span>
                                                }
                                            }
                                        }
                                        @if (c.OpenFlagCount > 0) { <span class="d-block small text-warning"><em class="icon ni ni-flag"></em> Flagged: @c.LatestFlagNote</span> }
                                    </td>
                                    <td class="cd-md">KES @c.ShortfallAtHandover.ToString("N0")</td>
                                    <td>KES @c.RecoveredByHolder.ToString("N0")<span class="d-block sub-text">earns KES @CollectionsRules.CollectorShare(c.RecoveredByHolder).ToString("N0")</span></td>
                                    <td>
                                        @(c.LastPaymentAt.HasValue && c.LastPaymentAt >= c.HeldSince ? c.LastPaymentAt.Value.ToString("dd MMM yyyy") : "None yet")
                                        <span class="d-block sub-text @(c.DueForReassignment ? "text-danger fw-bold" : "")">@c.DaysWithoutPaymentWhileHeld days without payment</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex flex-column align-items-end" style="gap:.25rem;">
                                            <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#call-modal"
                                                    data-case="@c.CaseId" data-name="@c.CustomerName">Spoke to customer</button>
                                            <button type="button" class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#flag-modal"
                                                    data-case="@c.CaseId" data-name="@c.CustomerName">Can't reach</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#lost-modal"
                                                    data-case="@c.CaseId" data-account="@c.AccountNo" data-name="@c.CustomerName">Phone lost</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (Model.Earnings.Any(e => !e.HeldNow))
    {
        <div class="nk-block">
            <div class="card card-bordered">
                <div class="card-inner border-bottom py-2"><h6 class="title mb-0">Accounts you no longer hold</h6><span class="sub-text">You keep what you earned while you held them</span></div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0 cd-table" style="font-size:13px;">
                        <thead><tr><th>Customer</th><th>Recovered by you</th><th>Earned</th><th>Due</th></tr></thead>
                        <tbody>
                            @foreach (var e in Model.Earnings.Where(e => !e.HeldNow))
                            {
                                <tr>
                                    <td>@e.CustomerName<span class="d-block sub-text">AC @e.AccountNo</span></td>
                                    <td>KES @e.Recovered.ToString("N0")</td>
                                    <td>KES @e.Earned.ToString("N0")</td>
                                    <td>KES @e.Due.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="nk-block">
        <div class="card card-bordered">
            <div class="card-inner border-bottom py-2 d-flex justify-content-between">
                <h6 class="title mb-0">Payments to me</h6>
                <a href="/commission-payouts/history" class="link link-primary small">All payments</a>
            </div>
            @if (Model.Payouts.Count == 0)
            {
                <div class="card-inner text-soft">No payments yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0" style="font-size:13px;">
                        <tbody>
                            @foreach (var p in Model.Payouts)
                            {
                                <tr><td>@p.PaidDate.ToString("dd MMM yyyy")</td><td>@p.Method @p.Reference</td><td class="text-end fw-medium">KES @p.Amount.ToString("N0")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" id="call-modal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form method="post" action="/collections/call-note" data-saving>
                <div class="modal-header">
                    <h5 class="modal-title">Spoke to <span id="call-name"></span></h5>
                    <a href="#" class="close" data-bs-dismiss="modal" aria-label="Close"><em class="icon ni ni-cross"></em></a>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="caseId" id="call-case" />
                    <label class="form-label" for="call-note">What did you discuss?</label>
                    <textarea class="form-control" name="note" id="call-note" rows="3" maxlength="500" required
                              placeholder="e.g. Lost job, will pay 500 a week from Friday"></textarea>
                    <label class="form-label mt-3" for="call-promised">Promised to pay by (optional)</label>
                    <input type="date" class="form-control" name="promisedDate" id="call-promised" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Save call</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" id="flag-modal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form method="post" action="/collections/flag" data-saving>
                <div class="modal-header">
                    <h5 class="modal-title">Can't reach <span id="flag-name"></span></h5>
                    <a href="#" class="close" data-bs-dismiss="modal" aria-label="Close"><em class="icon ni ni-cross"></em></a>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="caseId" id="flag-case" />
                    <label class="form-label" for="flag-note">What have you tried?</label>
                    <textarea class="form-control" name="note" id="flag-note" rows="3" maxlength="500" required
                              placeholder="e.g. Phone off for 2 weeks, not at the address on file"></textarea>
                    <p class="text-soft small mt-2 mb-0">The admin team will see this and may reassign the account.</p>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-warning">Flag for admin</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" id="lost-modal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form method="post" action="/collections/lost-phone" data-saving>
                <div class="modal-header">
                    <h5 class="modal-title"><span id="lost-name"></span> lost the phone</h5>
                    <a href="#" class="close" data-bs-dismiss="modal" aria-label="Close"><em class="icon ni ni-cross"></em></a>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="caseId" id="lost-case" />
                    <input type="hidden" name="accountNo" id="lost-account" />
                    <label class="form-label" for="lost-note">What happened?</label>
                    <textarea class="form-control" name="note" id="lost-note" rows="3" maxlength="480" required
                              placeholder="e.g. Stolen on 12 Oct, reported to police, OB number 45/10/2026"></textarea>
                    <p class="text-soft small mt-2 mb-0">The admin team reviews it as a write-off. The account stays in the system and with you. If the phone turns up and the customer pays, it comes back automatically.</p>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-secondary">Report lost phone</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('lost-modal').addEventListener('show.bs.modal', function (e) {
            var b = e.relatedTarget;
            document.getElementById('lost-case').value = b.dataset.case;
            document.getElementById('lost-account').value = b.dataset.account;
            document.getElementById('lost-name').textContent = b.dataset.name || 'Customer';
        });
        document.getElementById('flag-modal').addEventListener('show.bs.modal', function (e) {
            var b = e.relatedTarget;
            document.getElementById('flag-case').value = b.dataset.case;
            document.getElementById('flag-name').textContent = b.dataset.name || 'customer';
        });
        document.getElementById('call-modal').addEventListener('show.bs.modal', function (e) {
            var b = e.relatedTarget;
            document.getElementById('call-case').value = b.dataset.case;
            document.getElementById('call-name').textContent = b.dataset.name || 'customer';
        });
        // Show the click registered (the page reload can take a moment) and
        // stop a second click saving the note twice.
        document.querySelectorAll('form[data-saving]').forEach(function (f) {
            f.addEventListener('submit', function () {
                var btn = f.querySelector('button[type=submit]');
                btn.disabled = true;
                btn.textContent = 'Saving…';
            });
        });
    </script>
}
