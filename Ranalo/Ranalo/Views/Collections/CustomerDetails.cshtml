@using Ranalo.Models
@using Ranalo.Services
@model CollectorCustomerViewModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var c = Model.Customer;
    var s = Model.Standing;
    var k = Model.Case;
    var name = $"{c.FirstName} {c.LastName}".Trim();
    if (string.IsNullOrWhiteSpace(name)) { name = s?.CustomerName ?? $"Account {Model.AccountNo}"; }
    var photo = c.IdentityImages.FirstOrDefault(x => x.Key == "photo_of_applicant")?.Url;
    var share = (CollectionsRules.CollectorShareRate * 100).ToString("0");
    var back = ViewBag.IsAdmin is true ? "/collections-admin" : "/collections-home";
}

@functions {
    // Device dates come in a few text formats; show them readably or as-is.
    private static string When(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "-";
        // "2026-05-28T01:00:00" style: swap the date/time "T" for a space
        // (but leave a trailing " UTC" alone -- ParseCustomDate strips it).
        var text = System.Text.RegularExpressions.Regex.Replace(raw, @"(\d)T(\d)", "$1 $2");
        var parsed = DateHelper.ParseCustomDate(text);
        return parsed?.ToString("dd MMM yyyy HH:mm") ?? raw;
    }

    private static string Tel(string? phone) => new string((phone ?? "").Where(ch => char.IsDigit(ch) || ch == '+').ToArray());
}

<style>
    .cu-dl { display: grid; grid-template-columns: max-content 1fr; gap: .35rem 1rem; margin: 0; }
    .cu-dl dt { font-weight: 400; color: #8094ae; }
    .cu-dl dd { margin: 0; word-break: break-word; }
    .cu-kin + .cu-kin { border-top: 1px solid #e5e9f2; margin-top: .75rem; padding-top: .75rem; }
    .cu-photos img { width: 84px; height: 84px; object-fit: cover; border-radius: 6px; border: 1px solid #e5e9f2; }
</style>

<div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between g-3">
            <div class="nk-block-head-content">
                <h3 class="nk-block-title page-title">@name</h3>
                <div class="nk-block-des text-soft">
                    <p>Account @Model.AccountNo@(s?.ProductName != null ? " · " + s.ProductName : "")@(s?.DealerName != null ? " · " + s.DealerName : "")</p>
                </div>
            </div>
            <div class="nk-block-head-content">
                <a href="@back" class="btn btn-outline-light bg-white"><em class="icon ni ni-arrow-left"></em><span class="d-none d-sm-inline">Back</span></a>
            </div>
        </div>
    </div>

    @if (TempData["CollectionsSuccess"] is string success)
    {
        <div class="alert alert-success alert-icon alert-dismissible"><em class="icon ni ni-check-circle"></em> @success<button class="close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["CollectionsError"] is string error)
    {
        <div class="alert alert-danger alert-icon alert-dismissible"><em class="icon ni ni-cross-circle"></em> @error<button class="close" data-bs-dismiss="alert"></button></div>
    }

    <div class="nk-block">
        <div class="row g-gs">
            @* 1. Customer & contact *@
            <div class="col-12 col-lg-6">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <h6 class="overline-title mb-3">Customer &amp; contact</h6>
                        @if (!Model.HasOrder)
                        {
                            <p class="text-soft small">No online order found for this account, so contact details aren't on file. They can be added on WooCommerce.</p>
                        }
                        <dl class="cu-dl">
                            <dt>Phone</dt>
                            <dd>@if (!string.IsNullOrWhiteSpace(c.Phone)) { <a href="tel:@Tel(c.Phone)" class="fw-medium"><em class="icon ni ni-call"></em> @c.Phone</a> } else { <span class="text-soft">-</span> }</dd>
                            <dt>Email</dt>
                            <dd>@(string.IsNullOrWhiteSpace(c.Email) ? "-" : c.Email)</dd>
                            <dt>Address</dt>
                            <dd>@(string.IsNullOrWhiteSpace(c.Address1) ? "-" : c.Address1)</dd>
                            <dt>National ID</dt>
                            <dd>@(string.IsNullOrWhiteSpace(c.NationalId) ? "-" : c.NationalId)</dd>
                        </dl>
                        @if (c.IdentityImages.Any())
                        {
                            <div class="cu-photos d-flex flex-wrap mt-3" style="gap:.5rem;">
                                @foreach (var img in c.IdentityImages.Where(i => !string.IsNullOrWhiteSpace(i.Url)))
                                {
                                    <a href="@img.Url" target="_blank" title="@img.Key"><img src="@img.Url" alt="@img.Key" loading="lazy" /></a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* 2. Next of kin *@
            <div class="col-12 col-lg-6">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <h6 class="overline-title mb-3">Next of kin</h6>
                        @if (c.NextOfKin == null && c.NextOfKin2 == null)
                        {
                            <p class="text-soft mb-0">No next of kin on file.</p>
                        }
                        @foreach (var (label, kin) in new[] { ("First", c.NextOfKin), ("Second", c.NextOfKin2) })
                        {
                            if (kin == null) { continue; }
                            <div class="cu-kin">
                                <span class="badge badge-dim bg-light mb-1">@label</span>
                                <dl class="cu-dl">
                                    <dt>Name</dt>
                                    <dd class="fw-medium">@kin.Name</dd>
                                    <dt>Phone</dt>
                                    <dd>@if (!string.IsNullOrWhiteSpace(kin.Phone)) { <a href="tel:@Tel(kin.Phone)"><em class="icon ni ni-call"></em> @kin.Phone</a> } else { <span>-</span> }</dd>
                                    @if (!string.IsNullOrWhiteSpace(kin.Email)) { <dt>Email</dt><dd>@kin.Email</dd> }
                                    @if (!string.IsNullOrWhiteSpace(kin.Address)) { <dt>Address</dt><dd>@kin.Address</dd> }
                                </dl>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* 5. This collection *@
            @if (k != null)
            {
                <div class="col-12">
                    <div class="card card-bordered @(k.DueForReassignment ? "border-danger" : "")">
                        <div class="card-inner">
                            <h6 class="overline-title mb-3">This collection</h6>
                            <div class="row g-3">
                                <div class="col-6 col-md-3"><span class="sub-text">Collector</span><span class="d-block fw-medium">@(k.CollectorName ?? "-")</span><span class="d-block small text-soft">since @k.HeldSince?.ToString("dd MMM yyyy")</span></div>
                                <div class="col-6 col-md-3"><span class="sub-text">Owed at handover</span><span class="d-block fw-medium">KES @k.ShortfallAtHandover.ToString("N0")</span><span class="d-block small text-soft">@k.HandoverAt.ToString("dd MMM yyyy")</span></div>
                                <div class="col-6 col-md-3"><span class="sub-text">Recovered by @(Model.ViewerHoldsCase ? "you" : "current collector")</span><span class="d-block fw-medium">KES @k.RecoveredByHolder.ToString("N0")</span><span class="d-block small text-soft">@share% = KES @CollectionsRules.CollectorShare(k.RecoveredByHolder).ToString("N0")</span></div>
                                <div class="col-6 col-md-3"><span class="sub-text">Days without payment</span><span class="d-block fw-medium @(k.DueForReassignment ? "text-danger" : "")">@k.DaysWithoutPaymentWhileHeld</span><span class="d-block small text-soft">@(k.DueForReassignment ? "May be reassigned" : $"Reassignment at {CollectionsRules.ReassignAfterDaysWithoutPayment}")</span></div>
                            </div>
                            @if (k.ContractEnded)
                            {
                                <p class="small text-info mt-2 mb-0">The device was repossessed and resold: payments from the new customer count toward this collection.</p>
                            }
                            @if (k.OpenFlagCount > 0)
                            {
                                <p class="small text-warning mt-2 mb-0"><em class="icon ni ni-flag"></em> Flagged: @k.LatestFlagNote</p>
                            }
                            @if (Model.ViewerHoldsCase)
                            {
                                <form method="post" action="/collections/flag" class="mt-3">
                                    <input type="hidden" name="caseId" value="@k.CaseId" />
                                    <input type="hidden" name="accountNo" value="@Model.AccountNo" />
                                    <label class="form-label" for="flag-note">Can't reach this customer?</label>
                                    <div class="d-flex flex-wrap" style="gap:.5rem;">
                                        <input type="text" name="note" id="flag-note" maxlength="500" required class="form-control flex-grow-1" style="min-width:200px;"
                                               placeholder="What have you tried? e.g. phone off for 2 weeks" />
                                        <button type="submit" class="btn btn-outline-warning">Flag for admin</button>
                                    </div>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }

            @* 4. Loan & payments *@
            <div class="col-12 col-lg-6">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <h6 class="overline-title mb-3">Loan &amp; payments</h6>
                        @if (s == null)
                        {
                            <p class="text-soft">No open contract on this account.</p>
                        }
                        else
                        {
                            <div class="row g-3 mb-3">
                                <div class="col-6"><span class="sub-text">Contract total</span><span class="d-block fw-medium">KES @s.ContractValue.ToString("N0")</span></div>
                                <div class="col-6"><span class="sub-text">Paid so far</span><span class="d-block fw-medium">KES @s.TotalPaid.ToString("N0")</span></div>
                                <div class="col-6"><span class="sub-text">Balance</span><span class="d-block fw-medium">KES @Math.Max(0, s.ContractValue - s.TotalPaid).ToString("N0")</span></div>
                                <div class="col-6"><span class="sub-text">Behind by</span><span class="d-block fw-medium @(s.Shortfall > 0 ? "text-danger" : "text-success")">KES @s.Shortfall.ToString("N0")</span></div>
                                <div class="col-6"><span class="sub-text">Last payment</span><span class="d-block fw-medium">@(s.LastPaymentDate?.ToString("dd MMM yyyy") ?? "Never")</span></div>
                                <div class="col-6"><span class="sub-text">Started</span><span class="d-block fw-medium">@(s.StartDate?.ToString("dd MMM yyyy") ?? "-")</span></div>
                            </div>
                        }
                        <span class="sub-text">Latest payments</span>
                        @if (Model.RecentPayments.Count == 0)
                        {
                            <p class="text-soft mb-0">No payments yet.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm mb-0" style="font-size:13px;">
                                    <tbody>
                                        @foreach (var p in Model.RecentPayments)
                                        {
                                            <tr><td>@p.PaymentDateValue.ToString("dd MMM yyyy")</td><td class="text-soft">@p.MpesaCode</td><td class="text-end fw-medium">KES @p.AmountValue.ToString("N0")</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* 3. Linked order and the phone *@
            <div class="col-12 col-lg-6">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <h6 class="overline-title mb-3">Linked order &amp; phone</h6>
                        @if (Model.HasOrder)
                        {
                            <dl class="cu-dl">
                                <dt>Order</dt><dd class="fw-medium">#@c.OrderID</dd>
                                <dt>Ordered</dt><dd>@c.DateCreated.ToString("dd MMM yyyy")</dd>
                                <dt>Status</dt><dd>@c.Status</dd>
                                <dt>Order total</dt><dd>KES @c.TotalAmount.ToString("N0")</dd>
                                <dt>Deposit M-Pesa</dt><dd>@(string.IsNullOrWhiteSpace(c.MpesaDepositRef) ? "-" : c.MpesaDepositRef)</dd>
                                <dt>Dealer</dt><dd>@(s?.DealerName ?? c.DealerRef ?? "-")</dd>
                                @if (c.Product != null)
                                {
                                    <dt>Phone ordered</dt><dd>@c.Product.ProductName</dd>
                                    <dt>Storage / RAM</dt><dd>@c.Product.ProductStorage / @c.Product.ProductRam</dd>
                                    <dt>Colour</dt><dd>@c.Product.ProductColor</dd>
                                }
                                <dt>IMEI</dt><dd>@(string.IsNullOrWhiteSpace(c.IMEI) ? c.DeviceDetails?.ImeiNo ?? "-" : c.IMEI)</dd>
                            </dl>
                        }
                        else
                        {
                            <p class="text-soft">No online order found for this account.</p>
                        }
                        @if (c.DeviceDetails != null)
                        {
                            <dl class="cu-dl mt-3">
                                <dt>Device</dt><dd>@c.DeviceDetails.Make @c.DeviceDetails.Model</dd>
                                <dt>Lock status</dt><dd>@(c.DeviceDetails.LockType ?? "-")</dd>
                                <dt>Next lock</dt><dd>@When(c.DeviceDetails.NextLockDateIsoFormat)</dd>
                                <dt>Last online</dt><dd>@When(c.DeviceDetails.LastConnectedAt)</dd>
                            </dl>
                        }
                    </div>
                </div>
            </div>

            @* 6. Notes *@
            <div class="col-12">
                <div class="card card-bordered">
                    <div class="card-inner">
                        <h6 class="overline-title mb-3">Notes</h6>
                        <form method="post" action="/addcollectornote" class="mb-3">
                            <input type="hidden" name="orderId" value="@Model.AccountNo" />
                            <div class="d-flex flex-wrap" style="gap:.5rem;">
                                <input type="text" name="customerNote" maxlength="1000" required class="form-control flex-grow-1" style="min-width:200px;"
                                       placeholder="Add a note, e.g. promised to pay Friday" />
                                <button type="submit" class="btn btn-primary">Add note</button>
                            </div>
                        </form>
                        @if (Model.Notes.Count == 0)
                        {
                            <p class="text-soft mb-0">No notes yet.</p>
                        }
                        else
                        {
                            <div class="bq-note">
                                @foreach (var note in Model.Notes)
                                {
                                    <div class="bq-note-item">
                                        <div class="bq-note-text"><p>@note.Note</p></div>
                                        <div class="bq-note-meta">
                                            <span class="bq-note-added">@note.Created.AddHours(3).ToString("dd MMM yyyy HH:mm")</span>
                                            <span class="bq-note-sep sep">|</span>
                                            <span class="bq-note-by">By <span>@(note.UserName ?? "-")</span></span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
