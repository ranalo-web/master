@using Ranalo.Models
@using Ranalo.Services
@model RepoStockDetailViewModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var r = Model.Item;
    var old = Model.OldContract;
    var unpaid = old == null ? 0 : RepoStockRules.WriteOff(old);
}

<link rel="stylesheet" href="~/css/watchlist-table.css?v=4">

<div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between">
            <div class="nk-block-head-content">
                <h3 class="nk-block-title page-title">Repo stock · account @r.AccountNo</h3>
                <div class="nk-block-des text-soft">
                    <p>@r.Make @r.Model · IMEI @r.Imei · on @RecoveryRules.LockGroupName(r.CurrentLockGroup)</p>
                </div>
            </div>
            <div class="nk-block-head-content">
                <a href="/repo-stock" class="btn btn-outline-light"><em class="icon ni ni-arrow-left"></em><span>Repo stock</span></a>
            </div>
        </div>
    </div>

    @if (TempData["RepoResult"] is string result)
    {
        <div class="alert alert-success alert-icon alert-dismissible">
            <em class="icon ni ni-check-circle"></em> @result
            <button class="close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["RepoError"] is string error)
    {
        <div class="alert alert-danger alert-icon alert-dismissible">
            <em class="icon ni ni-cross-circle"></em> @error
            <button class="close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="nk-block">
        <div class="row g-gs">
            <div class="col-md-4">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <div class="text-soft small">Status</div>
                        <div class="fs-5 fw-bold mb-2">@RepoStockStatus.Label(r.Status)</div>
                        <div class="small"><span class="text-soft">Why it came back:</span> @RepoStockReason.Label(r.Reason)</div>
                        <div class="small"><span class="text-soft">Condition:</span> @(r.Condition ?? "—")</div>
                        <div class="small"><span class="text-soft">Added:</span> @r.IntakeDate.ToLocalTime().ToString("dd/MM/yyyy") @(r.IntakeByName is { Length: > 0 } ? "by " + r.IntakeByName : "")</div>
                        <div class="small"><span class="text-soft">Days in stock:</span> @r.DaysInStock</div>
                        @if (r.Status == RepoStockStatus.Sold)
                        {
                            <div class="small mt-2"><span class="text-soft">Sold to:</span> @r.NewCustomerName @(r.NewCustomerPhone != null ? "· " + r.NewCustomerPhone : "")</div>
                            <div class="small"><span class="text-soft">Sold:</span> @r.SoldDate?.ToLocalTime().ToString("dd/MM/yyyy") @(r.SoldByName is { Length: > 0 } ? "by " + r.SoldByName : "")</div>
                            <div class="small"><span class="text-soft">Dealer:</span> @(r.SoldDealerName ?? "—")</div>
                            <div class="small"><span class="text-soft">New contract:</span> @r.NewContractId</div>
                            <div class="small"><span class="text-soft">Written off (pending approval):</span> @(r.WriteOffAmount?.ToString("N2") ?? "—")</div>
                        }
                        <div class="mt-2 small"><a href="/account-details/@r.AccountNo">Account details</a></div>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <h6 class="title mb-1">Previous customer: @r.OldCustomerName</h6>
                        <p class="text-soft small mb-2">Contract @r.OldContractId ended when the phone came back. Their payments are under <strong>@r.OldPaymentAccount</strong> and stay with that contract (and its commission).</p>
                        @if (old != null)
                        {
                            <div class="row g-2 small">
                                <div class="col-6 col-lg-3"><div class="text-soft">Contract value</div><div class="fw-bold">@old.ContractValue.ToString("N2")</div></div>
                                <div class="col-6 col-lg-3"><div class="text-soft">Paid</div><div class="fw-bold">@old.TotalPaid.ToString("N2")</div></div>
                                <div class="col-6 col-lg-3"><div class="text-soft">Unpaid</div><div class="fw-bold">@unpaid.ToString("N2")</div></div>
                                <div class="col-6 col-lg-3"><div class="text-soft">Last paid</div><div class="fw-bold">@(old.LastPaymentDate?.ToString("dd/MM/yyyy") ?? "never")</div></div>
                            </div>
                            @if (r.Status == RepoStockStatus.InStock)
                            {
                                <p class="text-soft small mt-2 mb-0">When the phone is sold, the unpaid @unpaid.ToString("N2") goes to Write-offs for approval.</p>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (r.Status == RepoStockStatus.InStock)
    {
        <div class="nk-block">
            <div class="card card-bordered">
                <div class="card-inner">
                    <h6 class="title mb-1">Sell to a new customer</h6>
                    <p class="text-soft small">Creates a new contract on account @r.AccountNo, starting today. The buyer pays to @r.AccountNo. The phone stays on its lock, which follows the new payments.</p>
                    <form action="/repo-stock/@r.Id/sell" method="post" id="sellForm"
                          onsubmit="return confirm('Create the contract for ' + document.getElementById('CustomerName').value + ' on account @r.AccountNo, starting today?');">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small" for="CustomerName">Buyer's name</label>
                                <input type="text" id="CustomerName" name="CustomerName" required maxlength="200" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small" for="CustomerPhone">Phone number</label>
                                <input type="text" id="CustomerPhone" name="CustomerPhone" maxlength="30" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small" for="CustomerIdNo">National ID</label>
                                <input type="text" id="CustomerIdNo" name="CustomerIdNo" maxlength="30" class="form-control form-control-sm" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small" for="Deposit">Deposit</label>
                                <input type="number" step="0.01" min="0" id="Deposit" name="Deposit" required class="form-control form-control-sm" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small" for="Daily">Daily rate</label>
                                <input type="number" step="0.01" min="0.01" id="Daily" name="Daily" required class="form-control form-control-sm" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small" for="TermInMonths">Term (months)</label>
                                <input type="number" step="1" min="1" max="36" id="TermInMonths" name="TermInMonths" value="12" required class="form-control form-control-sm" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small" for="BuyingPrice">Cost of the phone</label>
                                <input type="number" step="0.01" min="0" id="BuyingPrice" name="BuyingPrice" value="@old?.BuyingPrice" class="form-control form-control-sm"
                                       title="Used for commission, as for any sale. Starts as the original cost." />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small" for="DealerReference">Selling dealer</label>
                                <select id="DealerReference" name="DealerReference" required class="form-select form-select-sm">
                                    <option value="">Choose…</option>
                                    @foreach (var d in Model.Dealers)
                                    {
                                        <option value="@d.DealerReference">@d.CompanyName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small" for="AgentUserId">Agent (if any)</label>
                                <select id="AgentUserId" name="AgentUserId" class="form-select form-select-sm">
                                    <option value="">None</option>
                                </select>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap align-items-center mt-3" style="gap:12px;">
                            <button type="submit" class="btn btn-sm btn-primary">Create contract</button>
                            <span class="small text-soft" id="totals"></span>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <div class="nk-block">
        <div class="card card-bordered">
            <div class="card-inner card-inner-md"><h6 class="title mb-0">@r.OldCustomerName's payments (@r.OldPaymentAccount)</h6></div>
            <div class="card-inner p-0 border-top">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th class="wl-th">Date</th>
                                <th class="wl-th">M-Pesa</th>
                                <th class="wl-th text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.PreviousPayments.Count == 0)
                            {
                                <tr><td colspan="3" class="text-center text-soft py-3">No payments.</td></tr>
                            }
                            @foreach (var p in Model.PreviousPayments)
                            {
                                <tr>
                                    <td>@p.PaymentDate?.ToString("dd/MM/yyyy")</td>
                                    <td>@p.MpesaCode</td>
                                    <td class="text-end">@p.Amount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@if (r.Status == RepoStockStatus.InStock)
{
    <script>
        (function () {
            var dealer = document.getElementById('DealerReference');
            var agent = document.getElementById('AgentUserId');
            dealer.addEventListener('change', function () {
                agent.innerHTML = '<option value="">None</option>';
                if (!dealer.value) return;
                fetch('/repo-stock/agents?dealerReference=' + encodeURIComponent(dealer.value))
                    .then(function (r) { return r.ok ? r.json() : []; })
                    .then(function (list) {
                        list.forEach(function (a) {
                            var o = document.createElement('option');
                            o.value = a.userId; o.textContent = a.name;
                            agent.appendChild(o);
                        });
                    });
            });

            // Same sums as the contract: daily x 30 x months, plus the deposit.
            var totals = document.getElementById('totals');
            function update() {
                var dep = parseFloat(document.getElementById('Deposit').value) || 0;
                var daily = parseFloat(document.getElementById('Daily').value) || 0;
                var term = parseFloat(document.getElementById('TermInMonths').value) || 0;
                var loan = daily * 30 * term;
                totals.textContent = daily > 0 && term > 0
                    ? 'Contract total ' + (dep + loan).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                      + ' (' + term + ' months, ' + (term * 30) + ' days)'
                    : '';
            }
            ['Deposit', 'Daily', 'TermInMonths'].forEach(function (id) { document.getElementById(id).addEventListener('input', update); });
        })();
    </script>
}
