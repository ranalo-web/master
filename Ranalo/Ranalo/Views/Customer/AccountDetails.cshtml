                                <div class="form-group">
                                    <label class="form-label" for="edit-income">New Rate</label>
                                    <div class="form-control-wrap">
                                        <input type="number" name="newRate" class="form-control" id="edit-income" required />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label" for="edit-date">Date From</label>
                                    <div class="form-control-wrap">
                                        <div class="form-icon form-icon-left">
                                            <em class="icon ni ni-calendar"></em>
                                        </div>
                                        <input type="text" name="dateFrom" id="edit-date" class="form-control date-picker" data-date-format="yyyy-mm-dd" required>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <ul class="align-center flex-wrap flex-sm-nowrap gx-4 gy-2">
                                    <li>
                                        <button type="submit" class="btn btn-lg btn-primary">Submit</button>
                                    </li>
                                    <li>
                                        <a href="#" data-bs-dismiss="modal" class="link link-gray">Cancel</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- .Edit Modal-Content -->

        <div class="modal fade" tabindex="-1" id="modalCustomerNotes">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <button class="close" data-dismiss="modal" aria-label="Close">
                    <em class="icon ni ni-cross"></em>
                </button>
                <div class="modal-header">
                    <h5 class="modal-title">Customer Note</h5>
                </div>
                    <form action="/addcustomernote" method="post">
                                <input name="orderId" type="hidden" value="@(Model.OrderID == 0 ? Model?.Payments?.FirstOrDefault()?.AccountNo : Model.OrderID)">
                    <div class="modal-body">
                        <div class="nk-block nk-block-lg">
                            <div class="card">
                                <div class="card-inner">
                                    <textarea name="customerNote" class="tinymce-toolbar form-control">Add note!</textarea>
                                </div>
                            </div>
                        </div><!-- .nk-block -->
                    </div>
                    <div class="modal-footer bg-light">
                        <button data-bs-dismiss="modal" class="btn btn-lg btn-danger">Cancel</button>
                        <button type="submit" class="btn btn-lg btn-primary">Save</button>
                    </div>
                </form>

            </div>
        </div>
    </div>
}
