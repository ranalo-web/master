@functions {
    private string SetStatusBadge(string status)
    {
        var statusClass = "";
        switch (status)
        {
            case "approval-waiting":
                statusClass = "lead-text text-warning";
                break;
            case "cancelled":
                statusClass = "lead-text text-danger";
                break;
            case "rejected":
                statusClass = "lead-text text-danger";
                break;
            case "approved":
                statusClass = "lead-text text-success";
                break;
            default:
                statusClass = "";
                break;
        }

        return statusClass;
    }

    private string SetLockStatusBadge(string status)
    {
        var statusClass = "";
        switch (status)
        {
            case "unlocked":
                statusClass = "tb-status text-success";
                break;
            case "un_registered":
                statusClass = "tb-status text-info";
                break;
            case "rejected":
                statusClass = "tb-status text-danger";
                break;
            case "complete":
                statusClass = "tb-status text-danger";
                break;
            default:
                statusClass = "";
                break;
        }

        return statusClass;
    }

    private string FormartUtcDate(string date)
    {
        // Parse using exact format and culture
        DateTime parsedDate = DateTime.ParseExact(
            date.Replace(" UTC", ""),   // remove UTC label before parsing
        "dd-MM-yy HH:mm:ss",
        System.Globalization.CultureInfo.InvariantCulture,
        System.Globalization.DateTimeStyles.AssumeUniversal | System.Globalization.DateTimeStyles.AdjustToUniversal
    );

        // Format to desired output
        return parsedDate.ToString("dd/MM/yyyy HH:mm:ss");
    }

    public string FormartDateWithT(string input)
    {
        input = input.Replace("T", " ");

        // Parse it
        DateTime parsedDate = DateTime.ParseExact(
            input,
            "dd/MM/yyyy HH:mm:ss",
            System.Globalization.CultureInfo.InvariantCulture
        );

        // Format to desired string
        return parsedDate.ToString("dd/MM/yyyy HH:mm:ss");
    }

}

