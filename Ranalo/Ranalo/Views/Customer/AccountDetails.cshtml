@using Ranalo.Models
@model CustomerDetails
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@functions {
    private static string Ksh(decimal v) => "KES " + v.ToString("N0");

    // Dates arrive as text in several shapes ("10-11-26 09:55:00 UTC",
    // "11/11/2026T12:55:00", ISO). Never throws: unreadable text is shown as is.
    private static string When(string? text, bool utc = false)
    {
        if (string.IsNullOrWhiteSpace(text)) return "-";
        var t = text.Trim().Replace(" UTC", "");
        var formats = new[] { "dd-MM-yy HH:mm:ss", "dd/MM/yyyy'T'HH:mm:ss", "dd/MM/yyyy HH:mm:ss", "dd/MM/yyyy",
                              "yyyy-MM-dd'T'HH:mm:ss", "yyyy-MM-dd HH:mm:ss" };
        if (!DateTime.TryParseExact(t, formats, System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var d)
            && !DateTime.TryParse(t, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out d))
            return text.Trim();
        if (d.Year < 2000) return "-";   // 01-01-70 = never
        return (utc ? d.AddHours(3) : d).ToString("dd MMM yyyy, HH:mm");
    }

    private static string OrDash(string? s) => string.IsNullOrWhiteSpace(s) ? "-" : s.Trim();
}

@if (Model == null)
{
    <div class="alert alert-pro alert-warning">
        <div class="alert-text">
            <h6>Account details</h6>
            <p>This account or order couldn't be found. Check the number in the link.</p>
        </div>
    </div>
}
else
{
    string? accountNo = Model.Payments.FirstOrDefault()?.AccountNo
        ?? (Model.Summary?.AccountId > 0 ? Model.Summary.AccountId.ToString() : Model.AccountId != 0 ? Model.AccountId.ToString() : null);
    var s = Model.Summary;
    var contractTotal = s == null ? 0
        : Math.Round(s.Deposit + s.Daily * 30 * s.TermsInMonths + s.Weekly * (30m / 7m) * s.TermsInMonths + s.Monthly * s.TermsInMonths, 0);
    var balance = s == null ? 0 : Math.Max(0, contractTotal - s.TotalPaid);
    var paidPercent = contractTotal > 0 && s != null ? (int)Math.Min(100, Math.Round(s.TotalPaid / contractTotal * 100)) : 0;
    var arrears = Model.Arrears ?? 0;
    var frequency = s == null ? "-" : s.Daily > 0 ? "Daily" : s.Weekly > 0 ? "Weekly" : s.Monthly > 0 ? "Monthly" : "-";
    var instalment = s == null ? 0 : s.Daily > 0 ? s.Daily : s.Weekly > 0 ? s.Weekly : s.Monthly;
    var device = Model.DeviceDetails;
    var service = Ranalo.Services.RecoveryRules.LockGroupName(device?.LockGroup ?? s?.LockGroup);
    var locked = device != null && (device.Locked || string.Equals(device.LockType, "complete", StringComparison.OrdinalIgnoreCase));
    var photo = Model.IdentityImages.FirstOrDefault(x => x.Key == "photo_of_applicant")?.Url;

    <style>
        .ss-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
        .ss-tile { border: 1px solid #e5e9f2; border-radius: 8px; padding: 10px 12px; min-width: 0; }
        .ss-tile .lbl { display: block; font-size: 12px; color: #8094ae; margin-bottom: 2px; }
        .ss-tile .val { display: block; font-weight: 600; font-size: 15px; overflow-wrap: anywhere; }
        .ss-tile .sub { display: block; font-size: 12px; color: #8094ae; }
        .ss-section + .ss-section { margin-top: 28px; }
        .ss-section h5 { margin-bottom: 12px; }
        .ss-kv { display: grid; grid-template-columns: 1fr; gap: 8px; }
        .ss-kv .k { display: block; font-size: 12px; color: #8094ae; }
        .ss-kv .v { overflow-wrap: anywhere; }
        /* The headline: where the account stands, as the old "In account" figure. */
        .ad-hero { display: flex; flex-wrap: wrap; gap: 16px 32px; align-items: center; justify-content: space-between;
            border-radius: 12px; padding: 18px 20px; margin-bottom: 24px; }
        .ad-hero.behind { background: #fdf1f1; border: 1px solid #f6caca; }
        .ad-hero.ahead { background: #eef8f3; border: 1px solid #c7ead8; }
        .ad-hero-main { display: flex; flex-direction: column; min-width: 0; }
        .ad-hero-lbl { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: #8094ae; }
        .ad-hero-num { font-size: 34px; font-weight: 800; line-height: 1.15; font-variant-numeric: tabular-nums; }
        .ad-hero-num small { font-size: 15px; font-weight: 600; color: #8094ae; }
        .ad-hero.behind .ad-hero-num { color: #c0392b; }
        .ad-hero.ahead .ad-hero-num { color: #1e8e5a; }
        .ad-hero-sub { font-size: 14px; color: #3c4d62; }
    </style>

    <div class="nk-content-body">
        <div class="nk-block-head">
            <div class="nk-block-head-sub"><span>@(accountNo != null ? $"Account {accountNo}" : "")</span></div>
            <div class="nk-block-between-md g-4">
                <div class="nk-block-head-content">
                    <h2 class="nk-block-title page-title">@Model.FirstName @Model.LastName</h2>
                    <div class="nk-block-des text-soft"><p>@(device != null ? $"{device.Make} {device.Model}" : "No phone linked yet")</p></div>
                </div>
                <div class="nk-block-head-content">
                    <ul class="nk-block-tools g-2">
                        <li><a href="javascript:history.back()" class="btn btn-outline-light bg-white"><em class="icon ni ni-arrow-left"></em><span>Back</span></a></li>
                        @if (accountNo != null)
                        {
                            <li><a href="/statussummary/@accountNo" class="btn btn-outline-light bg-white"><em class="icon ni ni-list"></em><span>Status &amp; history</span></a></li>
                        }
                        @if ((ViewBag.IsAdmin is true || ViewBag.IsApprover is true) && accountNo != null)
                        {
                            <li><button type="button" data-bs-toggle="modal" data-bs-target="#modalRestructure" class="btn btn-primary"><em class="icon ni ni-repeat"></em><span>Restructure</span></button></li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        @if (TempData["RestructureError"] is string restructureError)
        {
            <div class="alert alert-danger alert-icon"><em class="icon ni ni-cross-circle"></em> @restructureError</div>
        }

        <div class="nk-block">
            <div class="row g-gs">
                <div class="col-xl-8">
                    <div class="card card-bordered">
                        <div class="card-inner">

                            @if (s != null)
                            {
                                <div class="ad-hero @(arrears < 0 ? "behind" : "ahead")">
                                    <div class="ad-hero-main">
                                        <span class="ad-hero-lbl">In account</span>
                                        <span class="ad-hero-num">@(arrears < 0 ? "-" : "+")@Math.Abs(arrears).ToString("N0") <small>KES</small></span>
                                        <span class="ad-hero-sub">@(arrears < 0 ? "Behind on payments" : arrears > 0 ? "Paid ahead" : "Up to date")@(locked ? " · phone locked" : "")</span>
                                    </div>
                                </div>

                                <div class="ss-section">
                                    <h5 class="title">Loan</h5>
                                    <div class="ss-grid">
                                        <div class="ss-tile"><span class="lbl">Contract total</span><span class="val">@Ksh(contractTotal)</span><span class="sub">incl. deposit @Ksh(s.Deposit)</span></div>
                                        <div class="ss-tile"><span class="lbl">Paid so far</span><span class="val">@Ksh(s.TotalPaid)</span></div>
                                        <div class="ss-tile"><span class="lbl">Balance left</span><span class="val">@Ksh(balance)</span></div>
                                        <div class="ss-tile"><span class="lbl">Due by today</span><span class="val">@Ksh(Model.TotalDue ?? 0)</span></div>
                                        <div class="ss-tile">
                                            <span class="lbl">@(arrears < 0 ? "Behind by" : "Ahead by")</span>
                                            <span class="val @(arrears < 0 ? "text-danger" : "text-success")">@Ksh(Math.Abs(arrears))</span>
                                        </div>
                                        <div class="ss-tile"><span class="lbl">Instalment</span><span class="val">@Ksh(instalment)</span><span class="sub">@frequency</span></div>
                                        <div class="ss-tile"><span class="lbl">Term</span><span class="val">@s.TermsInMonths.ToString("0.#") months</span><span class="sub">@Math.Max(0, Math.Round(Model.DaysLeft)) days left</span></div>
                                        <div class="ss-tile"><span class="lbl">Started</span><span class="val">@s.FirstPaymentDate.ToString("dd MMM yyyy")</span><span class="sub">first payment @Ksh(s.FirstAmount)</span></div>
                                    </div>
                                    <div class="mt-3">
                                        <div class="d-flex justify-content-between small mb-1">
                                            <span>Paid @paidPercent% of the contract</span>
                                            <span class="text-soft">@Ksh(s.TotalPaid) of @Ksh(contractTotal)</span>
                                        </div>
                                        <div class="progress progress-lg"><div class="progress-bar bg-success" style="width:@(paidPercent)%;"></div></div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="ss-section"><h5 class="title">Loan</h5><p class="text-soft mb-0">No payments on this account yet.</p></div>
                            }

                            <div class="ss-section">
                                <h5 class="title">Device Details</h5>
                                @if (Model.DeviceDetails != null)
                                {
                                    <div class="profile-ud-list">
                                        <div class="profile-ud-item">
                                            <div class="profile-ud wider">
                                                <span class="profile-ud-label">Make</span>
                                                <span class="profile-ud-value">@Model.DeviceDetails.Make</span>
                                            </div>
                                        </div>
                                        <div class="profile-ud-item">
                                            <div class="profile-ud wider">
                                                <span class="profile-ud-label">Model</span>
                                                <span class="profile-ud-value">@Model.DeviceDetails.Model</span>
                                            </div>
                                        </div>
                                        <div class="profile-ud-item">
                                            <div class="profile-ud wider">
                                                <span class="profile-ud-label">Lock Status</span>
                                                <span class="profile-ud-value @(locked ? "text-danger" : "text-success")">@Model.DeviceDetails.LockType</span>
                                            </div>
                                        </div>
                                        <div class="profile-ud-item">
                                            <div class="profile-ud wider">
                                                <span class="profile-ud-label">Enrolled</span>
                                                <span class="profile-ud-value">@When(Model.DeviceDetails.EnrolledOn, utc: true)</span>
                                            </div>
                                        </div>
                                        <div class="profile-ud-item">
                                            <div class="profile-ud wider">
                                                <span class="profile-ud-label">Last Connected</span>
                                                <span class="profile-ud-value">@When(Model.DeviceDetails.LastConnectedAt, utc: true)</span>
                                            </div>
                                        </div>
                                        <div class="profile-ud-item">
                                            <div class="profile-ud wider">
                                                <span class="profile-ud-label">Next Lock</span>
                                                <span class="profile-ud-value">@When(Model.DeviceDetails.NextLockDateIsoFormat ?? Model.DeviceDetails.NextLockDate)</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-soft mb-0">No phone linked to this account yet.</p>
                                }
                            </div>

                            @if (Model.Product != null)
                            {
                                <div class="ss-section">
                                    <h5 class="title">Device Information</h5>
                                    <div class="profile-ud-list">
                                        <div class="profile-ud-item">
                                            <div class="profile-ud wider">
                                                <span class="profile-ud-label">Name</span>
                                                <span class="profile-ud-value">@Model.Product.ProductName</span>
                                            </div>
                                        </div>
                                        <div class="profile-ud-item">
                                            <div class="profile-ud wider">
                                                <span class="profile-ud-label">Storage</span>
                                                <span class="profile-ud-value">@Model.Product.ProductStorage</span>
                                            </div>
                                        </div>
                                        <div class="profile-ud-item">
                                            <div class="profile-ud wider">
                                                <span class="profile-ud-label">SKU</span>
                                                <span class="profile-ud-value">@Model.Product.Sku</span>
                                            </div>
                                        </div>
                                        <div class="profile-ud-item">
                                            <div class="profile-ud wider">
                                                <span class="profile-ud-label">RAM</span>
                                                <span class="profile-ud-value">@Model.Product.ProductRam</span>
                                            </div>
                                        </div>
                                        <div class="profile-ud-item">
                                            <div class="profile-ud wider">
                                                <span class="profile-ud-label">Order No</span>
                                                <span class="profile-ud-value">@Model.Product.ProductId</span>
                                            </div>
                                        </div>
                                        <div class="profile-ud-item">
                                            <div class="profile-ud wider">
                                                <span class="profile-ud-label">Color</span>
                                                <span class="profile-ud-value">@Model.Product.ProductColor</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="ss-section">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h5 class="title mb-0">Recent payments</h5>
                                    @if (accountNo != null) { <a href="/statussummary/@accountNo" class="link link-sm">Status &amp; restructure history</a> }
                                </div>
                                @if (Model.Payments.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm mb-0">
                                            <thead><tr><th>Date</th><th>M-Pesa code</th><th class="text-end">Amount</th></tr></thead>
                                            <tbody>
                                                @foreach (var p in Model.Payments)
                                                {
                                                    <tr>
                                                        <td style="white-space:nowrap;">@p.PaymentDateValue.ToString("dd MMM yyyy, HH:mm")</td>
                                                        <td>@p.MpesaCode</td>
                                                        <td class="text-end" style="white-space:nowrap;">@Ksh(p.AmountValue)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-soft mb-0">No payments yet.</p>
                                }
                            </div>

                            <div class="ss-section">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h5 class="title mb-0">Notes</h5>
                                    <button type="button" data-bs-toggle="modal" data-bs-target="#modalCustomerNotes" class="btn btn-sm btn-outline-primary"><em class="icon ni ni-plus"></em><span>Add note</span></button>
                                </div>
                                @if (Model.Notes != null && Model.Notes.Any())
                                {
                                    <div class="bq-note">
                                        @foreach (var note in Model.Notes.OrderByDescending(n => n.Created))
                                        {
                                            <div class="bq-note-item">
                                                <div class="bq-note-text"><p>@note.Note</p></div>
                                                <div class="bq-note-meta">
                                                    <span class="bq-note-added">@note.Created.ToString("dd MMM yyyy, HH:mm")</span>
                                                    <span class="bq-note-sep sep">|</span>
                                                    <span class="bq-note-by">By <span>@note.UserName</span></span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-soft mb-0">No notes yet.</p>
                                }
                            </div>

                        </div>
                    </div>
                </div>

                <div class="col-xl-4">
                    <div class="card card-bordered">
                        <div class="card-inner">
                            <div class="user-card user-card-s2">
                                <div class="user-avatar lg bg-primary">
                                    @if (!string.IsNullOrWhiteSpace(photo))
                                    {
                                        <img src="@photo" alt="">
                                    }
                                    else
                                    {
                                        <span>@(string.IsNullOrWhiteSpace(Model.FirstName) ? "?" : Model.FirstName.Trim()[..1].ToUpperInvariant())</span>
                                    }
                                </div>
                                <div class="user-info">
                                    <h5>@Model.FirstName @Model.LastName</h5>
                                    <span class="sub-text">@Model.Email</span>
                                </div>
                            </div>
                        </div>
                        <div class="card-inner border-top">
                            <h6 class="overline-title mb-2">Customer</h6>
                            <div class="ss-kv">
                                <div><span class="k">Phone</span><span class="v">@OrDash(Model.Phone)</span></div>
                                <div><span class="k">National ID</span><span class="v">@OrDash(Model.NationalId)</span></div>
                                <div><span class="k">Address</span><span class="v">@OrDash(Model.Address1)</span></div>
                                <div><span class="k">Email</span><span class="v">@OrDash(Model.Email)</span></div>
                            </div>
                        </div>
                        @if (Model.OrderID > 0)
                        {
                            <div class="card-inner border-top">
                                <h6 class="overline-title mb-2">Order</h6>
                                <div class="ss-kv">
                                    <div><span class="k">Order</span><span class="v">@Model.OrderID · @OrDash(Model.Status)</span></div>
                                    <div><span class="k">Ordered</span><span class="v">@Model.DateCreated.ToString("dd MMM yyyy, HH:mm")</span></div>
                                    <div><span class="k">Dealer ref</span><span class="v">@OrDash(Model.DealerRef)</span></div>
                                    <div><span class="k">Deposit M-Pesa code</span><span class="v">@OrDash(Model.MpesaDepositRef)</span></div>
                                    <div><span class="k">IMEI on the order</span><span class="v">@OrDash(Model.IMEI)</span></div>
                                </div>
                            </div>
                        }
                        @foreach (var (title, kin) in new[] { ("Next of kin", Model.NextOfKin), ("Second next of kin", Model.NextOfKin2) })
                        {
                            <div class="card-inner border-top">
                                <h6 class="overline-title mb-2">@title</h6>
                                @if (kin != null)
                                {
                                    <div class="ss-kv">
                                        <div><span class="k">Name</span><span class="v">@OrDash(kin.Name)</span></div>
                                        <div><span class="k">Phone</span><span class="v">@OrDash(kin.Phone)</span></div>
                                        <div><span class="k">ID number</span><span class="v">@OrDash(kin.IdNumber)</span></div>
                                        <div><span class="k">Email</span><span class="v">@OrDash(kin.Email)</span></div>
                                        <div><span class="k">Address</span><span class="v">@OrDash(kin.Address)</span></div>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-soft small mb-0">None on file.</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" tabindex="-1" id="modalRestructure">
        <div class="modal-dialog modal-md" role="document">
            <div class="modal-content">
                <a href="#" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <em class="icon ni ni-cross-sm"></em>
                </a>
                <div class="modal-body modal-body-md">
                    <h5 class="modal-title">Restructure Payments</h5>
                    <form action="/restructure-payment" method="post" class="mt-2">
                        <input type="hidden" name="accountNo" value="@Model?.Payments?.FirstOrDefault()?.AccountNo" />
                        <div class="row g-gs">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label" for="edit-income">New Rate</label>
                                    <div class="form-control-wrap">
                                        <input type="number" name="newRate" class="form-control" id="edit-income" step="0.01" min="0.01" required />
                                        @if (ViewBag.IsApprover is true)
                                        {
                                            <div class="form-note">Approvers can't go below the account's daily payment.</div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label" for="edit-date">Date From</label>
                                    <div class="form-control-wrap">
                                        <div class="form-icon form-icon-left">
                                            <em class="icon ni ni-calendar"></em>
                                        </div>
                                        <input type="text" name="dateFrom" id="edit-date" class="form-control date-picker" data-date-format="yyyy-mm-dd" required>
                                    </div>
                                </div>
                            </div>
                        <div class="col-12">
                            <div class="form-group">
                                <label class="form-label" for="restructure-reason">Reason</label>
                                <div class="form-control-wrap">
                                    <textarea name="reason" id="restructure-reason" class="form-control" rows="2" minlength="5" maxlength="300" required placeholder="Why this plan, e.g. lost job, agreed Ksh 100 a day until March"></textarea>
                                </div>
                                <div class="form-note">Shown in the account's restructure history.</div>
                            </div>
                        </div>

                            <div class="col-12">
                                <ul class="align-center flex-wrap flex-sm-nowrap gx-4 gy-2">
                                    <li>
                                        <button type="submit" class="btn btn-lg btn-primary">Submit</button>
                                    </li>
                                    <li>
                                        <a href="#" data-bs-dismiss="modal" class="link link-gray">Cancel</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- .Edit Modal-Content -->

        <div class="modal fade" tabindex="-1" id="modalCustomerNotes">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <em class="icon ni ni-cross"></em>
                </button>
                <div class="modal-header">
                    <h5 class="modal-title">Customer Note</h5>
                </div>
                    <form action="/addcustomernote" method="post">
                                <input name="orderId" type="hidden" value="@(Model.OrderID == 0 ? Model?.Payments?.FirstOrDefault()?.AccountNo : Model.OrderID)">
                    <div class="modal-body">
                        <div class="nk-block nk-block-lg">
                            <div class="card">
                                <div class="card-inner">
                                    <textarea name="customerNote" class="form-control" rows="5" required placeholder="What happened, e.g. called, promised to pay Ksh 500 on Friday"></textarea>
                                </div>
                            </div>
                        </div><!-- .nk-block -->
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" data-bs-dismiss="modal" class="btn btn-lg btn-light">Cancel</button>
                        <button type="submit" class="btn btn-lg btn-primary">Save</button>
                    </div>
                </form>

            </div>
        </div>
    </div>
}
