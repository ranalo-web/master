*@
@model AwaitingApprovalViewModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@functions
{
    private string SetStatusBadge(string status)
    {
        var statusClass = "";
        switch (status)
        {
            case "approval-waiting":
                statusClass = "tb-status text-warning";
                break;
            case "cancelled":
                statusClass = "tb-status text-danger";
                break;
            case "rejected":
                statusClass = "tb-status text-danger";
                break;
            case "approved":
                statusClass = "tb-status text-success";
                break;
            default:
                statusClass = "";
                break;
        }

        return statusClass;
    }

    private string SetSearchTerm()
    {
        if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            return Model.SearchTerm;
        }

        return "Search...";
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "string.Empty";

        // Split by spaces and take first character of each word
        var initials = fullName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(word => char.ToUpper(word[0]))
            .Take(2) // only take first 2 initials
            .ToArray();

        return new string(initials);
    }
}

<link rel="stylesheet" href="~/css/watchlist-table.css?v=4">

<div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between">
