                        </ul>
                    </div>
                </div><!-- .toggle-wrap -->
            </div><!-- .nk-block-head-content -->
        </div><!-- .nk-block-between -->
    </div><!-- .nk-block-head -->
    <div class="nk-block">
        <div class="card card-bordered card-stretch">
            <div class="card-inner-group">
                <div class="card-inner position-relative card-tools-toggle">
                    <div class="card-title-group">
                       @*  <div class="card-tools">
                            <div class="form-inline flex-nowrap gx-3">
                                <div class="form-wrap w-150px">
                                    <select class="form-select js-select2" data-search="off" data-placeholder="Bulk Action">
                                        <option value="">Bulk Action</option>
                                        <option value="email">Send Email</option>
                                        <option value="suspend">Suspend</option>
                                        <option value="delete">Delete</option>
                                    </select>
                                </div>
                                <div class="btn-wrap">
                                    <span class="d-none d-md-block"><button class="btn btn-dim btn-outline-light disabled">Apply</button></span>
                                    <span class="d-md-none"><button class="btn btn-dim btn-outline-light btn-icon disabled"><em class="icon ni ni-arrow-right"></em></button></span>
                                </div>
                            </div><!-- .form-inline -->
                        </div><!-- .card-tools --> *@
                        <div class="card-tools me-n1">
                            <ul class="btn-toolbar gx-1">
                                <li>
                                    <a href="#" class="btn btn-icon search-toggle toggle-search" data-target="search"><em class="icon ni ni-search"></em></a>
                                </li><!-- li -->
                                <li class="btn-toolbar-sep"></li><!-- li -->
                                <li>
                                    <div class="toggle-wrap">
                                        <a href="#" class="btn btn-icon btn-trigger toggle" data-target="cardTools"><em class="icon ni ni-menu-right"></em></a>
                                        <div class="toggle-content" data-content="cardTools">
                                            <ul class="btn-toolbar gx-1">
                                                <li class="toggle-close">
                                                    <a href="#" class="btn btn-icon btn-trigger toggle" data-target="cardTools"><em class="icon ni ni-arrow-left"></em></a>
                                                </li><!-- li -->
                                                <li>
                                                    <div class="dropdown">
                                                        <a href="#" class="btn btn-trigger btn-icon dropdown-toggle" data-bs-toggle="dropdown">
                                                            <em class="icon ni ni-setting"></em>
                                                        </a>
                                                        <div class="dropdown-menu dropdown-menu-xs dropdown-menu-end">
                                                            <ul class="link-check">
                                                                <li><span>Show</span></li>
                                                                <li class="active"><a href="#">10</a></li>
                                                                <li><a href="#">20</a></li>
                                                                <li><a href="#">50</a></li>
                                                            </ul>
                                                            <ul class="link-check">
                                                                <li><span>Order</span></li>
                                                                <li class="active"><a href="#">DESC</a></li>
                                                                <li><a href="#">ASC</a></li>
                                                            </ul>
                                                        </div>
                                                    </div><!-- .dropdown -->
                                                </li><!-- li -->
                                            </ul><!-- .btn-toolbar -->
                                        </div><!-- .toggle-content -->
                                    </div><!-- .toggle-wrap -->
                                </li><!-- li -->
                            </ul><!-- .btn-toolbar -->
                        </div><!-- .card-tools -->
                    </div><!-- .card-title-group -->
                    <div class="card-search search-wrap" data-search="search">
                        <div class="card-body">
                            <div class="search-content">
                                <form asp-action="SearchDashBoard" asp-controller="Home" method="post">
                                    <a href="#" class="search-back btn btn-icon toggle-search" data-target="search"><em class="icon ni ni-arrow-left"></em></a>
                                    <input name="searchTerm" type="text" class="form-control border-transparent form-focus-none" placeholder="@SetSearchTerm()">
                                    <button class="search-submit btn btn-icon"><em class="icon ni ni-search"></em></button>
                                </form>

                            </div>
                        </div>
                    </div><!-- .card-search -->
                </div><!-- .card-inner -->
                <div class="card-inner p-0">
                    <div class="table-responsive">
                    <table class="table mb-0" style="white-space:nowrap;" data-key="never-paid" data-page-size="10">
                        <thead>
                            <tr>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Customer</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Email</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Phone</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Dealer Name</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Mpesa Code</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Joined</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Status</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Days</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var order in Model.AwaitingApprovals)
                        {
                            <tr>
                                <td><a href="/account-details/@order.OrderId" class="fw-medium">@order.FirstName @order.LastName</a></td>
                                <td>@order.Email</td>
                                <td>@order.Phone</td>
                                <td>@order.DealerRef</td>
                                <td>@order.MpesaDepositRef</td>
                                <td>@order.DateCreated.ToString("dd MMM yyyy")</td>
                                <td><span class="@SetStatusBadge(order.Status)">@order.Status</span></td>
                                <td>@order.DaysUnpaid</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    </div><!-- .table-responsive -->
                </div><!-- .card-inner -->
                <div class="card-inner">
                    <div class="nk-block-between-md g-3">
                        <div class="g">
                            <ul class="pagination justify-content-center justify-content-md-start">
                                @if (Model.CurrentPage > 1)
                                {
                                        <li class="page-item">
                                        <a class="page-link" href="/never-paid?page=@(Model.CurrentPage - 1)">Prev</a>
                                        </li>
                                }

                                @{
                                    var maxVisiblePages = 5;
                                    var startPage = Math.Max(1, Model.CurrentPage - 2);
                                    var endPage = Math.Min(Model.TotalPages, startPage + maxVisiblePages - 1);
                                    if (endPage - startPage < maxVisiblePages - 1)
                                    {
                                        startPage = Math.Max(1, endPage - maxVisiblePages + 1);
                                    }
                                }

                                @if (startPage > 1)
                                {
                                        <li class="page-item">
                                        <a class="page-link" href="/never-paid?page=1">1</a>
                                        </li>
                                        <li class="page-item">
                                            <span class="page-link"><em class="icon ni ni-more-h"></em></span>
                                        </li>
                                }

                                @for (int i = startPage; i <= endPage; i++)
                                {
                                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="/never-paid?page=@i">@i</a>
                                        </li>
                                }

                                @if (endPage < Model.TotalPages)
                                {
                                        <li class="page-item">
                                            <span class="page-link"><em class="icon ni ni-more-h"></em></span>
                                        </li>
                                        <li class="page-item">
                                        <a class="page-link" href="/never-paid?page=@Model.TotalPages">@Model.TotalPages</a>
                                        </li>
                                }

                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                        <li class="page-item">
                                        <a class="page-link" href="/never-paid?page=@(Model.CurrentPage + 1)">Next</a>
                                        </li>
                                }
                            </ul>
                        </div>
                        <div class="g">
                            <div class="pagination-goto d-flex justify-content-center justify-content-md-start gx-3">
                                <div>Page</div>
                                <div>
                                    <select class="form-select js-select2" 
                                            data-search="on" 
                                            data-dropdown="xs center"
                                            onchange="location.href='/never-paid?page=' + this.value">
                                        >
                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                                <option value="@i" @(Model.CurrentPage == i ? "selected" : "")>
                                                @i
                                                </option>
                                        }
                                    </select>
                                </div>
                                <div>OF @Model.TotalPages</div>
                            </div>
                        </div><!-- .pagination-goto -->
                    </div><!-- .nk-block-between -->
                </div><!-- .card-inner -->
            </div><!-- .card-inner-group -->
        </div><!-- .card -->
    </div><!-- .nk-block -->
</div>

@section Scripts
{
    <script src="~/js/watchlist-table.js"></script>
}
