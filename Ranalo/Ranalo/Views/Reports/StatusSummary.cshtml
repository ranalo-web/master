@using Ranalo.Models
@model MobileStatusReport
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var canRestructure = ViewBag.IsAdmin is true || ViewBag.IsApprover is true;
    var history = ViewBag.RestructureHistory as List<Ranalo.DataStore.RestructureLogEntry> ?? new();
    var contractTotal = Model.Deposit + Model.TotalLoan;
    var paidPercent = contractTotal > 0 ? (int)Math.Min(100, Math.Round(Model.TotalPaid / contractTotal * 100)) : 0;
    var behind = Model.Arrears < 0 ? -Model.Arrears : 0;
    var ahead = Model.Arrears > 0 ? Model.Arrears : 0;
    var plan = Model.RestructuredRecords.OrderByDescending(r => r.DateAgreed).FirstOrDefault();
    var service = Ranalo.Services.RecoveryRules.LockGroupName(Model.LockGroup);
    var locked = Model.Locked || string.Equals(Model.LockType, "complete", StringComparison.OrdinalIgnoreCase);
}
@functions {
    private static string Ksh(decimal v) => "KES " + v.ToString("N0");

    // Next lock is stored as text in a few shapes; shown as "11 Nov 2026, 12:55".
    private static string When(string? date)
    {
        if (string.IsNullOrWhiteSpace(date)) return "-";
        var formats = new[] { "dd/MM/yyyy HH:mm:ss", "dd/MM/yyyy'T'HH:mm:ss", "dd/MM/yyyy", "yyyy-MM-dd'T'HH:mm:ss", "yyyy-MM-dd HH:mm:ss" };
        return DateTime.TryParseExact(date.Trim(), formats, System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var d)
            || DateTime.TryParse(date.Trim(), System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out d)
            ? d.ToString("dd MMM yyyy, HH:mm")
            : date.Trim();
    }
}

<style>
    /* Equal tiles that wrap; long values break instead of running into the next tile. */
    .ss-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
    .ss-tile { border: 1px solid #e5e9f2; border-radius: 8px; padding: 10px 12px; min-width: 0; }
    .ss-tile .lbl { display: block; font-size: 12px; color: #8094ae; margin-bottom: 2px; }
    .ss-tile .val { display: block; font-weight: 600; font-size: 15px; overflow-wrap: anywhere; }
    .ss-tile .sub { display: block; font-size: 12px; color: #8094ae; }
    .ss-section + .ss-section { margin-top: 28px; }
    .ss-section h5 { margin-bottom: 12px; }
    .ss-table td, .ss-table th { vertical-align: top; }
</style>

<div class="nk-content-body">
    <div class="nk-block-head">
        <div class="nk-block-head-sub"><span>Account @Model.AccountNo</span></div>
        <div class="nk-block-between-md g-4">
            <div class="nk-block-head-content">
                <h2 class="nk-block-title page-title">@Model.FirstName @Model.CustomerDetails?.LastName</h2>
                <div class="nk-block-des text-soft"><p>@Model.Make @Model.Model · @service</p></div>
            </div>
            @if (canRestructure)
            {
                <div class="nk-block-head-content">
                    <button type="button" data-bs-toggle="modal" data-bs-target="#modalRestructure" class="btn btn-primary"><em class="icon ni ni-repeat"></em><span>Restructure</span></button>
                </div>
            }
        </div>
    </div>

    @if (TempData["RestructureError"] is string restructureError)
    {
        <div class="alert alert-danger alert-icon"><em class="icon ni ni-cross-circle"></em> @restructureError</div>
    }

    <div class="nk-block">
        <div class="row g-gs">
            <div class="col-lg-4 col-xxl-3">
                <div class="card card-bordered">
                    <div class="card-inner">
                        <div class="user-card user-card-s2">
                            <div class="user-avatar lg bg-primary">
                                @if (Model.CustomerDetails?.Url != null)
                                {
                                    <img src="@Model.CustomerDetails.Url" alt="">
                                }
                                else
                                {
                                    <span>@(string.IsNullOrWhiteSpace(Model.FirstName) ? "?" : Model.FirstName.Trim()[..1].ToUpperInvariant())</span>
                                }
                            </div>
                            <div class="user-info">
                                <h5>@Model.FirstName @Model.CustomerDetails?.LastName</h5>
                                <span class="sub-text">@Model.CustomerDetails?.Email</span>
                            </div>
                        </div>
                    </div>
                    <div class="card-inner border-top">
                        <h6 class="overline-title mb-2">Customer</h6>
                        @{
                            var details = new (string Label, string? Value)[]
                            {
                                ("Phone", Model.CustomerDetails?.Phone),
                                ("National ID", Model.CustomerDetails?.NationalId),
                                ("Address", Model.CustomerDetails?.Address1),
                                ("Email", Model.CustomerDetails?.Email),
                                ("IMEI", Model.ImeiNo ?? Model.CustomerDetails?.IMEI),
                                ("Dealer ref", Model.CustomerDetails?.DealerRef),
                                ("Deposit M-Pesa code", Model.CustomerDetails?.MpesaDepositRef),
                                ("Ordered", Model.CustomerDetails?.DateCreated.ToString("dd MMM yyyy")),
                            };
                        }
                        <div class="row g-2">
                            @foreach (var d in details)
                            {
                                <div class="col-sm-6 col-lg-12">
                                    <span class="sub-text">@d.Label</span>
                                    <span style="overflow-wrap:anywhere;">@(string.IsNullOrWhiteSpace(d.Value) ? "-" : d.Value)</span>
                                </div>
                            }
                        </div>
                        @if (Model.CustomerDetails == null)
                        {
                            <p class="text-soft small mt-2 mb-0">No online order found for this account, so contact details aren't on file.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-8 col-xxl-9">
                <div class="card card-bordered">
                    <div class="card-inner">

                        <div class="ss-section">
                            <h5 class="title">Contract</h5>
                            <div class="ss-grid">
                                <div class="ss-tile"><span class="lbl">Contract total</span><span class="val">@Ksh(contractTotal)</span><span class="sub">incl. deposit @Ksh(Model.Deposit)</span></div>
                                <div class="ss-tile"><span class="lbl">Paid so far</span><span class="val">@Ksh(Model.TotalPaid)</span></div>
                                <div class="ss-tile"><span class="lbl">Balance left</span><span class="val">@Ksh(Model.LoanBalance)</span></div>
                                <div class="ss-tile"><span class="lbl">Due by today</span><span class="val">@Ksh(Model.TotalDue)</span></div>
                                <div class="ss-tile">
                                    <span class="lbl">@(behind > 0 ? "Behind by" : "Ahead by")</span>
                                    <span class="val @(behind > 0 ? "text-danger" : "text-success")">@Ksh(behind > 0 ? behind : ahead)</span>
                                    <span class="sub">on the original contract</span>
                                </div>
                                <div class="ss-tile"><span class="lbl">Daily amount</span><span class="val">@Ksh(Model.Daily)</span></div>
                            </div>

                            <div class="mt-3">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>Paid @paidPercent% of the contract</span>
                                    <span class="text-soft">@Ksh(Model.TotalPaid) of @Ksh(contractTotal)</span>
                                </div>
                                <div class="progress progress-lg">
                                    <div class="progress-bar bg-success" style="width:@(paidPercent)%;"></div>
                                </div>
                            </div>
                        </div>

                        <div class="ss-section">
                            <h5 class="title">Payments</h5>
                            <div class="ss-grid">
                                <div class="ss-tile"><span class="lbl">First payment</span><span class="val">@Ksh(Model.FirstPaidAmt)</span><span class="sub">@(Model.FirstPaymentDate?.ToString("dd MMM yyyy") ?? "-")</span></div>
                                <div class="ss-tile"><span class="lbl">Last payment</span><span class="val">@Ksh(Model.LastPaidAmt)</span><span class="sub">@(Model.LastPaymentDate?.ToString("dd MMM yyyy") ?? "-")</span></div>
                                <div class="ss-tile"><span class="lbl">Paid in the last 24 hours</span><span class="val">@Ksh(Model.TotalLast24)</span></div>
                                <div class="ss-tile"><span class="lbl">Contract ends</span><span class="val">@(Model.ContractEndDate?.ToString("dd MMM yyyy") ?? "-")</span><span class="sub">@Math.Max(0, Math.Round(Model.NumberDaysLifeTime)) days left</span></div>
                            </div>
                        </div>

                        <div class="ss-section">
                            <h5 class="title">Phone</h5>
                            <div class="ss-grid">
                                <div class="ss-tile"><span class="lbl">Phone</span><span class="val">@Model.Make @Model.Model</span></div>
                                <div class="ss-tile"><span class="lbl">Lock service</span><span class="val">@service</span></div>
                                <div class="ss-tile"><span class="lbl">Lock status</span><span class="val @(locked ? "text-danger" : "text-success")">@(locked ? "Locked" : "Unlocked")</span></div>
                                <div class="ss-tile"><span class="lbl">Next lock</span><span class="val">@When(Model.NextLockDate)</span></div>
                                <div class="ss-tile"><span class="lbl">Enrolment</span><span class="val">@(string.IsNullOrWhiteSpace(Model.Status) ? "-" : char.ToUpperInvariant(Model.Status[0]) + Model.Status[1..])</span></div>
                            </div>
                        </div>

                        @if (plan != null)
                        {
                            <div class="ss-section">
                                <h5 class="title">Agreed restructure</h5>
                                <div class="ss-grid">
                                    <div class="ss-tile"><span class="lbl">Agreed from</span><span class="val">@plan.DateAgreed.ToString("dd MMM yyyy")</span><span class="sub">@plan.DaysRestructured days on the plan</span></div>
                                    <div class="ss-tile"><span class="lbl">Plan daily amount</span><span class="val">@Ksh(plan.AmountRes)</span></div>
                                    <div class="ss-tile"><span class="lbl">Due on the plan</span><span class="val">@Ksh(plan.TotalDueR)</span></div>
                                    <div class="ss-tile"><span class="lbl">Paid on the plan</span><span class="val">@Ksh(plan.TotalPaidR)</span></div>
                                    <div class="ss-tile">
                                        <span class="lbl">@(plan.ArrearsR < 0 ? "Behind on the plan" : "Ahead on the plan")</span>
                                        <span class="val @(plan.ArrearsR < 0 ? "text-danger" : "text-success")">@Ksh(Math.Abs(plan.ArrearsR))</span>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="ss-section" id="restructure-history">
                            <h5 class="title">Restructure history</h5>
                            @if (!history.Any())
                            {
                                <p class="text-soft mb-0">No restructures logged for this account. Logging started on 10 Nov 2026.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm ss-table mb-0">
                                        <thead>
                                            <tr><th>When</th><th>What</th><th>By</th><th>Daily amount</th><th>Plan from</th><th>Reason</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var h in history)
                                            {
                                                var badge = h.Kind switch
                                                {
                                                    Ranalo.DataStore.RestructureLogKind.Agreed => "bg-primary",
                                                    Ranalo.DataStore.RestructureLogKind.Changed => "bg-info",
                                                    Ranalo.DataStore.RestructureLogKind.SelfService => "bg-success",
                                                    Ranalo.DataStore.RestructureLogKind.Undone => "bg-danger",
                                                    _ => "bg-light text-dark",
                                                };
                                                <tr>
                                                    <td style="white-space:nowrap;">@h.AtUtc.AddHours(3).ToString("dd MMM yyyy")<span class="d-block small text-soft">@h.AtUtc.AddHours(3).ToString("HH:mm")</span></td>
                                                    <td><span class="badge @badge">@h.Kind</span></td>
                                                    <td>@h.Who</td>
                                                    <td style="white-space:nowrap;">
                                                        @if (h.PrevAmountRes.HasValue && h.AmountRes.HasValue)
                                                        {
                                                            <span>@Ksh(h.PrevAmountRes.Value) → @Ksh(h.AmountRes.Value)</span>
                                                        }
                                                        else if (h.AmountRes.HasValue)
                                                        {
                                                            <span>@Ksh(h.AmountRes.Value)</span>
                                                        }
                                                        else { <span>-</span> }
                                                    </td>
                                                    <td style="white-space:nowrap;">@(h.DateAgreed?.ToString("dd MMM yyyy") ?? "-")</td>
                                                    <td class="small" style="min-width:180px;">@(string.IsNullOrWhiteSpace(h.Note) ? "-" : h.Note)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" id="modalRestructure">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <a href="#" class="close" data-bs-dismiss="modal" aria-label="Close">
                <em class="icon ni ni-cross-sm"></em>
            </a>
            <div class="modal-body modal-body-md">
                <h5 class="modal-title">Restructure Payments</h5>
                <form action="/restructure-payment" method="post" class="mt-2">
                    <input type="hidden" name="accountNo" value="@Model.AccountNo" />
                    <div class="row g-gs">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="edit-income">New Rate</label>
                                <div class="form-control-wrap">
                                    @{
                                        // Approvers can't go below the daily payment (Services/RestructurePermissions.cs).
                                        var minimumRate = ViewBag.IsApprover is true
                                            ? Ranalo.Services.RestructurePermissions.MinimumRate(Ranalo.DataStore.DataModels.UserRole.Approver, Ranalo.Services.RestructureCalculator.DailyPaymentAll(Model.Daily, Model.Weekly, Model.Monthly))
                                            : null;
                                    }
                                    <input type="number" name="newRate" class="form-control" id="edit-income" step="0.01" min="@(minimumRate?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) ?? "0.01")" required />
                                    @if (minimumRate != null)
                                    {
                                        <div class="form-note">Lowest you can set: KES @minimumRate.Value.ToString("N2")</div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="edit-date">Date From</label>
                                <div class="form-control-wrap">
                                    <div class="form-icon form-icon-left">
                                        <em class="icon ni ni-calendar"></em>
                                    </div>
                                    <input type="text" name="dateFrom" id="edit-date" class="form-control date-picker" data-date-format="yyyy-mm-dd" required>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-group">
                                <label class="form-label" for="restructure-reason">Reason</label>
                                <div class="form-control-wrap">
                                    <textarea name="reason" id="restructure-reason" class="form-control" rows="2" minlength="5" maxlength="300" required placeholder="Why this plan, e.g. lost job, agreed Ksh 100 a day until March"></textarea>
                                </div>
                                <div class="form-note">Shown in the account's restructure history.</div>
                            </div>
                        </div>

                        <div class="col-12">
                            <ul class="align-center flex-wrap flex-sm-nowrap gx-4 gy-2">
                                <li>
                                    <button type="submit" class="btn btn-lg btn-primary">Submit</button>
                                </li>
                                <li>
                                    <a href="#" data-bs-dismiss="modal" class="link link-gray">Cancel</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div><!-- .Edit Modal-Content -->
