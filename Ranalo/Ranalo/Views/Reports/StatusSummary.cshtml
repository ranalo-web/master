@using Ranalo.Models
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model MobileStatusReport
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@functions{


    private string SetStatusBadge(string status)
    {
        var statusClass = "";
        switch (status)
        {
            case "checkin":
                statusClass = "tb-status text-warning";
                break;
            case "un_registered":
                statusClass = "tb-status text-danger";
                break;
            case "rejected":
                statusClass = "tb-status text-danger";
                break;
            case "enrolled":
                statusClass = "tb-status text-success";
                break;
            default:
                statusClass = "";
                break;
        }

        return statusClass;
    }

    private string SetLockStatusBadge(string status)
    {
        var statusClass = "";
        switch (status)
        {
            case "unlocked":
                statusClass = "tb-status text-warning";
                break;
            case "un_registered":
                statusClass = "tb-status text-danger";
                break;
            case "rejected":
                statusClass = "tb-status text-danger";
                break;
            case "complete":
                statusClass = "tb-status text-success";
                break;
            default:
                statusClass = "";
                break;
        }

        return statusClass;
    }
}

<div class="nk-content-body">
    <div class="nk-block-head">
        <div class="nk-block-head-sub"><span>Account @Model.AccountNo</span></div>
        <div class="nk-block-between-md g-4">
            <div class="nk-block-head-content">
                <h2 class="nk-block-title  page-title">@Model.FirstName</h2>
                <div class="nk-block-des">
                    <p>At a glance summary of your account. Have fun!</p>
                </div>
            </div>
            <div class="nk-block-head nk-block-head-sm nk-block-between">
                <div class="btn-group">
                    <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown"><span>Loan List</span> <em class="icon ni ni-chevron-down"></em></button>
                    <div class="dropdown-menu dropdown-menu-end">
                        <ul class="link-list-opt no-bdr">
                            <li><a href="#"><span>Home Loan (Pro)</span></a></li>
                            <li><a href="#"><span>Personal Loan (Standard)</span></a></li>
                            <li><a href="#"></em><span>SME Loan (Pro)</span></a></li>
                        </ul>
                    </div>
                </div>
            </div><!-- .nk-block-head -->
        </div>
    </div><!-- .nk-block-head -->
    <div class="nk-block">
        <div class="card card-bordered">
            <div class="card-aside-wrap">
                <div class="card-content">
                    <div class="card-inner">
                        <div class="nk-block">
                            <div class="nk-block-head nk-block-head-sm nk-block-between">
                                <h5 class="title">Finance Details</h5>
                            </div><!-- .nk-block-head -->
                            <div class="row gy-5">
                                <div class="col-md-3 col-lg-2 col-6">
                                    <div class="profile-stats">
                                        <span class="profile-ud-label">Loan Balance</span>
                                        <span> KES @Model.LoanBalance/- </span>
                                    </div>
                                </div>
                                <div class="col-md-3 col-lg-2 col-6">
                                    <div class="profile-stats">
                                        <span class="profile-ud-label">Deposit</span>
                                        <span> KES @Model.Deposit/- </span>
                                    </div>
                                </div>
                                <div class="col-md-3 col-lg-2  col-6">
                                    <div class="profile-stats">
                                        <span class="profile-ud-label">Total Loan</span>
                                        <span>@Model.TotalLoan</span>
                                    </div>
                                </div>
                                <div class="col-md-3 col-lg-2  col-6">
                                    <div class="profile-stats">
                                        <span class="profile-ud-label">Total Paid</span>
                                        <span>@Model.TotalPaid</span>
                                    </div>
                                </div>
                                <div class="col-md-3 col-lg-2  col-6">
                                    <div class="profile-stats">
                                        <span class="profile-ud-label">Total Due</span>
                                        <span>@Model.TotalDue</span>
                                    </div>
                                </div>
                                <div class="col-md-3 col-lg-2  col-6">
                                    <div class="profile-stats">
                                        <span class="profile-ud-label">Arrears</span>
                                        <span>@Model.Arrears</span>
                                    </div>
                                </div>
                            </div>
                        </div><!-- .nk-block -->
                        <div class="nk-divider divider md"></div>
                        <div class="nk-block">
                            <div class="nk-block-head nk-block-head-sm nk-block-between">
                                <h5 class="title">Payment History</h5>
                            </div><!-- .nk-block-head -->
                            <div class="row gy-5">
                                <div class="col-md-2 col-sm-4 col-6">
                                    <div class="profile-stats">
                                        <span class="profile-ud-label">First Paid</span>
                                        <span class="amount text-primary">@Model.FirstPaidAmt</span>
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-4 col-6">
                                    <div class="profile-stats">
                                        <span class="profile-ud-label">Last Paid</span>
                                        <span class="amount text-success">@Model.LastPaidAmt</span>
                                    </div>
                                </div>
                                <div class="col-md-3 col-lg-2  col-6">
                                    <div class="profile-stats">
                                        <span class="profile-ud-label">Daily</span>
                                        <span class="amount text-info">@Model.Daily</span>
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-4 col-12">
                                    <div class="profile-stats">
                                        <span class="profile-ud-label">Days Left</span>
                                        <span>@Math.Round(Model.NumberDaysLifeTime)</span>
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-4 col-6">
                                    <div class="profile-stats">
                                        <span class="profile-ud-label">First Date</span>
                                        <span>@Model.FirstPaymentDate?.ToString("dd MMM yyyy")</span>
                                    </div>
                                </div>
                                <div class="col-md-2 col-sm-4 col-6">
                                    <div class="profile-stats">
                                        <span class="profile-ud-label">Last Date</span>
                                        <span>@Model.LastPaymentDate?.ToString("dd MMM yyyy")</span>
                                    </div>
                                </div>
                            </div>
                        </div><!-- .nk-block -->
                        <div class="nk-block">
                            <div class="nk-block-head nk-block-head-sm nk-block-between">
                                <h5 class="title">Device Details</h5>
                            </div><!-- .nk-block-head -->
                            <div class="row gy-5">
                                <div class="col-md-3 col-lg-2 col-6">
                                    <div class="profile-stats">
                                        <span class="profile-ud-label">Make</span>
                                        <span> KES @Model.Make </span>
                                    </div>
                                </div>
                                <div class="col-md-3 col-lg-2 col-6">
                                    <div class="profile-stats">
                                        <span class="profile-ud-label">Model</span>
                                        <span> KES @Model.Model </span>
                                    </div>
                                </div>
                                <div class="col-md-3 col-lg-2  col-6">
                                    <div class="profile-stats">
                                        <span class="profile-ud-label">Lock Status</span>
                                        <span class="@SetLockStatusBadge(Model.LockType)">@Model.LockType</span>
                                    </div>
                                </div>
                                <div class="col-md-3 col-lg-2  col-6">
                                    <div class="profile-stats">
                                        <span class="profile-ud-label">Next Lock</span>
                                        <span>@Model.NextLockDate</span>
                                    </div>
                                </div>
                                <div class="col-md-3 col-lg-2  col-6">
                                    <div class="profile-stats">
                                        <span class="profile-ud-label">Enroll Status</span>
                                        <span class="@SetStatusBadge(Model.Status)">@Model.Status</span>
                                    </div>
                                </div>
                                <div class="col-md-3 col-lg-2  col-6">
                                    <div class="profile-stats">
                                        <span class="profile-ud-label">Locked</span>
                                        <span>@(Model.Locked ? "True" : "False") </span>
                                    </div>
                                </div>
                            </div>
                        </div><!-- .nk-block -->
                        <div class="nk-divider divider md"></div>
                        <div class="nk-block">
                            <div class="nk-block-head nk-block-head-sm nk-block-between">
                                <h5 class="title">Loan Status</h5>
                            </div><!-- .nk-block-head -->
                            <div class="row gy-5">
                                <div class="col-12 col-md-10 col-lg-8">
                                    <div class="profile-stats">
                                        <div class="progress progress-lg">
                                            @{
                                                int percentagePaid = 0;
                                                DateTime today = DateTime.Today;

                                                if (today <= Model.FirstPaymentDate)
                                                {
                                                    percentagePaid = 0;
                                                }
                                                else if (Model.NumberDaysLifeTime <= 0)
                                                {
                                                    percentagePaid = 100;
                                                }
                                                else
                                                {
                                                    double totalDays = Model.NumberDaysLifeTime;
                                                    double elapsedDays = (today - Model?.FirstPaymentDate).Value.TotalDays;
                                                    percentagePaid = (int)Math.Round((elapsedDays / totalDays) * 100);

                                                }
                                                <div class="progress-bar progress-bar-striped bg-success" data-progress="@percentagePaid" style="width: @percentagePaid %;">@percentagePaid %</div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div><!-- .nk-block -->
                        <div class="nk-divider divider md"></div>
                        <div class="nk-block">
                            <div class="nk-block-head nk-block-head-sm">
                                <button type="button" data-bs-toggle="modal" data-bs-target="#modalRestructure" class="link link-primary ms-auto">Restructure</button>
                            </div><!-- .nk-block-head -->
                        </div>
                        <div class="nk-divider divider md"></div>
                        @if(Model.RestructuredRecords.Any())
                        {
                                <div class="nk-block">
                                <div class="nk-block-head nk-block-head-sm">
                                        <div class="col-xxl-8">
                    <div class="card card-bordered card-full">
                        <div class="card-inner">
                            <div class="card-title-group">
                                <div class="card-title">
                                    <h6 class="title"><span class="me-2">Transaction</span> <a href="#" class="link d-none d-sm-inline">See History</a></h6>
                                </div>
                                <div class="card-tools">
                                    <ul class="card-tools-nav">
                                        <li><a href="#"><span>Paid</span></a></li>
                                        <li><a href="#"><span>Pending</span></a></li>
                                        <li class="active"><a href="#"><span>All</span></a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="card-inner p-0 border-top">
                            <div class="nk-tb-list nk-tb-orders">
                                <div class="nk-tb-item nk-tb-head">

                                    <div class="nk-tb-col"><span>Account No</span></div>
                                    @* <div class="nk-tb-col tb-col-sm"><span>Customer</span></div> *@
                                    <div class="nk-tb-col tb-col-md"><span>Date Agreed</span></div>
                                    <div class="nk-tb-col tb-col-lg"><span>Day Res</span></div>
                                    <div class="nk-tb-col"><span>Amount Res</span></div>
                                        <div class="nk-tb-col"><span>Due</span></div>
                                            <div class="nk-tb-col"><span>Paid</span></div>
                                            <div class="nk-tb-col"><span>Arrears</span></div>
                                                <div class="nk-tb-col"><span>Auto Lock</span></div>
                                    <div class="nk-tb-col"><span>&nbsp;</span></div>
                                </div>
                                                   
                                @foreach (var record in Model.RestructuredRecords)
                                {
                                    <div class="nk-tb-item">
                                        <div class="nk-tb-col">
                                            <span class="tb-lead"><a href="#">#@record.AccountNo</a></span>
                                        </div>
                                        @* <div class="nk-tb-col tb-col-sm">
                                            <div class="user-card">
                                                <div class="user-avatar user-avatar-sm bg-purple">
                                                    <span>@GetInitials(record.FirstName + " " + record.LastName)</span>
                                                </div>
                                                <div class="user-name">
                                                    <span class="tb-lead">@(record.FirstName + " " + record.LastName)</span>
                                                </div>
                                            </div>
                                        </div> *@
                                        <div class="nk-tb-col tb-col-md">
                                            <span class="tb-sub">@record.DateAgreed.ToString("dd/MM/yyyy")</span>
                                        </div>
                                        <div class="nk-tb-col tb-col-lg">
                                            <span class="tb-sub text-primary">@record.DaysRestructured</span>
                                        </div>
                                        <div class="nk-tb-col">
                                                    <span class="tb-sub tb-amount">@record.AmountRes.ToString("N2") <span>KES</span></span>
                                        </div>
                                                        <div class="nk-tb-col">
                                                            <span class="tb-sub tb-amount">@record.TotalDueR</span>
                                        </div>
                                                <div class="nk-tb-col">
                                                                    <span class="tb-sub tb-amount">@record.TotalPaidR</span>
                                                </div>
                                                        <div class="nk-tb-col">
                                                                            <span class="tb-sub tb-amount">@record.ArrearsR</span>
                                                        </div>
                                                                <div class="nk-tb-col">
                                                                                    <span class="tb-sub tb-amount">@record.AutoLockDatePmtR</span>
                                                                </div>
                                        <div class="nk-tb-col nk-tb-col-action">
                                            <div class="dropdown">
                                                <a class="text-soft dropdown-toggle btn btn-icon btn-trigger" data-bs-toggle="dropdown"><em class="icon ni ni-more-h"></em></a>
                                                <div class="dropdown-menu dropdown-menu-end dropdown-menu-xs">
                                                    <ul class="link-list-plain">
                                                        <li><a href="#">View</a></li>
                                                        <li><a href="#">Invoice</a></li>
                                                        <li><a href="#">Print</a></li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                                        }

                            </div>
                        </div>
                        <div class="card-inner-sm border-top text-center d-sm-none">
                            <a href="#" class="btn btn-link btn-block">See History</a>
                        </div>
                    </div><!-- .card -->
                </div><!-- .col -->
                                </div><!-- .nk-block-head -->
                            </div>
                            <div class="nk-divider divider md"></div>
                        }


                        <div class="nk-block">
                            <div class="nk-block-head nk-block-head-sm nk-block-between">
                                <h5 class="title"><code>Notice</code></h5>
                            </div><!-- .nk-block-head -->
                            <div class="row gy-5">
                                <div class="col-12">
                                    <dt>If you pay your EMI late, you may attract additional charges from your lender. If you make a payment towards your EMI which is after your due date but within your lender's grace period, there is usually an added 'late fee' that you will have to pay alongside your EMI amount.</dt>
                                </div>
                            </div>
                        </div><!-- .nk-block -->
                    </div><!-- .card-inner -->
                </div><!-- .card-content -->
            </div><!-- .card-aside-wrap -->
        </div><!-- .card -->
    </div><!-- .nk-block -->
</div>

<div class="modal fade" tabindex="-1" id="modalRestructure">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <a href="#" class="close" data-bs-dismiss="modal" aria-label="Close">
                <em class="icon ni ni-cross-sm"></em>
            </a>
            <div class="modal-body modal-body-md">
                <h5 class="modal-title">Restructure Payments</h5>
                <form action="/restructure-payment" method="post" class="mt-2">
                    <input type="hidden" name="accountNo" value="@Model.AccountNo" />
                    <div class="row g-gs">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="edit-income">New Rate</label>
                                <div class="form-control-wrap">
                                    <input type="number" name="newRate" class="form-control" id="edit-income" required />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="edit-date">Date From</label>
                                <div class="form-control-wrap">
                                    <div class="form-icon form-icon-left">
                                        <em class="icon ni ni-calendar"></em>
                                    </div>
                                    <input type="text" name="dateFrom" id="edit-date" class="form-control date-picker" data-date-format="yyyy-mm-dd" required>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <ul class="align-center flex-wrap flex-sm-nowrap gx-4 gy-2">
                                <li>
                                    <button type="submit" class="btn btn-lg btn-primary">Submit</button>
                                </li>
                                <li>
                                    <a href="#" data-bs-dismiss="modal" class="link link-gray">Cancel</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div><!-- .Edit Modal-Content -->
