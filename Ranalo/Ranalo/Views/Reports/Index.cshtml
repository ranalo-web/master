@using Ranalo.Models
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model StatusReportViewModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@functions
{
    private string SetStatusBadge(int notPaid)
    {
        var statusClass = "";

        if(notPaid == 1)
        {
            return "badge badge-dim bg-danger";
        }else
        {
            return "badge badge-dim bg-success";
        }

        return statusClass;
    }

    private string SetLockStatusBadge(bool status)
    {
        var statusClass = "";

        if(status)
        {
            return "badge badge-dim bg-danger";
        }else
        {
            return "badge badge-dim bg-success";
        }

        return statusClass;
    }

    private string SetLockStatusTextBadge(bool status)
    {
        if (status)
        {
            return "LOCKED";
        }
        else
        {
            return "UNLOCKED";
        }
    }

    private string SetSearchTerm()
    {
        if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            return Model.SearchTerm;
        }

        return "Search...";
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "string.Empty";

        // Split by spaces and take first character of each word
        var initials = fullName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(word => char.ToUpper(word[0]))
            .Take(2) // only take first 2 initials
            .ToArray();

        return new string(initials);
    }

    private string ConvertIsoDate(string dateString)
    {
        var output = DateTime.TryParseExact(
        dateString,
        "dd/MM/yyyy'T'HH:mm:ss",
        System.Globalization.CultureInfo.InvariantCulture,
        System.Globalization.DateTimeStyles.None,
        out DateTime dt);

        return dt.ToString("dd MMM yyyy HH:mm");
    }

    private string ConvertUTCDate(string dateString)
    {
        if (string.IsNullOrEmpty(dateString))
        {
            return "Not set";
        }
        DateTime dt = DateTime.ParseExact(
            dateString,
            "dd-MM-yy HH:mm:ss 'UTC'",
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.AssumeUniversal | System.Globalization.DateTimeStyles.AdjustToUniversal
        );

        return dt.ToString("dd MMM yyyy HH:mm");
    }
}

<link rel="stylesheet" href="~/css/watchlist-table.css?v=4">

<div class="nk-content-body">

    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between">
            <div class="nk-block-head-content">
                <h3 class="nk-block-title page-title">Status Report Summary</h3>
                <div class="nk-block-des text-soft">
                    <p>Status reports for each account</p>
                </div>
            </div><!-- .nk-block-head-content -->
            <div class="nk-block-head-content">
                <div class="toggle-wrap nk-block-tools-toggle">
                    <a href="#" class="btn btn-icon btn-trigger toggle-expand me-n1" data-target="pageMenu"><em class="icon ni ni-menu-alt-r"></em></a>
                    <div class="toggle-expand-content" data-content="pageMenu">
                        <ul class="nk-block-tools g-3">
                        </ul>
                    </div>
                </div><!-- .toggle-wrap -->
            </div><!-- .nk-block-head-content -->
        </div><!-- .nk-block-between -->
    </div><!-- .nk-block-head -->
    <div class="nk-block">
        <div class="card card-bordered card-stretch">
            <div class="card-inner-group">
                <div class="card-inner position-relative card-tools-toggle">
                    <div class="card-title-group">
                        <div class="card-tools me-n1">
                            <ul class="btn-toolbar gx-1">
                                <li>
                                    <a href="#" class="btn btn-icon search-toggle toggle-search" data-target="search"><em class="icon ni ni-search"></em></a>
                                </li><!-- li -->
                                <li class="btn-toolbar-sep"></li><!-- li -->
                                <li>
                                    <div class="toggle-wrap">
                                        <a href="#" class="btn btn-icon btn-trigger toggle" data-target="cardTools"><em class="icon ni ni-menu-right"></em></a>
                                        <div class="toggle-content" data-content="cardTools">
                                            <ul class="btn-toolbar gx-1">
                                                <li class="toggle-close">
                                                    <a href="#" class="btn btn-icon btn-trigger toggle" data-target="cardTools"><em class="icon ni ni-arrow-left"></em></a>
                                                </li><!-- li -->
                                                <li>
                                                    <div class="dropdown">
                                                        <a href="#" class="btn btn-trigger btn-icon dropdown-toggle" data-bs-toggle="dropdown">
                                                            <em class="icon ni ni-setting"></em>
                                                        </a>
                                                        <div class="dropdown-menu dropdown-menu-xs dropdown-menu-end">
                                                            <ul class="link-check">
                                                                <li><span>Show</span></li>
                                                                <li class="@(ViewBag.PageSize == 10 ? "active" : "")"><a href="/statusreport?page=1&amp;pageSize=10&amp;searchTerm=@ViewBag.SearchTerm">10</a></li>
                                                                <li class="@(ViewBag.PageSize == 20 ? "active" : "")"><a href="/statusreport?page=1&amp;pageSize=20&amp;searchTerm=@ViewBag.SearchTerm">20</a></li>
                                                                <li class="@(ViewBag.PageSize == 50 ? "active" : "")"><a href="/statusreport?page=1&amp;pageSize=50&amp;searchTerm=@ViewBag.SearchTerm">50</a></li>
                                                            </ul>
                                                        </div>
                                                    </div><!-- .dropdown -->
                                                </li><!-- li -->
                                            </ul><!-- .btn-toolbar -->
                                        </div><!-- .toggle-content -->
                                    </div><!-- .toggle-wrap -->
                                </li><!-- li -->
                            </ul><!-- .btn-toolbar -->
                        </div><!-- .card-tools -->
                    </div><!-- .card-title-group -->
                    <div class="card-search search-wrap" data-search="search">
                        <div class="card-body">
                            <div class="search-content">
                                <a href="#" class="search-back btn btn-icon toggle-search" data-target="search"><em class="icon ni ni-arrow-left"></em></a>
                                <form action="/statusreport" method="get">
                                    <input type="text" name="searchTerm" class="form-control border-transparent form-focus-none" placeholder="Search by borrower or category">
                                <button class="search-submit btn btn-icon"><em class="icon ni ni-search"></em></button>
                                </form>
                            </div>
                        </div>
                    </div><!-- .card-search -->
                </div><!-- .card-inner -->
                <div class="card-inner p-0">
                    <div class="table-responsive">
                    <table class="table mb-0" style="white-space:nowrap;" data-key="status-report-summary" data-page-size="10">
                        <thead>
                            <tr>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Customer</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Connected</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Next Lock</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Daily Rate</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Total Paid</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Total Due</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Arrears</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Balance</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Status</th>
                                <th class="wl-th"></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var report in Model.StatusReports)
                        {
                            <tr>
                                <td>
                                    <a href="/account-details/@report.AccountNo" class="fw-medium">@report.FirstName</a>
                                    <span class="d-block sub-text">AC: @report.AccountNo</span>
                                </td>
                                <td>@ConvertUTCDate(report.LastConnectedAt)</td>
                                <td>@ConvertIsoDate(report.NextLockDate)</td>
                                <td>@report.Daily</td>
                                <td>@report.TotalPaid</td>
                                <td>@report.TotalDue</td>
                                <td>@report.Arrears</td>
                                <td>@report.LoanBalance</td>
                                <td><span class="@SetLockStatusBadge(report.Locked)">@SetLockStatusTextBadge(report.Locked)</span></td>
                                <td class="text-end">
                                    <ul class="nk-tb-actions gx-2 justify-content-end">
                                        <li class="nk-tb-action-hidden">
                                            <a href="/account-details/@report.AccountNo" class="btn btn-sm btn-icon btn-trigger" data-bs-toggle="tooltip" data-bs-placement="top" title="Disbursed Loan">
                                                <em class="icon ni ni-user-check-fill"></em>
                                            </a>
                                        </li>
                                        <li>
                                            <div class="drodown">
                                                <a href="#" class="btn btn-sm btn-icon btn-trigger dropdown-toggle" data-bs-toggle="dropdown"><em class="icon ni ni-more-h"></em></a>
                                                <div class="dropdown-menu dropdown-menu-end">
                                                    <ul class="link-list-opt no-bdr">
                                                        <li><a href="/account-details/@report.AccountNo"><em class="icon ni ni-eye"></em><span>View Details</span></a></li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </li>
                                    </ul>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div><!-- responsive table -->
                </div><!-- .card-inner -->
                <div class="card-inner">
                    <div class="nk-block-between-md g-3">
                        <div class="g">
                            <ul class="pagination justify-content-center justify-content-md-start">
                                @{
                                    string StatusReportPageLink(int p) => Url.Action("Index", "Reports", new { page = p, pageSize = ViewBag.PageSize, searchTerm = ViewBag.SearchTerm })!;
                                }
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@StatusReportPageLink(Model.CurrentPage - 1)">Prev</a>
                                    </li>
                                }

                                @{
                                    var maxVisiblePages = 5;
                                    var startPage = Math.Max(1, Model.CurrentPage - 2);
                                    var endPage = Math.Min(Model.TotalPages, startPage + maxVisiblePages - 1);
                                    if (endPage - startPage < maxVisiblePages - 1)
                                    {
                                        startPage = Math.Max(1, endPage - maxVisiblePages + 1);
                                    }
                                }

                                @if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@StatusReportPageLink(1)">1</a>
                                    </li>
                                    <li class="page-item">
                                        <span class="page-link"><em class="icon ni ni-more-h"></em></span>
                                    </li>
                                }

                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@StatusReportPageLink(i)">@i</a>
                                    </li>
                                }

                                @if (endPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <span class="page-link"><em class="icon ni ni-more-h"></em></span>
                                    </li>
                                    <li class="page-item">
                                        <a class="page-link" href="@StatusReportPageLink(Model.TotalPages)">@Model.TotalPages</a>
                                    </li>
                                }

                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@StatusReportPageLink(Model.CurrentPage + 1)">Next</a>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="g">
                            <div class="pagination-goto d-flex justify-content-center justify-content-md-start gx-3">
                                <div>Page</div>
                                <div>
                                    <select class="form-select js-select2"
                                            data-search="on"
                                            data-dropdown="xs center"
                                            onchange="location.href='/statusreport?page=' + this.value + '&pageSize=@ViewBag.PageSize&searchTerm=@ViewBag.SearchTerm'">
                                        >
                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            <option value="@i" @(Model.CurrentPage == i ? "selected" : "")>
                                                @i
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div>OF @Model.TotalPages</div>
                            </div>
                        </div><!-- .pagination-goto -->
                    </div><!-- .nk-block-between --><!-- .pagination -->
                </div><!-- .card-inner -->
            </div><!-- .card-inner-group -->
        </div><!-- .card -->
    </div><!-- .nk-block -->
</div>

@section Scripts
{
    <script src="~/js/watchlist-table.js"></script>
}
