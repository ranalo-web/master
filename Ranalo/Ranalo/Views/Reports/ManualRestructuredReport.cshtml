@using Ranalo.Models
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model RestructuredViewModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@functions
{
    private string ConvertUTCDate(string dateString)
    {
        if (string.IsNullOrEmpty(dateString)) return DateTime.MinValue.ToString("dd MMM yyyy HH:mm"); ;
        DateTime dt = DateTime.ParseExact(
            dateString,
            "dd-MM-yy HH:mm:ss 'UTC'",
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.AssumeUniversal | System.Globalization.DateTimeStyles.AdjustToUniversal
        );

        return dt.ToString("dd MMM yyyy HH:mm");
    }
    private string SetStatusBadge(decimal notPaid)
    {
        var statusClass = "";

        if (notPaid < 0)
        {
            return "badge badge-dim bg-danger";
        }
        else
        {
            return "badge badge-dim bg-success";
        }

        return statusClass;
    }

    private string SetSearchTerm()
    {
        if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            return Model.SearchTerm;
        }

        return "Search...";
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "string.Empty";

        // Split by spaces and take first character of each word
        var initials = fullName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(word => char.ToUpper(word[0]))
            .Take(2) // only take first 2 initials
            .ToArray();

        return new string(initials);
    }


}

<div class="nk-content-body">

    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between">
            <div class="nk-block-head-content">
                <h3 class="nk-block-title page-title">Manual Restructured Report</h3>
                <div class="nk-block-des text-soft">
