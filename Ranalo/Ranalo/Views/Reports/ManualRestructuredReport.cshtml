                                </li><!-- li -->
                                <li class="btn-toolbar-sep"></li><!-- li -->
                                <li>
                                    <div class="toggle-wrap">
                                        <a href="#" class="btn btn-icon btn-trigger toggle" data-target="cardTools"><em class="icon ni ni-menu-right"></em></a>
                                        <div class="toggle-content" data-content="cardTools">
                                            <ul class="btn-toolbar gx-1">
                                                <li class="toggle-close">
                                                    <a href="#" class="btn btn-icon btn-trigger toggle" data-target="cardTools"><em class="icon ni ni-arrow-left"></em></a>
                                                </li><!-- li -->
                                                <li>
                                                    <div class="dropdown">
                                                        <a href="#" class="btn btn-trigger btn-icon dropdown-toggle" data-bs-toggle="dropdown">
                                                            <em class="icon ni ni-setting"></em>
                                                        </a>
                                                        <div class="dropdown-menu dropdown-menu-xs dropdown-menu-end">
                                                            <ul class="link-check">
                                                                <li><span>Show</span></li>
                                                                <li class="active"><a href="#">10</a></li>
                                                                <li><a href="#">20</a></li>
                                                                <li><a href="#">50</a></li>
                                                            </ul>
                                                            <ul class="link-check">
                                                                <li><span>Order</span></li>
                                                                <li class="active"><a href="#">DESC</a></li>
                                                                <li><a href="#">ASC</a></li>
                                                            </ul>
                                                        </div>
                                                    </div><!-- .dropdown -->
                                                </li><!-- li -->
                                            </ul><!-- .btn-toolbar -->
                                        </div><!-- .toggle-content -->
                                    </div><!-- .toggle-wrap -->
                                </li><!-- li -->
                            </ul><!-- .btn-toolbar -->
                        </div><!-- .card-tools -->
                    </div><!-- .card-title-group -->
                    <div class="card-search search-wrap" data-search="search">
                        <div class="card-body">
                            <div class="search-content">
                                <form action="/manual-restructured" method="get">
                                    <a href="#" class="search-back btn btn-icon toggle-search" data-target="search"><em class="icon ni ni-arrow-left"></em></a>
                                    <input type="text" name="searchTerm" class="form-control border-transparent form-focus-none" placeholder="Search by customer details">
                                    <button class="search-submit btn btn-icon"><em class="icon ni ni-search"></em></button>
                                </form>
                            </div>
                        </div>
                    </div><!-- .card-search -->
                </div><!-- .card-inner -->
                <div class="card-inner p-0">
                    <div class="table-responsive">
                    <div class="nk-tb-list nk-tb-ulist">
                        <div class="nk-tb-item nk-tb-head">
                            <div class="nk-tb-col nk-tb-col-check">
                                <div class="custom-control custom-control-sm custom-checkbox notext">
                                    <input type="checkbox" class="custom-control-input" id="uid">
                                    <label class="custom-control-label" for="uid"></label>
                                </div>
                            </div>
                            <div class="nk-tb-col"><span class="sub-text">Account No</span></div>
                                <div class="nk-tb-col"><span class="sub-text">Daily</span></div>
                                <div class="nk-tb-col"><span class="sub-text">Date Agreed</span></div>
                            <div class="nk-tb-col"><span class="sub-text">Amount R</span></div>
                                <div class="nk-tb-col"><span class="sub-text">Auto Lock</span></div>
                                <div class="nk-tb-col"><span class="sub-text">Last Conn</span></div>
                            <div class="nk-tb-col"><span class="sub-text">Days R</span></div>
                            <div class="nk-tb-col"><span class="sub-text">Total Due R</span></div>
                            <div class="nk-tb-col"><span class="sub-text">Total Paid R</span></div>
                            <div class="nk-tb-col"><span class="sub-text">Arrears R</span></div>
                                <div class="nk-tb-col"><span class="sub-text">Last Paid Date</span></div>
                                <div class="nk-tb-col"><span class="sub-text">Last Paid Amnt</span></div>
                            <div class="nk-tb-col nk-tb-col-tools text-end"></div>
                        </div><!-- .nk-tb-item -->
                        @foreach (var report in Model.Records)
                        {
                            <div class="nk-tb-item">
                                <div class="nk-tb-col nk-tb-col-check">
                                    <div class="custom-control custom-control-sm custom-checkbox notext">
                                        <input type="checkbox" class="custom-control-input" id="uid1">
                                        <label class="custom-control-label" for="uid1"></label>
                                    </div>
                                </div>
                                <div class="nk-tb-col">
                                    <a href="/account-details/@report.AccountNo">
                                        <div class="user-card">
                                            <div class="user-avatar bg-primary">
                                                <span>AB</span>
                                            </div>
                                            <div class="user-info">
                                                <span class="tb-lead">@report.AccountNo</span>
                                                <span>#: @report.AccountNo</span>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                                    <div class="nk-tb-col">
                                        <span>@report.Daily</span>
                                    </div>
                                <div class="nk-tb-col">
                                    <span>@report.DateAgreed.ToString("dd MMM yyyy HH:mm")</span>
                                </div>
                                <div class="nk-tb-col">
                                    <span>@report.AmountRes</span>
                                </div>
                                    <div class="nk-tb-col">
                                        <span>@report.AutoLockDatePmtR.ToString("dd MMM yyyy HH:mm")</span>
                                    </div>
                                    <div class="nk-tb-col">
                                        <span>@ConvertUTCDate(report.LastConnectedAt)</span>
                                    </div>
                                <div class="nk-tb-col">
                                    <span>@report.DaysRestructured</span>
                                </div>
                                <div class="nk-tb-col">
                                    <span>@report.TotalDueR</span>
                                </div>
                                <div class="nk-tb-col">
                                    <span>@report.TotalPaidR</span>
                                </div>
                                <div class="nk-tb-col">
                                        <span class="@SetStatusBadge(report.ArrearsR)">@report.ArrearsR</span>
                                </div>
                                    <div class="nk-tb-col">
                                        <span>@report.LastResPaymentDate</span>
                                    </div>
                                    <div class="nk-tb-col">
                                        <span>@report.LastPaidAmount</span>
                                    </div>
                                <div class="nk-tb-col nk-tb-col-tools">
                                    <ul class="nk-tb-actions gx-2">
                                        <li>
                                            <a href="/account-details/@report.AccountNo" class="btn btn-sm btn-icon btn-trigger" data-bs-toggle="tooltip" data-bs-placement="top" title="View Details">
                                                <em class="icon ni ni-eye"></em>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        }
                        </div>
                    </div>
                </div><!-- .card-inner -->
                <div class="card-inner">
                    <div class="nk-block-between-md g-3">
                        <div class="g">
                            <ul class="pagination justify-content-center justify-content-md-start">
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/manual-restructured?page=@(Model.CurrentPage - 1)">Prev</a>
                                    </li>
                                }

                                @{
                                    var maxVisiblePages = 5;
                                    var startPage = Math.Max(1, Model.CurrentPage - 2);
                                    var endPage = Math.Min(Model.TotalPages, startPage + maxVisiblePages - 1);
                                    if (endPage - startPage < maxVisiblePages - 1)
                                    {
                                        startPage = Math.Max(1, endPage - maxVisiblePages + 1);
                                    }
                                }

                                @if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/manual-restructured?page=1">1</a>
                                    </li>
                                    <li class="page-item">
                                        <span class="page-link"><em class="icon ni ni-more-h"></em></span>
                                    </li>
                                }

                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="/manual-restructured?page=@i">@i</a>
                                    </li>
                                }

                                @if (endPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <span class="page-link"><em class="icon ni ni-more-h"></em></span>
                                    </li>
                                    <li class="page-item">
                                        <a class="page-link" href="/manual-restructured?page=@Model.TotalPages">@Model.TotalPages</a>
                                    </li>
                                }

                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/manual-restructured?page=@(Model.CurrentPage + 1)">Next</a>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="g">
                            <div class="pagination-goto d-flex justify-content-center justify-content-md-start gx-3">
                                <div>Page</div>
                                <div>
                                    <select class="form-select js-select2" data-search="on" data-dropdown="xs center">
                                        <option value="page-1">1</option>
                                        <option value="page-2">2</option>
                                        <option value="page-4">4</option>
                                        <option value="page-5">5</option>
                                        <option value="page-6">6</option>
                                        <option value="page-7">7</option>
                                        <option value="page-8">8</option>
                                        <option value="page-9">9</option>
                                        <option value="page-10">10</option>
                                        <option value="page-11">11</option>
                                        <option value="page-12">12</option>
                                        <option value="page-13">13</option>
                                        <option value="page-14">14</option>
                                        <option value="page-15">15</option>
                                        <option value="page-16">16</option>
                                        <option value="page-17">17</option>
                                        <option value="page-18">18</option>
                                        <option value="page-19">19</option>
                                        <option value="page-20">20</option>
                                    </select>
                                </div>
                                <div>OF 102</div>
                            </div>
                        </div><!-- .pagination-goto -->
                    </div><!-- .nk-block-between --><!-- .pagination -->
                </div><!-- .card-inner -->
            </div><!-- .card-inner-group -->
        </div><!-- .card -->
    </div><!-- .nk-block -->
</div>

@if (ViewBag.IsAdmin is true)
{
<div class="modal fade" tabindex="-1" id="modalRestructure">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <a href="#" class="close" data-bs-dismiss="modal" aria-label="Close">
                <em class="icon ni ni-cross-sm"></em>
            </a>
            <div class="modal-body modal-body-md">
                <h5 class="modal-title">Restructure Payments</h5>
                <form action="/restructure-payment" method="post" class="mt-2">
                    <div class="row g-gs">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="form-label" for="edit-income">Account Number</label>
                            <div class="form-control-wrap">
                                    <input type="number" name="accountNo" class="form-control" id="edit-income" required />
                            </div>
                            </div>
                        </div>
                    </div>
                    <div class="row g-gs">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="edit-income">New Rate</label>
                                <div class="form-control-wrap">
                                    <input type="number" name="newRate" class="form-control" id="edit-income" required />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="edit-date">Date From</label>
                                <div class="form-control-wrap">
                                    <div class="form-icon form-icon-left">
                                        <em class="icon ni ni-calendar"></em>
                                    </div>
                                    <input type="text" name="dateFrom" id="edit-date" class="form-control date-picker" data-date-format="yyyy-mm-dd" required>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <ul class="align-center flex-wrap flex-sm-nowrap gx-4 gy-2">
                                <li>
                                    <button type="submit" class="btn btn-lg btn-primary">Submit</button>
                                </li>
                                <li>
                                    <a href="#" data-bs-dismiss="modal" class="link link-gray">Cancel</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
}