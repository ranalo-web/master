                                borderColor: '#9cabff',
                                backgroundColor: 'transparent',
                                borderDash: [4, 4],
                                fill: false,
                                tension: 0.35,
                                borderWidth: 2,
                                pointRadius: 3,
                                pointBackgroundColor: '#9cabff',
                                pointBorderColor: '#fff',
                                pointBorderWidth: 1.5,
                                pointHoverRadius: 5
                            }
                        ]
                    },
                    options: {
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                            legend: {
                                display: true,
                                position: 'bottom',
                                labels: { boxWidth: 10, usePointStyle: true, color: '#8091a7', font: { size: 11 } }
                            },
                            tooltip: {
