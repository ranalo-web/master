@model Ranalo.Models.AdminDashboardViewModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";

    var cur = Model.Profit;
    var prior = Model.PriorProfit;
    var netChange = Ranalo.Services.AdminDashboardRules.ChangePct(cur.NetProfit, prior.NetProfit);
    var netUp = cur.NetProfit >= prior.NetProfit;

    string Kes(decimal v) => (v < 0 ? "-" : "") + "KES " + Math.Abs(v).ToString("N0");
    string ChangeText(decimal current, decimal before)
    {
        var pct = Ranalo.Services.AdminDashboardRules.ChangePct(current, before);
        return pct.HasValue ? (pct >= 0 ? "+" : "") + pct.Value.ToString("0") + "%" : "-";
    }

    // Month only: where the month lands at the current pace.
    var paceRevenue = Model.MonthDaysElapsed > 0 ? cur.Revenue / Model.MonthDaysElapsed * Model.MonthDays : 0;

    var periods = new[] { ("week", "7 days"), ("month", "Month"), ("ytd", "Year to date"), ("year", "12 months") };

    var portfolioTotal = Model.PortfolioGoodCount + Model.PortfolioRestructuredCount + Model.PortfolioSlowCount + Model.PortfolioArrearsCount + Model.PortfolioBadCount;
    decimal PortfolioPct(int n) => portfolioTotal > 0 ? Math.Round(100m * n / portfolioTotal, 1) : 0;
    var newChange = ChangeText(Model.NewInPeriod, Model.NewPriorPeriod);
    var arrearsPctOfBook = Model.LoanBookOutstanding > 0 ? Math.Round(Model.ArrearsTotal / Model.LoanBookOutstanding * 100, 1) : 0;
    var commissionsPaid = cur.Commissions;
}

<link rel="stylesheet" href="~/css/watchlist-table.css?v=2">

<div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between flex-wrap g-2">
            <div class="nk-block-head-content">
                <h3 class="nk-block-title page-title">Admin Dashboard</h3>
                <div class="nk-block-des text-soft">
                    <p>Welcome back, @ViewBag.UserName &mdash; are we making money, and what to do next. Figures are for @Model.PeriodLabel, compared with @Model.PriorLabel.</p>
                </div>
            </div>
            <div class="nk-block-head-content">
                <div class="btn-group flex-wrap" role="group" aria-label="Period">
                    @foreach (var (key, label) in periods)
                    {
                        <a href="/admin-dashboard?period=@key" class="btn btn-sm @(Model.Period == key ? "btn-primary" : "btn-outline-light btn-white")">@label</a>
                    }
                </div>
            </div>
        </div>
    </div><!-- .nk-block-head -->

    <div class="nk-block">
        <div class="row g-gs">
            <div class="col-12 col-lg-5">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <div class="card-title-group align-start mb-2">
                            <div class="card-title">
                                <h6 class="title">Are we making money?</h6>
                                <p class="text-soft mb-0">Net profit after tax, @Model.PeriodLabel</p>
                            </div>
                            <div class="card-tools"><a href="/financials" class="link link-primary small">Financials</a></div>
                        </div>
                        <div class="d-flex align-items-baseline flex-wrap" style="column-gap:.75rem;">
                            <span class="amount fs-2 fw-bold @(cur.NetProfit >= 0 ? "text-success" : "text-danger")">@Kes(cur.NetProfit)</span>
                            @if (netChange.HasValue)
                            {
                                <span class="@(netUp ? "text-success" : "text-danger")"><em class="icon ni ni-arrow-long-@(netUp ? "up" : "down")"></em>@Kes(cur.NetProfit - prior.NetProfit) vs @Model.PriorLabel</span>
                            }
                        </div>
                        <div class="text-soft small mb-3">@cur.MarginPct.ToString("0.0")% margin &middot; @(cur.ProfitBeforeTax >= 0 ? $"KES {cur.ProfitBeforeTax:N0} above costs" : $"KES {-cur.ProfitBeforeTax:N0} more cash needed to break even")</div>

                        <table class="table table-sm mb-0" style="font-size:13px;">
                            <thead>
                                <tr class="text-soft">
                                    <th></th>
                                    <th class="text-end fw-normal">Now</th>
                                    <th class="text-end fw-normal">Before</th>
                                    <th class="text-end fw-normal">Change</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-medium">Cash collected</td>
                                    <td class="text-end fw-medium">@cur.Revenue.ToString("N0")</td>
                                    <td class="text-end text-soft">@prior.Revenue.ToString("N0")</td>
                                    <td class="text-end">@ChangeText(cur.Revenue, prior.Revenue)</td>
                                </tr>
                                <tr>
                                    <td class="text-soft" title="Buying price of phones on contracts that started in the period">Device cost</td>
                                    <td class="text-end text-danger">(@cur.CostOfDevices.ToString("N0"))</td>
                                    <td class="text-end text-soft">(@prior.CostOfDevices.ToString("N0"))</td>
                                    <td class="text-end">@ChangeText(cur.CostOfDevices, prior.CostOfDevices)</td>
                                </tr>
                                <tr>
                                    <td class="text-soft" title="Dealer, agent and collector payouts, on the date paid">Commissions paid</td>
                                    <td class="text-end text-danger">(@cur.Commissions.ToString("N0"))</td>
                                    <td class="text-end text-soft">(@prior.Commissions.ToString("N0"))</td>
                                    <td class="text-end">@ChangeText(cur.Commissions, prior.Commissions)</td>
                                </tr>
                                <tr>
                                    <td class="text-soft">Operating expenses</td>
                                    <td class="text-end text-danger">(@cur.OperatingExpenses.ToString("N0"))</td>
                                    <td class="text-end text-soft">(@prior.OperatingExpenses.ToString("N0"))</td>
                                    <td class="text-end">@ChangeText(cur.OperatingExpenses, prior.OperatingExpenses)</td>
                                </tr>
                                <tr>
                                    <td class="text-soft">Tax (@cur.TaxRatePct.ToString("0")%)</td>
                                    <td class="text-end text-danger">(@cur.Tax.ToString("N0"))</td>
                                    <td class="text-end text-soft">(@prior.Tax.ToString("N0"))</td>
                                    <td class="text-end"></td>
                                </tr>
                                <tr class="fw-bold">
                                    <td>Net profit</td>
                                    <td class="text-end @(cur.NetProfit >= 0 ? "text-success" : "text-danger")">@cur.NetProfit.ToString("N0")</td>
                                    <td class="text-end text-soft">@prior.NetProfit.ToString("N0")</td>
                                    <td class="text-end"></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="mt-3 d-flex flex-column text-soft" style="font-size:11px; row-gap:4px;">
                            @if (Model.Period == "month" && Model.MonthDaysElapsed > 0)
                            {
                                <span>At this pace: about <strong>KES @paceRevenue.ToString("N0")</strong> collected by month end (day @Model.MonthDaysElapsed of @Model.MonthDays)@(Model.RevenueTargetThisMonth > 0 ? $" against a KES {Model.RevenueTargetThisMonth:N0} target" : "").</span>
                            }
                            <span>Device cost counts when a contract starts; the customer pays it back over the term. Months with strong sales look weaker until they do.</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-7">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <div class="card-title-group mb-3">
                            <div class="card-title">
                                <h6 class="title">Cash in vs costs</h6>
                                <p class="text-soft">Last 12 months &middot; costs = devices + commissions + expenses; the line is profit before tax</p>
                            </div>
                        </div>
                        <div style="height:300px;">
                            <canvas id="profitTrendChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div><!-- .nk-block -->

    <div class="nk-block">
        <div class="card card-bordered">
            <div class="card-inner">
                <div class="card-title-group mb-2">
                    <div class="card-title">
                        <h6 class="title">What to do</h6>
                        <p class="text-soft mb-0">Worked out from the figures on this page, most urgent first</p>
                    </div>
                </div>
                @if (Model.Actions.Count == 0)
                {
                    <p class="text-soft mb-0">Nothing needs attention right now.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var a in Model.Actions)
                        {
                            <li class="d-flex align-items-start py-2 border-bottom" style="column-gap:.6rem;">
                                <em class="icon ni @a.Icon text-@a.Level fs-5 flex-shrink-0"></em>
                                <span class="flex-grow-1">@a.Text</span>
                                @if (a.Link != null)
                                {
                                    <a href="@a.Link" class="link link-primary small flex-shrink-0">@a.LinkText &rarr;</a>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div><!-- .nk-block -->

    <div class="nk-block">
        <div class="row g-gs">
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <h6 class="title mb-2">Active accounts</h6>
                        <span class="amount fs-4 fw-bold">@Model.ActiveAccounts.ToString("N0")</span>
                        <span class="d-block sub-title mt-1"><span class="text-success">+@Model.NewInPeriod.ToString("N0")</span> new @Model.PeriodLabel <span class="text-soft">(@newChange vs before)</span></span>
                        <div class="mt-3 d-flex flex-column text-soft" style="font-size:11px; row-gap:4px;">
                            @if (Model.NewInPeriod > 0)
                            {
                                <span title="Of the accounts started in the period">New accounts: @Model.CollectionRatePct.ToString("0")% on time &middot; @Model.PortfolioAtRiskPct.ToString("0")% already 30+ days late</span>
                            }
                            <span>@Model.CompletedContractsThisMonth.ToString("N0") paid off @Model.PeriodLabel</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <h6 class="title mb-2">Arrears <span class="text-soft small">excl. restructured</span></h6>
                        <span class="amount fs-4 fw-bold text-danger">KES @Model.ArrearsTotal.ToString("N0")</span>
                        <span class="d-block sub-title mt-1">@Model.ArrearsTrueCount.ToString("N0") accounts past their lock date</span>
                        <div class="mt-3 d-flex flex-column text-soft" style="font-size:11px; row-gap:4px;">
                            <span class="text-danger">@Model.BadDebtCount.ToString("N0") over 90 days &middot; KES @Model.BadDebtThisMonth.ToString("N0")</span>
                            @if (Model.LoanBookOutstanding > 0)
                            {
                                <span>@arrearsPctOfBook.ToString("0.0")% of the money still to collect</span>
                            }
                            <span>@Model.Collections.Count.ToString("N0") need collection &middot; <a href="/collections" class="text-soft">Collections &rarr;</a></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <h6 class="title mb-2">Restructured</h6>
                        <span class="amount fs-4 fw-bold text-info">@Model.RestructuredCount.ToString("N0") <span class="fs-6 fw-normal text-soft">accounts</span></span>
                        <span class="d-block sub-title mt-1">KES @Model.RestructuredBehind.ToString("N0") behind on the original plan</span>
                        <div class="mt-3 d-flex flex-column text-soft" style="font-size:11px; row-gap:4px;">
                            <span class="@(Model.RestructuredPayingCount < Model.RestructuredCount ? "text-warning" : "text-success")">@Model.RestructuredPayingCount.ToString("N0") of @Model.RestructuredCount.ToString("N0") paid in the last 30 days</span>
                            <span>KES @Model.RestructuredBalance.ToString("N0") left to pay on them</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <h6 class="title mb-2">Still to collect</h6>
                        <span class="amount fs-4 fw-bold">KES @Model.LoanBookOutstanding.ToString("N0")</span>
                        <span class="d-block sub-title mt-1">on @Model.LoanBookAccounts.ToString("N0") open contracts</span>
                        <div class="mt-3 d-flex flex-column text-soft" style="font-size:11px; row-gap:4px;">
                            <span title="Paid so far as a share of what was due by today">Customers have paid @Model.RepaymentRatePct.ToString("0")% of what's due</span>
                            <span title="Device cost as a share of contract value">A phone is paid for at @Model.BreakEvenCollectionPct.ToString("0")% of its contract</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div><!-- .nk-block -->

    <div class="nk-block">
        <div class="row g-gs">
            <div class="col-12 col-lg-4">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <h6 class="title mb-3">Portfolio</h6>
                        <div class="row g-3 align-items-center">
                            <div class="col-5">
                                <div style="position:relative; width:120px; max-width:100%; aspect-ratio:1/1; margin:0 auto;">
                                    <canvas id="portfolioCompositionChart" width="120" height="120" style="width:100%; height:100%;"></canvas>
                                    <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); text-align:center; pointer-events:none;">
                                        <div class="fw-bold" style="font-size:18px; line-height:1.1;">@PortfolioPct(Model.PortfolioGoodCount).ToString("0")%</div>
                                        <div class="text-soft" style="font-size:10px;">on time</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-7" style="font-size:11px;">
                                @foreach (var (label, count, colour) in new[] {
                                    ("On time", Model.PortfolioGoodCount, "#1ee0ac"),
                                    ("Restructured", Model.PortfolioRestructuredCount, "#09c2de"),
                                    ("1-7 days late", Model.PortfolioSlowCount, "#f4bd0e"),
                                    ("8-90 days late", Model.PortfolioArrearsCount, "#e85347"),
                                    ("Over 90 days", Model.PortfolioBadCount, "#364a63") })
                                {
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="d-flex align-items-center"><span class="dot me-1" style="background-color:@colour;"></span>@label</span>
                                        <span class="fw-bold">@count.ToString("N0") &middot; @PortfolioPct(count).ToString("0")%</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <div class="card-title-group mb-2">
                            <h6 class="title">Write-offs <span class="text-soft small">@Model.PeriodLabel</span></h6>
                            <div class="card-tools"><a href="/write-offs" class="link link-primary small">Review</a></div>
                        </div>
                        <span class="amount fs-4 fw-bold text-danger">KES @Model.WriteOffsPeriod.WrittenOffBalance.ToString("N0")</span>
                        <span class="d-block sub-title mt-1">@Model.WriteOffsPeriod.WrittenOffCount.ToString("N0") accounts &middot; real loss KES @Model.WriteOffsPeriod.RealLoss.ToString("N0")</span>
                        <div class="mt-3 d-flex flex-column text-soft" style="font-size:11px; row-gap:4px;">
                            <span>@Model.WriteOffsPendingCount.ToString("N0") waiting for review &middot; KES @Model.WriteOffsPendingBalance.ToString("N0")</span>
                            <span class="text-success">@Model.WriteOffsPeriod.ReinstatedCount.ToString("N0") came back (customer paid again)</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card card-bordered h-100">
                    <div class="card-inner">
                        <div class="card-title-group mb-2">
                            <h6 class="title">Commissions</h6>
                            <div class="card-tools"><a href="/commission-payouts" class="link link-primary small">Pay</a></div>
                        </div>
                        <span class="amount fs-4 fw-bold">KES @commissionsPaid.ToString("N0")</span>
                        <span class="d-block sub-title mt-1">paid @Model.PeriodLabel &middot; @(cur.Revenue > 0 ? (commissionsPaid / cur.Revenue * 100).ToString("0") : "0")% of cash collected</span>
                        <div class="mt-3 d-flex flex-column text-soft" style="font-size:11px; row-gap:4px;">
                            <span>Dealers payable now: KES @Model.DealerCommissionPayable.ToString("N0")@(Model.DealersSuspended > 0 ? $" · {Model.DealersSuspended} suspended" : "")</span>
                            <span>Agents payable now: KES @Model.CommissionSummary.Payable.ToString("N0")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div><!-- .nk-block -->

    @{
        const int tablePageSize = 5;

        int NonPayersMoreCount = Math.Max(0, Model.NonPayers.Count - tablePageSize);
        int SlowPayersMoreCount = Math.Max(0, Model.SlowPayers.Count - tablePageSize);
        int GoodPayersMoreCount = Math.Max(0, Model.GoodPayers.Count - tablePageSize);
        int DealerMoreCount = Math.Max(0, Model.DealerPerformance.Count - tablePageSize);
        int AgentMoreCount = Math.Max(0, Model.AgentPerformance.Count - tablePageSize);
        int ProductMoreCount = Math.Max(0, Model.ProductPerformance.Count - tablePageSize);
        int CompletedMoreCount = Math.Max(0, Model.CompletedContracts.Count - tablePageSize);
    }

    <div class="nk-block">
        <div class="card card-bordered card-stretch">
            <div class="card-inner-group">
                <div class="card-inner">
                    <div class="card-title-group">
                        <div class="card-title">
                            <h6 class="title">Dealer Performance</h6>
                            <p class="text-soft">Biggest books first. Late = more than 7 days past lock, restructured left out &middot; revenue is this calendar month</p>
                        </div>
                    </div>
                </div>
                <div class="card-inner p-0">
                    <div class="table-responsive">
                    <table class="table mb-0" style="white-space:nowrap;" data-key="dealers" data-page-size="@tablePageSize">
                        <thead>
                            <tr>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Rank</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Dealer</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Accounts</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)" title="Accounts started @Model.PeriodLabel">New</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Revenue (month)</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)" title="Share of the dealer's open accounts more than 7 days past lock, restructured left out">Late %</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Late (KES)</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)" title="Open accounts more than 90 days past lock, restructured left out">Bad customers</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)" title="Bad customers as a share of the dealer's open accounts">Bad %</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Restructured</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)" title="Dealer commission paid this month / payable now after arrears (0 while suspended)">Commission Paid / Payable</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.DealerPerformance.Count; i++)
                            {
                                var d = Model.DealerPerformance[i];
                                <tr class="@(i >= tablePageSize ? "d-none" : "")" data-watchlist-row="dealers">
                                    <td>@d.Rank</td>
                                    <td><span class="fw-medium">@d.DealerName</span></td>
                                    <td>@d.Accounts</td>
                                    <td>@d.NewInPeriod</td>
                                    <td>KES @d.Revenue.ToString("N0")</td>
                                    <td><span class="badge badge-dim @(d.BehindPct >= 30 ? "bg-danger" : d.BehindPct >= 15 ? "bg-warning" : "bg-success")">@d.BehindPct.ToString("0")%</span></td>
                                    <td>KES @d.BehindAmount.ToString("N0")</td>
                                    <td class="@(d.BadCount > 0 ? "text-danger fw-bold" : "text-soft")">@d.BadCount</td>
                                    <td><span class="badge badge-dim @(d.BadPct >= 15 ? "bg-danger" : d.BadPct >= 5 ? "bg-warning" : "bg-success")">@d.BadPct.ToString("0")%</span></td>
                                    <td class="text-info">@d.RestructuredCount</td>
                                    <td>@d.CommissionPaid.ToString("N0") / @d.CommissionDue.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                    @if (DealerMoreCount > 0)
                    {
                        <div class="card-inner d-flex" style="column-gap:1rem;">
                            <a href="#" class="link link-primary" data-more-for="dealers" onclick="event.preventDefault(); Ranalo.showMoreRows(this, 'dealers', @tablePageSize);">Show @Math.Min(tablePageSize, DealerMoreCount) more</a>
                            <a href="#" class="link link-primary" data-less-for="dealers" style="display:none;" onclick="event.preventDefault(); Ranalo.showLessRows(this, 'dealers', @tablePageSize);">Show less</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div><!-- .nk-block -->

    <div class="nk-block">
        <div class="card card-bordered card-stretch">
            <div class="card-inner-group">
                <div class="card-inner">
                    <div class="card-title-group">
                        <div class="card-title">
                            <h6 class="title">Agent Performance</h6>
                            <p class="text-soft">Ranked by active rate this month, vs. an 80% active-rate target</p>
                            <p class="text-soft small mb-0">Good: not past lock &middot; Restructured: manual restructure, or in arrears on a new plan &middot; Slow: 1-7 days &middot; Arrears: 8-90 days &middot; Bad: 90+ days &middot; Needs Collection: 30+ days past lock, not restructured, no payment in 7 days</p>
                        </div>
                    </div>
                </div>
                <div class="card-inner p-0">
                    <div class="table-responsive">
                        <table class="table mb-0" style="white-space:nowrap;" data-key="agents" data-page-size="@tablePageSize">
                            <thead>
                                <tr>
                                    <th class="wl-th" onclick="Ranalo.sortTable(this)">Rank</th>
                                    <th class="wl-th" onclick="Ranalo.sortTable(this)">Agent</th>
                                    <th class="wl-th" onclick="Ranalo.sortTable(this)">Dealer</th>
                                    <th class="wl-th" onclick="Ranalo.sortTable(this)">Accounts</th>
                                    <th class="wl-th" onclick="Ranalo.sortTable(this)" title="Not past lock date">Good</th>
                                    <th class="wl-th" onclick="Ranalo.sortTable(this)" title="Manually restructured, or in arrears but on a new plan before the lock date">Restructured</th>
                                    <th class="wl-th" onclick="Ranalo.sortTable(this)" title="1-7 days past lock date">Slow</th>
                                    <th class="wl-th" onclick="Ranalo.sortTable(this)" title="8-90 days past lock date">Arrears</th>
                                    <th class="wl-th" onclick="Ranalo.sortTable(this)" title="Over 90 days past lock date">Bad</th>
                                    <th class="wl-th" onclick="Ranalo.sortTable(this)" title="30+ days past lock, not restructured, no payment in 7 days">Needs Collection</th>
                                    <th class="wl-th" onclick="Ranalo.sortTable(this)" title="Paid as a share of amount due to date">Repayment %</th>
                                    <th class="wl-th" onclick="Ranalo.sortTable(this)">Active %</th>
                                    <th class="wl-th" onclick="Ranalo.sortTable(this)">vs. Target</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.AgentPerformance.Count; i++)
                                {
                                    var a = Model.AgentPerformance[i];
