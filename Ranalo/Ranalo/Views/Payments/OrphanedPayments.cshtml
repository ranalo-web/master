@using Ranalo.Models
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model KosePaymentsViewModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/watchlist-table.css?v=2">

<div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between">
            <div class="nk-block-head-content">
                <h3 class="nk-block-title page-title">Orphaned Payments</h3>
                <div class="nk-block-des text-soft">
                    <p>You have total @Model?.TotalRecords.ToString("N0") payments.</p>
                </div>
            </div><!-- .nk-block-head-content -->
        </div><!-- .nk-block-between -->
    </div><!-- .nk-block-head -->

    <div class="nk-block">
        <div class="card card-bordered card-stretch">
            <div class="card-inner-group">
                <div class="card-inner position-relative card-tools-toggle">
                    <div class="card-title-group">
                        <div class="card-tools">
                            <a href="#" class="btn btn-icon search-toggle toggle-search" data-target="search"><em class="icon ni ni-search"></em></a>
                        </div>
                        <div class="card-search search-wrap" data-search="search">
                            <div class="card-body">
                                <div class="search-content">
                                    <a href="#" class="search-back btn btn-icon toggle-search" data-target="search"><em class="icon ni ni-arrow-left"></em></a>
                                    <form action="/orphanedpayments" method="get">
                                        <input name="searchTerm" type="text" class="form-control border-transparent form-focus-none" value="@ViewBag.SearchTerm" placeholder="Search by account, Mpesa code">
                                        <button type="submit" class="search-submit btn btn-icon"><em class="icon ni ni-search"></em></button>
                                    </form>
                                </div>
                            </div>
                        </div><!-- .card-search -->
                    </div><!-- .card-title-group -->
                </div><!-- .card-inner -->

                <div class="card-inner p-0">
                    <div class="table-responsive">
                    <table class="table mb-0" style="white-space:nowrap;" data-key="orphaned-payments" data-page-size="10">
                        <thead>
                            <tr>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Account No</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Name</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Mpesa Code</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Payment Date</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Amount</th>
                                <th class="wl-th"></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (Model?.Payments != null)
                        {
                            foreach (var payment in Model.Payments)
                            {
                                <tr>
                                    <td><span class="fw-medium">@payment.AccountNo</span></td>
                                    <td>@payment.FirstName</td>
                                    <td>@payment.MpesaCode</td>
                                    <td>@payment.PaymentDateValue.ToString("MMM d, yyyy HH:mm")</td>
                                    <td>KES @payment.AmountValue.ToString("N0")</td>
                                    <td>
                                        <a href="#edit-payment"
                                           data-bs-toggle="modal"
                                           class="link link-primary"
                                           data-orphanedAccountNo="@payment.AccountNo"
                                           data-amount="@payment.AmountValue"
                                           data-mpesacode="@payment.MpesaCode">
                                            Assign
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                    </div>
                    @if (Model?.Payments == null || Model.Payments.Count == 0)
                    {
                        <div class="card-inner text-soft">No orphaned payments found.</div>
                    }
                </div><!-- .card-inner -->
                <div class="card-inner">
                    <div class="nk-block-between-md g-3">
                        <div class="g">
                            <ul class="pagination justify-content-center justify-content-md-start">
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/orphanedpayments?page=@(Model.CurrentPage - 1)&searchTerm=@ViewBag.SearchTerm">Prev</a>
                                    </li>
                                }

                                @{
                                    var maxVisiblePages = 5;
                                    var startPage = Math.Max(1, Model.CurrentPage - 2);
                                    var endPage = Math.Min(Model.TotalPages, startPage + maxVisiblePages - 1);
                                    if (endPage - startPage < maxVisiblePages - 1)
                                    {
                                        startPage = Math.Max(1, endPage - maxVisiblePages + 1);
                                    }
                                }

                                @if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/orphanedpayments?page=1&searchTerm=@ViewBag.SearchTerm">1</a>
                                    </li>
                                    <li class="page-item">
                                        <span class="page-link"><em class="icon ni ni-more-h"></em></span>
                                    </li>
                                }

                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="/orphanedpayments?page=@i&searchTerm=@ViewBag.SearchTerm">@i</a>
                                    </li>
                                }

                                @if (endPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <span class="page-link"><em class="icon ni ni-more-h"></em></span>
                                    </li>
                                    <li class="page-item">
                                        <a class="page-link" href="/orphanedpayments?page=@Model.TotalPages&searchTerm=@ViewBag.SearchTerm">@Model.TotalPages</a>
                                    </li>
                                }

                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/orphanedpayments?page=@(Model.CurrentPage + 1)&searchTerm=@ViewBag.SearchTerm">Next</a>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="g">
                            <div class="pagination-goto d-flex justify-content-center justify-content-md-start gx-3">
                                <div>Page @Model.CurrentPage OF @Model.TotalPages</div>
                            </div>
                        </div><!-- .pagination-goto -->
                    </div><!-- .nk-block-between -->
                </div><!-- .card-inner -->

			</div>
		</div>
	</div>

</div>


<div class="modal fade" tabindex="-1" id="edit-payment">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <a href="#" class="close" data-bs-dismiss="modal" aria-label="Close">
                <em class="icon ni ni-cross-sm"></em>
            </a>
            <div class="modal-body modal-body-md">
                <h5 class="modal-title">Assign Payment</h5>
                <form action="/assign-payments" method="post" class="mt-2">
                    <div class="row g-gs">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="edit-income">Orphaned Account No</label>
                                <div class="form-control-wrap">
                                    <input type="text" name="orphanedNo" class="form-control" id="edit-orphanedAccountNo" readonly />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="edit-income">Mpesa Code</label>
                                <div class="form-control-wrap">
                                    <input type="text" name="mpesaCode" class="form-control" id="edit-mpesacode" readonly />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="edit-account">Account No</label>
                                <div class="form-control-wrap">
                                    <input type="text" name="accountNo" class="form-control" id="edit-account" required />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="edit-amount">Account No</label>
                                <div class="form-control-wrap">
                                    <input type="text" name="amount" class="form-control" id="edit-amount" readonly />
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <ul class="align-center flex-wrap flex-sm-nowrap gx-4 gy-2">
                                <li>
                                    <button type="submit" class="btn btn-lg btn-primary">Submit</button>
                                </li>
                                <li>
                                    <a href="#" data-bs-dismiss="modal" class="link link-gray">Cancel</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts
{
    <script src="~/js/watchlist-table.js"></script>
    <script>
    document.addEventListener("DOMContentLoaded", function () {
        // Populate the modal fields directly from the triggering link's
        // click, rather than the modal's own 'shown.bs.modal' event -- this
        // page's bundled Bootstrap build doesn't dispatch that event as a
        // native CustomEvent, so a listener on the modal element itself
        // never fires (confirmed live: Modal.show() runs and the modal
        // opens, but 'shown.bs.modal' never reaches an addEventListener).
        // Click delegation on the trigger works regardless of which modal
        // implementation ends up handling the display.
        document.addEventListener('click', function (event) {
            var trigger = event.target.closest('a[data-bs-toggle="modal"][href="#edit-payment"]');
            if (!trigger) return;

            document.getElementById('edit-orphanedAccountNo').value = trigger.getAttribute('data-orphanedaccountno') || '';
            document.getElementById('edit-mpesacode').value = trigger.getAttribute('data-mpesacode') || '';
            document.getElementById('edit-amount').value = trigger.getAttribute('data-amount') || '';
        });
    })
    </script>
}
