@using Ranalo.Models
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model PaymentsSummaryTotalsViewModel
@{
    Layout = "_Layout";
    string period = ViewBag.Period ?? "";
    var periodNames = new Dictionary<string, string> { ["week"] = "Week", ["month"] = "Month", ["ytd"] = "Year to Date", ["year"] = "Last 12 Months" };
    var periodLabel = periodNames.TryGetValue(period, out var pn) ? pn : "All Time";

    string PageLink(int page) => Url.Action("PaymentSummary", "Payments", new { page, searchTerm = ViewBag.SearchTerm, period })!;
    string PeriodLink(string p) => Url.Action("PaymentSummary", "Payments", new { page = 1, searchTerm = ViewBag.SearchTerm, period = p })!;
}

<link rel="stylesheet" href="~/css/watchlist-table.css?v=2">

<div class="nk-content-body">
	<div class="nk-block-head nk-block-head-sm">
		<div class="nk-block-between">
			<div class="nk-block-head-content">
				<h3 class="nk-block-title page-title">Payments Summary</h3>
				<div class="nk-block-des text-soft">
                    <p>You have total @Model?.TotalRecords.ToString("N0") payments@(period != "" ? $" ({periodLabel.ToLowerInvariant()})" : "").</p>
				</div>
			</div><!-- .nk-block-head-content -->
			<div class="nk-block-head-content">
				<div class="btn-group">
					<button type="button" class="btn btn-outline-light btn-white dropdown-toggle" data-bs-toggle="dropdown">
						<em class="icon ni ni-calendar"></em><span>@periodLabel</span>
					</button>
					<div class="dropdown-menu dropdown-menu-end">
						<ul class="link-list-opt no-bdr">
							<li><a href="@PeriodLink("")"><span>All Time</span></a></li>
							<li><a href="@PeriodLink("week")"><span>Week</span></a></li>
							<li><a href="@PeriodLink("month")"><span>Month</span></a></li>
							<li><a href="@PeriodLink("ytd")"><span>Year to Date</span></a></li>
							<li><a href="@PeriodLink("year")"><span>Last 12 Months</span></a></li>
						</ul>
					</div>
				</div>
			</div><!-- .nk-block-head-content -->
		</div><!-- .nk-block-between -->
	</div><!-- .nk-block-head -->

    <div class="nk-block">
        <div class="card card-bordered card-stretch">
            <div class="card-inner-group">
                <div class="card-inner position-relative card-tools-toggle">
                    <div class="card-title-group">
                        <div class="card-tools">
                            <a href="#" class="btn btn-icon search-toggle toggle-search" data-target="search"><em class="icon ni ni-search"></em></a>
                        </div>
                        <div class="card-search search-wrap" data-search="search">
                            <div class="card-body">
                                <div class="search-content">
                                    <a href="#" class="search-back btn btn-icon toggle-search" data-target="search"><em class="icon ni ni-arrow-left"></em></a>
                                    <form action="/paymentsummary" method="get">
                                    <input type="hidden" name="period" value="@period" />
                                    <input name="searchTerm" type="text" class="form-control border-transparent form-focus-none" placeholder="Search by account number" value="@ViewBag.SearchTerm">
                                    <button type="submit" class="search-submit btn btn-icon"><em class="icon ni ni-search"></em></button>
                                    </form>
                                </div>
                            </div>
                        </div><!-- .card-search -->
                    </div><!-- .card-title-group -->
                </div><!-- .card-inner -->

                <div class="card-inner p-0">
                    <div class="table-responsive">
                    <table class="table mb-0" style="white-space:nowrap;" data-key="payment-summary" data-page-size="10">
                        <thead>
                            <tr>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Account No</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Total Paid</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">First Payment Date</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Last Payment Date</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">First Payment</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Last Payment</th>
                                <th class="wl-th"></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (Model?.Payments != null)
                        {
                            foreach (var payment in Model.Payments)
                            {
                                <tr>
                                    <td><span class="fw-medium">@payment.Account</span></td>
                                    <td>KES @payment.TotalPaid.ToString("N0")</td>
                                    <td>@(payment.First?.ToString("dd MMM yyyy") ?? "-")</td>
                                    <td>@(payment.Last?.ToString("dd MMM yyyy") ?? "-")</td>
                                    <td>@(payment.FirstPayment.HasValue ? "KES " + payment.FirstPayment.Value.ToString("N0") : "-")</td>
                                    <td>@(payment.LastPayment.HasValue ? "KES " + payment.LastPayment.Value.ToString("N0") : "-")</td>
                                    <td><a href="/account-details/@payment.Account" class="link link-primary">View</a></td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                    </div>
                    @if (Model?.Payments == null || Model.Payments.Count == 0)
                    {
                        <div class="card-inner text-soft">No payments found.</div>
                    }
                </div><!-- .card-inner -->
                <div class="card-inner">
                    <div class="nk-block-between-md g-3">
                        <div class="g">
                            <ul class="pagination justify-content-center justify-content-md-start">
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@PageLink(Model.CurrentPage - 1)">Prev</a>
                                    </li>
                                }

                                @{
                                    var maxVisiblePages = 5;
                                    var startPage = Math.Max(1, Model.CurrentPage - 2);
                                    var endPage = Math.Min(Model.TotalPages, startPage + maxVisiblePages - 1);
                                    if (endPage - startPage < maxVisiblePages - 1)
                                    {
                                        startPage = Math.Max(1, endPage - maxVisiblePages + 1);
                                    }
                                }

                                @if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@PageLink(1)">1</a>
                                    </li>
                                    <li class="page-item">
                                        <span class="page-link"><em class="icon ni ni-more-h"></em></span>
                                    </li>
                                }

                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@PageLink(i)">@i</a>
                                    </li>
                                }

                                @if (endPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <span class="page-link"><em class="icon ni ni-more-h"></em></span>
                                    </li>
                                    <li class="page-item">
                                        <a class="page-link" href="@PageLink(Model.TotalPages)">@Model.TotalPages</a>
                                    </li>
                                }

                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@PageLink(Model.CurrentPage + 1)">Next</a>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="g">
                            <div class="pagination-goto d-flex justify-content-center justify-content-md-start gx-3">
                                <div>Page @Model.CurrentPage OF @Model.TotalPages</div>
                            </div>
                        </div><!-- .pagination-goto -->
                    </div><!-- .nk-block-between -->
                </div><!-- .card-inner -->

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/watchlist-table.js"></script>
}
