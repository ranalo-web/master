@using Ranalo.Models
@model AccountAssignmentViewModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    string Link(int? dealer, string show) => "/account-assignment" + Microsoft.AspNetCore.Http.QueryString.Create(new Dictionary<string, string?>
    {
        ["dealerId"] = dealer?.ToString(),
        ["show"] = show,
        ["q"] = string.IsNullOrWhiteSpace(Model.Search) ? null : Model.Search,
    }.Where(kv => kv.Value != null));
}

<style>
    .aa-bar { position: sticky; top: 64px; z-index: 5; }
    @@media (max-width: 767.98px) {
        .aa-md { display: none !important; }
        .aa-table td, .aa-table th { padding-left: .5rem; padding-right: .5rem; }
    }
</style>

<div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between">
            <div class="nk-block-head-content">
                <h3 class="nk-block-title page-title">Account Assignment</h3>
                <div class="nk-block-des text-soft">
                    <p>Assign agents and collectors to accounts in bulk, across every dealer. An agent can only take their own dealer's accounts (their commission depends on it); collectors work across all dealers. Only open contracts change. Every change is logged.</p>
                </div>
            </div>
            <div class="nk-block-head-content">
                <a href="/adduser" class="btn btn-outline-primary"><em class="icon ni ni-user-add"></em><span>Add agent or collector</span></a>
            </div>
        </div>
    </div>

    @if (TempData["AssignmentSuccess"] is string success)
    {
        <div class="alert alert-success alert-icon alert-dismissible">
            <em class="icon ni ni-check-circle"></em> @success
            <button class="close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["AssignmentError"] is string error)
    {
        <div class="alert alert-danger alert-icon alert-dismissible">
            <em class="icon ni ni-cross-circle"></em> @error
            <button class="close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="nk-block">
        <div class="card card-bordered">
            <div class="card-inner">
                <form method="get" action="/account-assignment" class="d-flex flex-wrap align-items-center" style="gap:.5rem;">
                    <select name="dealerId" class="form-select form-select-sm" style="max-width:240px;" onchange="this.form.submit()">
                        <option value="">All dealers</option>
                        @foreach (var d in Model.Dealers)
                        {
                            <option value="@d.DealerId" selected="@(Model.DealerId == d.DealerId)">@d.CompanyName</option>
                        }
                    </select>
                    <div class="btn-group">
                        <a href="@Link(Model.DealerId, "noagent")" class="btn btn-sm @(Model.Show == "noagent" ? "btn-primary" : "btn-outline-light btn-white")">No agent</a>
                        <a href="@Link(Model.DealerId, "nocollector")" class="btn btn-sm @(Model.Show == "nocollector" ? "btn-primary" : "btn-outline-light btn-white")">No collector</a>
                        <a href="@Link(Model.DealerId, "all")" class="btn btn-sm @(Model.Show == "all" ? "btn-primary" : "btn-outline-light btn-white")">All</a>
                    </div>
                    <input type="hidden" name="show" value="@Model.Show" />
                    <div class="form-control-wrap flex-grow-1" style="min-width:180px;">
                        <div class="form-icon form-icon-left"><em class="icon ni ni-search"></em></div>
                        <input type="search" name="q" value="@Model.Search" class="form-control form-control-sm" placeholder="Account, contract, customer, agent or collector" />
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary">Search</button>
                </form>
                <p class="text-soft small mt-2 mb-0">@Model.Accounts.Count account(s)@(Model.Accounts.Count >= 1000 ? " (first 1,000 -- narrow it with a dealer or search)" : "")</p>
            </div>
        </div>
    </div>

    <form method="post" action="/account-assignment/assign" id="aa-form">
        <input type="hidden" name="dealerId" value="@Model.DealerId" />
        <input type="hidden" name="show" value="@Model.Show" />
        <input type="hidden" name="q" value="@Model.Search" />
        <input type="hidden" name="mode" id="aa-mode" value="assign" />

        <div class="nk-block">
            <div class="card card-bordered aa-bar">
                <div class="card-inner py-2 d-flex flex-wrap align-items-center" style="gap:.5rem;">
                    <span class="fw-medium"><span id="aa-count">0</span> ticked</span>
                    <select name="role" id="aa-role" class="form-select form-select-sm" style="max-width:140px;">
                        <option value="@AssignmentRole.Agent">Agent</option>
                        <option value="@AssignmentRole.Collector">Collector</option>
                    </select>
                    <select name="userId" id="aa-person" class="form-select form-select-sm" style="max-width:280px;">
                        <option value="">Choose…</option>
                        @foreach (var dealerAgents in Model.Agents.GroupBy(a => a.DealerName ?? "No dealer"))
                        {
                            <optgroup label="@dealerAgents.Key" data-role="@AssignmentRole.Agent">
                                @foreach (var a in dealerAgents)
                                {
                                    <option value="@a.UserId" data-role="@AssignmentRole.Agent" data-dealer="@a.DealerId">@a.Name</option>
                                }
                            </optgroup>
                        }
                        <optgroup label="Collectors (all dealers)" data-role="@AssignmentRole.Collector">
                            @foreach (var c in Model.Collectors)
                            {
                                <option value="@c.UserId" data-role="@AssignmentRole.Collector">@c.Name</option>
                            }
                        </optgroup>
                    </select>
                    <button type="submit" class="btn btn-sm btn-primary" id="aa-assign" disabled>Assign</button>
                    <button type="submit" class="btn btn-sm btn-outline-danger" id="aa-remove" disabled>Remove</button>
                    <a href="#" class="link link-primary small ms-auto" id="aa-all">Tick all shown</a>
                    <a href="#" class="link link-primary small" id="aa-none">Clear</a>
                </div>
            </div>
        </div>

        <div class="nk-block">
            <div class="card card-bordered">
                @if (Model.Accounts.Count == 0)
                {
                    <div class="card-inner text-soft">No accounts match.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 aa-table" style="font-size:13px;">
                            <thead>
                                <tr>
                                    <th style="width:1%;"></th>
                                    <th>Account</th>
                                    <th class="aa-md">Dealer</th>
                                    <th>Agent</th>
                                    <th>Collector</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in Model.Accounts)
                                {
                                    <tr>
                                        <td><input type="checkbox" class="form-check-input aa-account" name="accountNos" value="@a.AccountNo" data-dealer="@a.DealerId" /></td>
                                        <td>
                                            <a href="/account-details/@a.AccountNo" target="_blank" class="fw-medium">@(string.IsNullOrWhiteSpace(a.CustomerName) ? "(no name)" : a.CustomerName)</a>
                                            <span class="d-block sub-text">AC @a.AccountNo · @(a.ProductName ?? "Unknown device") · @(a.StartDate?.ToString("dd MMM yyyy") ?? "-")</span>
                                        </td>
                                        <td class="aa-md">@(a.DealerName ?? "No dealer")</td>
                                        <td>@if (a.AgentName != null) { <span>@a.AgentName</span> } else { <span class="text-soft">None</span> }</td>
                                        <td>@if (a.CollectorName != null) { <span>@a.CollectorName</span> } else { <span class="text-soft">None</span> }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var boxes = Array.prototype.slice.call(document.querySelectorAll('.aa-account'));
            var role = document.getElementById('aa-role');
            var person = document.getElementById('aa-person');
            var assign = document.getElementById('aa-assign');
            var remove = document.getElementById('aa-remove');
            var modeInput = document.getElementById('aa-mode');

            // Only the chosen role's people are offered.
            function filterPeople() {
                person.querySelectorAll('optgroup').forEach(function (g) {
                    g.hidden = g.dataset.role !== role.value;
                });
                var chosen = person.options[person.selectedIndex];
                if (chosen && chosen.dataset.role && chosen.dataset.role !== role.value) {
                    person.value = '';
                }
            }

            function ticked() { return boxes.filter(function (b) { return b.checked; }); }
            function update() {
                var n = ticked().length;
                document.getElementById('aa-count').textContent = n;
                assign.disabled = n === 0 || !person.value;
                remove.disabled = n === 0;
            }

            role.addEventListener('change', function () { filterPeople(); update(); });
            person.addEventListener('change', update);
            boxes.forEach(function (b) { b.addEventListener('change', update); });
            document.getElementById('aa-all').addEventListener('click', function (e) { e.preventDefault(); boxes.forEach(function (b) { b.checked = true; }); update(); });
            document.getElementById('aa-none').addEventListener('click', function (e) { e.preventDefault(); boxes.forEach(function (b) { b.checked = false; }); update(); });

            assign.addEventListener('click', function (e) {
                var n = ticked().length;
                var chosen = person.options[person.selectedIndex];
                var msg = 'Assign ' + chosen.text + ' as ' + role.value.toLowerCase() + ' on ' + n + ' account(s)?';
                if (role.value === 'Agent') {
                    var other = ticked().filter(function (b) { return b.dataset.dealer !== chosen.dataset.dealer; }).length;
                    if (other > 0) msg += '\n\n' + other + ' of them belong to a different dealer and will be skipped.';
                }
                if (!confirm(msg)) { e.preventDefault(); return; }
                modeInput.value = 'assign';
            });
            remove.addEventListener('click', function (e) {
                if (!confirm('Remove the ' + role.value.toLowerCase() + ' from ' + ticked().length + ' account(s)?')) { e.preventDefault(); return; }
                modeInput.value = 'remove';
            });

            filterPeople();
            update();
        })();
    </script>
}
