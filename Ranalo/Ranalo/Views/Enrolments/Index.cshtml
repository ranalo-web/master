@model EnrolmentViewModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@functions {

    private string SetStatusBadge(EnrolmentStatus? status)
    {
        var statusClass = "";
        switch (status)
        {
            case EnrolmentStatus.Approved:
                statusClass = "tb-status text-success";
                break;
            case EnrolmentStatus.Pending:
            case EnrolmentStatus.PendingActivation:
                statusClass = "tb-status text-warning";
                break;
            case EnrolmentStatus.Enrolled:
                statusClass = "tb-status text-primary";
                break;
            case EnrolmentStatus.New:
                statusClass = "tb-status text-info";
                break;
            case EnrolmentStatus.Locked:
                statusClass = "tb-status text-danger";
                break;
            default:
                statusClass = "tb-status text-danger";
                break;
        }

        return statusClass;
    }
    private string SetStatusText(EnrolmentStatus? status)
    {
        var statusClass = "";
        switch (status)
        {
            case EnrolmentStatus.New:
                statusClass = "New";
                break;
            case EnrolmentStatus.Pending:
                statusClass = "Pending";
                break;
            case EnrolmentStatus.Locked:
                statusClass = "Locked";
                break;
            case EnrolmentStatus.Approved:
                statusClass = "Approved";
                break;
            default:
                statusClass = "No Status";
                break;
        }

        return statusClass;
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return string.Empty;

        // Split by spaces and take first character of each word
        var initials = fullName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(word => char.ToUpper(word[0]))
            .Take(2) // only take first 2 initials
            .ToArray();

        return new string(initials);
    }
}

<link rel="stylesheet" href="~/css/watchlist-table.css?v=4">

<div class="nk-content-body">
