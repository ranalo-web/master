                                                                <li><span>Show</span></li>
                                                                <li class="@(ViewBag.PageSize == 10 ? "active" : "")"><a href="/enrolments?page=1&amp;pageSize=10&amp;searchTerm=@ViewBag.SearchTerm">10</a></li>
                                                                <li class="@(ViewBag.PageSize == 20 ? "active" : "")"><a href="/enrolments?page=1&amp;pageSize=20&amp;searchTerm=@ViewBag.SearchTerm">20</a></li>
                                                                <li class="@(ViewBag.PageSize == 50 ? "active" : "")"><a href="/enrolments?page=1&amp;pageSize=50&amp;searchTerm=@ViewBag.SearchTerm">50</a></li>
                                                            </ul>
