                    </div><!-- .card-search -->
                </div><!-- .card-inner -->
@{
    // A row's action buttons: in their own column from tablet width up,
    // under the status on a phone.
    void ActionButtons(Enrolment enrolment)
    {
        var isTranssion = DeviceLockRules.IsTranssion(enrolment.DeviceBrand);
        var decision = Model.CanApprove?.Invoke(enrolment);
        if (isTranssion && Model.CanApprove != null)
        {
            if (DeviceLockRules.NeedsSendingToTranssion(enrolment))
            {
                <form method="post" action="/enrolments/send-to-transsion/@enrolment.Id" class="d-inline"
                      title="Transsion doesn't have this phone yet">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-warning">Send to Transsion</button>
                </form>
            }
            else if (decision?.Allowed == true)
            {
                <form method="post" action="/enrolments/approve-call/@enrolment.Id" class="d-inline"
                      onsubmit="return confirm('Have you called @enrolment.FirstName @enrolment.LastName and confirmed this sale? The phone unlocks once it is switched on.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-primary">Approve call</button>
                </form>
            }
            else if (DeviceLockRules.ReadyToUnlock(enrolment))
            {
                <form method="post" action="/enrolments/retry-unlock/@enrolment.Id" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-warning" title="@enrolment.PayTriggerResponse">Retry unlock</button>
                </form>
            }
            else if (decision != null && !enrolment.CallApprovedAt.HasValue && enrolment.Status != EnrolmentStatus.Error)
            {
                <span class="small text-soft" style="white-space:normal">@decision.Reason</span>
            }

            @* Admin: Transsion has the phone but its activation hasn't reached us. *@
            @if (Model.IsAdmin && !enrolment.UnlockedAt.HasValue && !DeviceLockRules.NeedsSendingToTranssion(enrolment))
            {
                <form method="post" action="/enrolments/unlock-for/@enrolment.Id?days=3" class="d-inline"
                      onsubmit="return confirm('Unlock @enrolment.FirstName @enrolment.LastName\'s phone for 3 days? Only works once Transsion shows it active.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Checks Transsion first">Unlock 3 days</button>
                </form>
            }
        }
        else if (Model.CanApprove != null)
        {
            @* Knox: enrol, then approve. The Approve icon used to be hidden
               until hover (nk-tb-action-hidden), which these table rows never
               trigger -- so nobody could see it. *@
            var pending = enrolment.Status == EnrolmentStatus.Pending;
            if (pending && decision is { Allowed: false })
            {
                <div class="small text-soft" style="white-space:normal">@decision.Reason</div>
            }
            <ul class="nk-tb-actions gx-2 justify-content-md-end align-items-center">
                @if (pending && decision?.Allowed == true)
                {
                    <li>
                        <a href="/approve-enrolment/@enrolment.IMEI" class="btn btn-sm btn-primary"
                           title="Approves the phone in Knox. If it hasn't reached Knox yet, try again in a few minutes."
                           onclick="return confirm('Approve phone @enrolment.IMEI in Knox?');">Approve</a>
                    </li>
                }
                <li>
                    <a href="/create-device/@enrolment.IMEI" class="btn btn-sm btn-icon btn-trigger" data-bs-toggle="tooltip" data-bs-placement="top" title="+ Device">
                        <em class="icon ni ni-mobile"></em>
                    </a>
                </li>
                <li>
                    <a href="#" class="btn btn-sm btn-icon btn-trigger" data-bs-toggle="tooltip" data-bs-placement="top" title="Suspend">
                        <em class="icon ni ni-user-cross-fill"></em>
                    </a>
                </li>
            </ul>
        }
    }
}
                <div class="card-inner p-0">
                    <div class="table-responsive">
                    <table class="table mb-0" style="white-space:nowrap;" data-key="enrolments" data-page-size="10">
                        <thead>
                            <tr>
                                @* Narrow screens keep customer, account, status and the
                                   action; the rest show as the width allows. *@
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Customer</th>
                                <th class="wl-th d-none d-sm-table-cell" onclick="Ranalo.sortTable(this)">National ID</th>
                                <th class="wl-th d-none d-lg-table-cell" onclick="Ranalo.sortTable(this)">IMEI</th>
                                <th class="wl-th d-none d-md-table-cell" onclick="Ranalo.sortTable(this)">Brand</th>
                                <th class="wl-th d-none d-xl-table-cell" onclick="Ranalo.sortTable(this)" title="Devices.LockGroup: 1 Nuovo, 2 Knox, 3 PayTrigger">Lock Group</th>
                                <th class="wl-th d-none d-lg-table-cell" onclick="Ranalo.sortTable(this)">Created</th>
                                <th class="wl-th d-none d-xxl-table-cell" onclick="Ranalo.sortTable(this)">Updated</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Status</th>
                                <th class="wl-th d-none d-md-table-cell"></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var enrolment in Model.Enrolments ?? Enumerable.Empty<Enrolment>())
                        {
                            <tr>
                                <td>
                                    <span class="fw-medium">@enrolment.FirstName @enrolment.LastName</span>
                                    <div class="small d-sm-none"><a href="/account-details/@enrolment.AccountId" class="link link-primary">@enrolment.AccountId</a></div>
                                    <div class="small text-soft d-lg-none">@enrolment.DeviceBrand · @enrolment.IMEI</div>
                                </td>
                                <td class="d-none d-sm-table-cell"><a href="/account-details/@enrolment.AccountId" class="link link-primary">@enrolment.AccountId</a></td>
                                <td class="d-none d-lg-table-cell">@enrolment.IMEI</td>
                                <td class="d-none d-md-table-cell">
                                    @enrolment.DeviceBrand
                                    @if (enrolment.BrandOverriddenByUserId.HasValue)
                                    {
                                        <span class="badge badge-dim bg-info" title="Brand confirmed by an admin">admin</span>
                                    }
                                </td>
                                @if (Model.LockGroups.TryGetValue(enrolment.AccountId, out var lockGroup) && lockGroup.HasValue)
                                {
                                    <td class="d-none d-xl-table-cell">
                                        @(lockGroup switch { 1 => "Nuovo", 2 => "Knox", 3 => "PayTrigger", _ => "Unknown" }) (@lockGroup)
                                    </td>
                                }
                                else
                                {
                                    <td class="text-soft d-none d-xl-table-cell" title="@(Model.LockGroups.ContainsKey(enrolment.AccountId) ? "Device has no lock group set" : "No device record for this account yet")">Not set</td>
                                }
                                <td class="d-none d-lg-table-cell">@enrolment.Created.ToString("dd MMM yyyy")</td>
                                <td class="d-none d-xxl-table-cell">@enrolment.Updated.ToString("dd MMM yyyy")</td>
                                <td style="white-space:normal; min-width:140px; max-width:260px;">
                                    @{
                                        bool? knoxActive = Model.KnoxActive.TryGetValue(enrolment.AccountId, out var active) ? active : null;
                                        var activating = enrolment.Status == EnrolmentStatus.Approved && knoxActive == false;
                                    }
                                    <span class="@(activating ? "tb-status text-warning" : SetStatusBadge(enrolment.Status))"
                                          title="@(activating ? "Knox has approved it; it activates once the phone connects to the internet. Locks only reach it after that." : enrolment.PayTriggerResponse)">@DeviceLockRules.StatusText(enrolment, knoxActive)</span>
                                    @if (enrolment.DepositShort)
                                    {
                                        <span class="badge badge-dim bg-danger" title="Paid @enrolment.DepositPaid?.ToString("N2") of @enrolment.RequiredDeposit?.ToString("N2")">Deposit short – admin only</span>
                                    }
                                    @if (enrolment.Status == EnrolmentStatus.Error && !string.IsNullOrEmpty(enrolment.PayTriggerResponse))
                                    {
                                        <div class="small text-soft">@enrolment.PayTriggerResponse</div>
                                    }
                                    <div class="d-md-none mt-1">@{ ActionButtons(enrolment); }</div>
                                </td>
                                <td class="text-end d-none d-md-table-cell">
                                    @{ ActionButtons(enrolment); }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    </div><!-- .table-responsive -->
                    @if (Model.Enrolments == null || !Model.Enrolments.Any())
                    {
                        <div class="card-inner text-soft">No enrolments found.</div>
                    }
                </div><!-- .card-inner -->
                <div class="card-inner">
                    <div class="nk-block-between-md g-3">
                        <div class="g">
                            <ul class="pagination justify-content-center justify-content-md-start">
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/enrolments?page=@(Model.CurrentPage - 1)&pageSize=@(Model.PageSize)">Prev</a>
                                    </li>
                                }

                                @{
                                    var maxVisiblePages = 5;
                                    var startPage = Math.Max(1, Model.CurrentPage - 2);
                                    var endPage = Math.Min(Model.TotalPages, startPage + maxVisiblePages - 1);
                                    if (endPage - startPage < maxVisiblePages - 1)
                                    {
                                        startPage = Math.Max(1, endPage - maxVisiblePages + 1);
                                    }
                                }

                                @if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/enrolments?page=1&pageSize=@(Model.PageSize)">1</a>
                                    </li>
                                    <li class="page-item">
                                        <span class="page-link"><em class="icon ni ni-more-h"></em></span>
                                    </li>
                                }

                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="/enrolments?page=@i&pageSize=@(Model.PageSize)">@i</a>
                                    </li>
                                }

                                @if (endPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <span class="page-link"><em class="icon ni ni-more-h"></em></span>
                                    </li>
                                    <li class="page-item">
                                        <a class="page-link" href="/enrolments?page=@Model.TotalPages">@Model.TotalPages</a>
                                    </li>
                                }

                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/enrolments?page=@(Model.CurrentPage + 1)&pageSize=@(Model.PageSize)">Next</a>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="g">
                            <div class="pagination-goto d-flex justify-content-center justify-content-md-start gx-3">
                                <div>Page</div>
                                <div>
                                    <select class="form-select js-select2"
                                            data-search="on"
                                            data-dropdown="xs center"
                                            onchange="location.href='/enrolments?page=' + this.value + '&pageSize=@(Model.PageSize)'">
                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            <option value="@i" @(Model.CurrentPage == i ? "selected" : "")>
                                                @i
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div>OF @Model.TotalPages</div>
                            </div>
                        </div><!-- .pagination-goto -->
                    </div><!-- .nk-block-between -->
                </div><!-- .card-inner -->
            </div><!-- .card-inner-group -->
        </div><!-- .card -->
    </div><!-- .nk-block -->
</div>

@section Scripts
{
    <script src="~/js/watchlist-table.js"></script>
}
