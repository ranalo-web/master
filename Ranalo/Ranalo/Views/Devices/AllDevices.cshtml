@using Ranalo.Models
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model DevicesWithDealerViewModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@functions{
   private string SetLockStatusBadge(bool status)
    {
        var statusClass = "";

        if (status == false)
        {
            return "badge badge-dim bg-danger";
        }
        else
        {
            return "badge badge-dim bg-success";
        }

        return statusClass;
    }

    private string SetLockStatusTextBadge(bool status)
    {
        if (status == false)
        {
            return "LOCKED";
        }
        else
        {
            return "UNLOCKED";
        }
    }
    }

<div class="nk-content-body">

    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between">
            <div class="nk-block-head-content">
                <h3 class="nk-block-title page-title">All Devices</h3>
                <div class="nk-block-des text-soft">
                    <p>You have total of @Model?.TotalRecords devices in the system.</p>
                </div>
            </div><!-- .nk-block-head-content -->
            <div class="nk-block-head-content">
                <div class="toggle-wrap nk-block-tools-toggle">
                    <a href="#" class="btn btn-icon btn-trigger toggle-expand me-n1" data-target="pageMenu"><em class="icon ni ni-menu-alt-r"></em></a>
                    <div class="toggle-expand-content" data-content="pageMenu">
                        <ul class="nk-block-tools g-3">
                            <li><a href="#" class="btn btn-white btn-outline-light"><em class="icon ni ni-download-cloud"></em><span>Export</span></a></li>
                            <li class="nk-block-tools-opt">
                                <div class="drodown">
                                    <a href="#" class="dropdown-toggle btn btn-icon btn-primary" data-bs-toggle="dropdown"><em class="icon ni ni-plus"></em></a>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        <ul class="link-list-opt no-bdr">
                                            <li><a href="#"><span>Add Customer</span></a></li>
                                            <li><a href="#"><span>Import Customer</span></a></li>
                                        </ul>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div><!-- .toggle-wrap -->
            </div><!-- .nk-block-head-content -->
        </div><!-- .nk-block-between -->
    </div><!-- .nk-block-head -->
    <div class="nk-block">
        <div class="card card-bordered card-stretch">
            <div class="card-inner-group">
                <div class="card-inner position-relative card-tools-toggle">
                    <div class="card-title-group">
                        <div class="card-tools">
                            <div class="form-inline flex-nowrap gx-3">
                                <div class="form-wrap w-150px">
                                    <select class="form-select js-select2" data-search="off" data-placeholder="Bulk Action">
                                        <option value="">Bulk Action</option>
                                        <option value="email">Send Email</option>
                                        <option value="suspend">Suspend</option>
                                        <option value="delete">Delete</option>
                                    </select>
                                </div>
                                <div class="btn-wrap">
                                    <span class="d-none d-md-block"><button class="btn btn-dim btn-outline-light disabled">Apply</button></span>
                                    <span class="d-md-none"><button class="btn btn-dim btn-outline-light btn-icon disabled"><em class="icon ni ni-arrow-right"></em></button></span>
                                </div>
                            </div><!-- .form-inline -->
                        </div><!-- .card-tools -->
                        <div class="card-tools me-n1">
                            <ul class="btn-toolbar gx-1">
                                <li>
                                    <a href="#" class="btn btn-icon search-toggle toggle-search" data-target="search"><em class="icon ni ni-search"></em></a>
                                </li><!-- li -->
                                <li class="btn-toolbar-sep"></li><!-- li -->
                                <li>
                                    <div class="toggle-wrap">
                                        <a href="#" class="btn btn-icon btn-trigger toggle" data-target="cardTools"><em class="icon ni ni-menu-right"></em></a>
                                        <div class="toggle-content" data-content="cardTools">
                                            <ul class="btn-toolbar gx-1">
                                                <li class="toggle-close">
                                                    <a href="#" class="btn btn-icon btn-trigger toggle" data-target="cardTools"><em class="icon ni ni-arrow-left"></em></a>
                                                </li><!-- li -->
                                                <li>
                                                    <div class="dropdown">
                                                        <a href="#" class="btn btn-trigger btn-icon dropdown-toggle" data-bs-toggle="dropdown">
                                                            <div class="dot dot-primary"></div>
                                                            <em class="icon ni ni-filter-alt"></em>
                                                        </a>
                                                        <div class="filter-wg dropdown-menu dropdown-menu-xl dropdown-menu-end">
                                                            <div class="dropdown-head">
                                                                <span class="sub-title dropdown-title">Filter Customers</span>
                                                            </div>
                                                            <div class="dropdown-body dropdown-body-rg">
                                                                <div class="row gx-6 gy-3">
                                                                    <div class="col-6">
                                                                        <div class="custom-control custom-control-sm custom-checkbox">
                                                                            <input type="checkbox" class="custom-control-input" id="hasBalance">
                                                                            <label class="custom-control-label" for="hasBalance"> Have Balance</label>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-6">
                                                                        <div class="custom-control custom-control-sm custom-checkbox">
                                                                            <input type="checkbox" class="custom-control-input" id="hasKYC">
                                                                            <label class="custom-control-label" for="hasKYC"> KYC Verified</label>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-6">
                                                                        <div class="form-group">
                                                                            <label class="overline-title overline-title-alt">Card Type</label>
                                                                            <select class="form-select js-select2">
                                                                                <option value="any">Any Card</option>
                                                                                <option value="Visa">Visa</option>
                                                                                <option value="Mastercard">Mastercard</option>
                                                                                <option value="AmericanExpress">American Express</option>
                                                                            </select>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-6">
                                                                        <div class="form-group">
                                                                            <label class="overline-title overline-title-alt">Status</label>
                                                                            <select class="form-select js-select2">
                                                                                <option value="any">Any Status</option>
                                                                                <option value="new">New</option>
                                                                                <option value="active">Active</option>
                                                                                <option value="suspend">Suspend</option>
                                                                                <option value="deleted">Deleted</option>
                                                                            </select>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-12">
                                                                        <div class="form-group">
                                                                            <button type="button" class="btn btn-secondary">Filter</button>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="dropdown-foot between">
                                                                <a class="clickable" href="#">Reset Filter</a>
                                                                <a href="#">Save Filter</a>
                                                            </div>
                                                        </div><!-- .filter-wg -->
                                                    </div><!-- .dropdown -->
                                                </li><!-- li -->
                                                <li>
                                                    <div class="dropdown">
                                                        <a href="#" class="btn btn-trigger btn-icon dropdown-toggle" data-bs-toggle="dropdown">
                                                            <em class="icon ni ni-setting"></em>
                                                        </a>
                                                        <div class="dropdown-menu dropdown-menu-xs dropdown-menu-end">
                                                            <ul class="link-check">
                                                                <li><span>Show</span></li>
                                                                <li class="@(Model.PageSize == 10 ? "active" : "")"><a href="/alldevices?page=1&pageSize=10">10</a></li>
                                                                <li class="@(Model.PageSize == 20 ? "active" : "")"><a href="/alldevices?page=1&pageSize=20">20</a></li>
                                                                <li class="@(Model.PageSize == 40 ? "active" : "")"><a href="/alldevices?page=1&pageSize=40">40</a></li>
                                                                <li class="@(Model.PageSize == 80 ? "active" : "")"><a href="/alldevices?page=1&pageSize=80">80</a></li>
                                                            </ul>
                                                            <ul class="link-check">
                                                                <li><span>Order</span></li>
                                                                <li class="active"><a href="#">DESC</a></li>
                                                                <li><a href="#">ASC</a></li>
                                                            </ul>
                                                        </div>
                                                    </div><!-- .dropdown -->
                                                </li><!-- li -->
                                            </ul><!-- .btn-toolbar -->
                                        </div><!-- .toggle-content -->
                                    </div><!-- .toggle-wrap -->
                                </li><!-- li -->
                            </ul><!-- .btn-toolbar -->
                        </div><!-- .card-tools -->
                    </div><!-- .card-title-group -->
                    <div class="card-search search-wrap" data-search="search">
                        <div class="card-body">
                            <div class="search-content">
                                <a href="#" class="search-back btn btn-icon toggle-search" data-target="search"><em class="icon ni ni-arrow-left"></em></a>
                                <form action="/alldevices" method="get">
                                    <input name="searchTerm" type="text" class="form-control border-transparent form-focus-none" value="@Model?.SearchTerm" placeholder="Search by name">
                                    <button type="submit" class="search-submit btn btn-icon"><em class="icon ni ni-search"></em></button>
                                </form>
                            </div>
                        </div>
                    </div><!-- .card-search -->
                </div><!-- .card-inner -->

                <div class="card-inner p-0">
                    @if (Model.Errors.Any())
                    {
                        foreach (var error in Model.Errors)
                        {
                            <div class="alert alert-danger alert-icon alert-dismissible">
                                <em class="icon ni ni-cross-circle"></em>
                                <strong>Update failed</strong>! @error.
                                <button class="close" data-bs-dismiss="alert"></button>
                            </div>
                        }
                    }

                    <table class="table table-tranx">
                        <thead>
                            <tr class="tb-tnx-head">
                                <th class="tb-tnx-id"><span class="">Account No</span></th>
                                <th class="tb-tnx-info">
                                    <span class="tb-tnx-desc d-none d-sm-inline-block">
                                        <span>ImeiNo</span>
                                    </span>
                                    <span class="tb-tnx-date d-md-inline-block d-none">
                                        <span class="d-md-none">Date</span>
                                        <span class="d-none d-md-block">
                                            <span>CreatedAt</span>
                                        </span>
                                    </span>
                                </th>
                                <th class="tb-tnx-info">
                                    <span>Dealer Id</span>
                                </th>
                                <th class="tb-tnx-info">
                                    <span>
                                        <span>Dealer Name</span>
                                    </span>
                                </th>
                                <th class="tb-tnx-info">
                                    <span>
                                        <span>Status</span>
                                    </span>
                                </th>
                                <th class="nk-tb-col text">
                                    <span class="sub-text">Actions</span>
                                </th>
                        </thead>
                        @if (Model?.Devices != null)
                        {
                            foreach (var devices in Model.Devices)
                            {
                                <tr class="tb-tnx-item">
                                    <td class="tb-tnx-id">
                                        <a href="#"><span>@devices.DeviceId</span></a>
                                    </td>
                                    <td class="tb-tnx-info">
                                        <div class="tb-tnx-desc">
                                            <span class="title">@devices.ImeiNo</span>
                                        </div>
                                        <div class="tb-tnx-date">
                                            <span class="date">@devices.CreatedAtDate</span>
                                        </div>
                                    </td>
                                    <td class="tb-tnx-info">
                                        <div class="tb-tnx-text">
                                            <span class="title">@devices.DealerId</span>
                                        </div>
                                    </td>
                                    <td class="tb-tnx-info">
                                        <div class="tb-tnx-text">
                                            <span class="title">@devices.DealerName</span>
                                        </div>
                                    </td>
                                    <td class="tb-tnx-info">
                                        <div class="tb-tnx-text">
                                            <span class="@SetLockStatusBadge(devices.Locked)">@SetLockStatusTextBadge(devices.Locked)</span>
                                        </div>
                                    </td>
                                    <td class="tb-tnx-info">
                                        <div class="nk-tb-col nk-tb-col-tools">
                                            <ul class="nk-tb-actions gx-2">
                                                <li>
                                                    <div class="drodown">
                                                        <a href="#" class="btn btn-sm btn-icon btn-trigger dropdown-toggle" data-bs-toggle="dropdown"><em class="icon ni ni-more-h"></em></a>
                                                        <div class="dropdown-menu dropdown-menu-end">
                                                            <ul class="link-list-opt no-bdr">
                                                                <li>
                                                                    <a href="#lock-device"
                                                                       data-id="@devices.DeviceId"
                                                                       data-bs-toggle="modal"><em class="icon ni ni-edit"></em><span>Lock Device</span></a>
                                                                </li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </table>
                </div><!-- .card-inner -->
                <div class="card-inner">
                    <div class="nk-block-between-md g-3">
                        <div class="g">
                            <ul class="pagination justify-content-center justify-content-md-start">
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/alldevices?page=@(Model.CurrentPage - 1)&pageSize=@(Model.PageSize)">Prev</a>
                                    </li>
                                }

                                @{
                                    var maxVisiblePages = 5;
                                    var startPage = Math.Max(1, Model.CurrentPage - 2);
                                    var endPage = Math.Min(Model.TotalPages, startPage + maxVisiblePages - 1);
                                    if (endPage - startPage < maxVisiblePages - 1)
                                    {
                                        startPage = Math.Max(1, endPage - maxVisiblePages + 1);
                                    }
                                }

                                @if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/alldevices?page=1&pageSize=@(Model.PageSize)">1</a>
                                    </li>
                                    <li class="page-item">
                                        <span class="page-link"><em class="icon ni ni-more-h"></em></span>
                                    </li>
                                }

                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="/alldevices?page=@i&pageSize=@(Model.PageSize)">@i</a>
                                    </li>
                                }

                                @if (endPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <span class="page-link"><em class="icon ni ni-more-h"></em></span>
                                    </li>
                                    <li class="page-item">
                                        <a class="page-link" href="/alldevices?page=@Model.TotalPages">@Model.TotalPages</a>
                                    </li>
                                }

                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/alldevices?page=@(Model.CurrentPage + 1)&pageSize=@(Model.PageSize)">Next</a>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="g">
                            <div class="pagination-goto d-flex justify-content-center justify-content-md-start gx-3">
                                <div>Page</div>
                                <div>
                                    <select class="form-select js-select2"
                                            data-search="on"
                                            data-dropdown="xs center"
                                            onchange="location.href='/alldevices?page=' + this.value + '&pageSize=@(Model.PageSize)'">
                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            <option value="@i" @(Model.CurrentPage == i ? "selected" : "")>
                                                @i
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div>OF @Model.TotalPages</div>
                            </div>
                        </div><!-- .pagination-goto -->
                    </div><!-- .nk-block-between -->
                </div><!-- .card-inner -->

            </div>
        </div>
    </div>

</div>

<!-- Lock Device Pop Up-->
<div class="modal fade" tabindex="-1" id="lock-device">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <a href="#" class="close" data-bs-dismiss="modal" aria-label="Close">
                <em class="icon ni ni-cross-sm"></em>
            </a>
            <div class="modal-body modal-body-md">
                <h5 class="modal-title">Lock Device</h5>
                <form action="/adminlock-device" method="post" class="mt-2">
                    <div class="row g-gs">
                        <div class="col-12">
                            <div class="form-group">
                                <label class="form-label" for="modalDeviceId2">Account No.</label>
                                <div class="form-control-wrap">
                                    <input type="text" class="form-control" name="displayDeviceId" readonly id="modalDeviceId2" required>
                                </div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="form-group">
                                <label class="form-label" for="edit-date">Lock Date</label>
                                <div class="form-control-wrap">
                                    <div class="form-icon form-icon-left">
                                        <em class="icon ni ni-calendar"></em>
                                    </div>
                                    <input type="text" name="lockDate" id="lock-date" class="form-control date-picker" data-date-format="yyyy-mm-dd" required>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <ul class="align-center flex-wrap flex-sm-nowrap gx-4 gy-2">
                                <li>
                                    <button type="submit" class="btn btn-lg btn-primary">Lock Device</button>
                                </li>
                                <li>
                                    <a href="#" data-bs-dismiss="modal" class="link link-gray">Cancel</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div><!-- .Edit Modal-Content -->
@section Scripts
{
    <script>
        //Lock Device
            document.addEventListener("DOMContentLoaded", function () {
                            var modal1 = document.getElementById('lock-device');
            modal1.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget; // Button that triggered the modal
                var deviceId = button.getAttribute('data-id');
                    var name = button.getAttribute('data-name');
                    document.getElementById('modalDeviceId2').value = deviceId;
                    document.getElementById('modalFirstName2').value = name;
            });
            });
    </script>
 }
