@using Ranalo.Models
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model DevicesWithDealerViewModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@functions {
    private string FormartUtcDate(string? date)
    {
        if (date == null) return "-";
        // Parse using exact format and culture
        DateTime parsedDate = DateTime.ParseExact(
            date.Replace(" UTC", ""),   // remove UTC label before parsing
        "dd-MM-yy HH:mm:ss",
        System.Globalization.CultureInfo.InvariantCulture,
        System.Globalization.DateTimeStyles.AssumeUniversal | System.Globalization.DateTimeStyles.AdjustToUniversal
    );

        // Format to desired output
        return parsedDate.ToString("dd/MM/yyyy HH:mm:ss");
    }

    private string SetLockStatusBadge(bool status)
    {
        var statusClass = "";

        if (status == true)
        {
            return "badge badge-dim bg-danger";
        }
        else
        {
            return "badge badge-dim bg-success";
        }

        return statusClass;
    }

    private string SetLockStatusTextBadge(bool status)
    {
        if (status == true)
        {
            return "LOCKED";
        }
        else
        {
            return "UNLOCKED";
        }
    }

    public string FormartDateWithT(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return "-";
        input = input.Replace("T", " ");

        // Parse it
        DateTime parsedDate = DateTime.ParseExact(
            input,
            "dd/MM/yyyy HH:mm:ss",
            System.Globalization.CultureInfo.InvariantCulture
        );

        // Format to desired string
        return parsedDate.ToString("dd/MM/yyyy HH:mm:ss");
    }
}

<link rel="stylesheet" href="~/css/watchlist-table.css?v=2">

<div class="nk-content-body">

    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between">
            <div class="nk-block-head-content">
                <h3 class="nk-block-title page-title">Devices No Payments</h3>
                <div class="nk-block-des text-soft">
                    <p>You have total of @Model?.TotalRecords devices that do not have a matching order.</p>
                </div>
            </div><!-- .nk-block-head-content -->
            <div class="nk-block-head-content">
                <div class="toggle-wrap nk-block-tools-toggle">
                    <a href="#" class="btn btn-icon btn-trigger toggle-expand me-n1" data-target="pageMenu"><em class="icon ni ni-menu-alt-r"></em></a>
                    <div class="toggle-expand-content" data-content="pageMenu">
                        <ul class="nk-block-tools g-3">
                            <li><a href="#" class="btn btn-white btn-outline-light"><em class="icon ni ni-download-cloud"></em><span>Export</span></a></li>
                            <li class="nk-block-tools-opt">
                                <div class="drodown">
                                    <a href="#" class="dropdown-toggle btn btn-icon btn-primary" data-bs-toggle="dropdown"><em class="icon ni ni-plus"></em></a>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        <ul class="link-list-opt no-bdr">
                                            <li><a href="#"><span>Add Customer</span></a></li>
                                            <li><a href="#"><span>Import Customer</span></a></li>
                                        </ul>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div><!-- .toggle-wrap -->
            </div><!-- .nk-block-head-content -->
        </div><!-- .nk-block-between -->
    </div><!-- .nk-block-head -->
    <div class="nk-block">
        <div class="card card-bordered card-stretch">
            <div class="card-inner-group">
                <div class="card-inner position-relative card-tools-toggle">
                    <div class="card-title-group">
                        <div class="card-tools">
                            <div class="form-inline flex-nowrap gx-3">
                                <div class="form-wrap w-150px">
                                    <select class="form-select js-select2" data-search="off" data-placeholder="Bulk Action">
                                        <option value="">Bulk Action</option>
                                        <option value="email">Send Email</option>
                                        <option value="suspend">Suspend</option>
                                        <option value="delete">Delete</option>
                                    </select>
                                </div>
                                <div class="btn-wrap">
                                    <span class="d-none d-md-block"><button class="btn btn-dim btn-outline-light disabled">Apply</button></span>
                                    <span class="d-md-none"><button class="btn btn-dim btn-outline-light btn-icon disabled"><em class="icon ni ni-arrow-right"></em></button></span>
                                </div>
                            </div><!-- .form-inline -->
                        </div><!-- .card-tools -->
                        <div class="card-tools me-n1">
                            <ul class="btn-toolbar gx-1">
                                <li>
                                    <a href="#" class="btn btn-icon search-toggle toggle-search" data-target="search"><em class="icon ni ni-search"></em></a>
                                </li><!-- li -->
                                <li class="btn-toolbar-sep"></li><!-- li -->
                                <li>
                                    <div class="toggle-wrap">
                                        <a href="#" class="btn btn-icon btn-trigger toggle" data-target="cardTools"><em class="icon ni ni-menu-right"></em></a>
                                        <div class="toggle-content" data-content="cardTools">
                                            <ul class="btn-toolbar gx-1">
                                                <li class="toggle-close">
                                                    <a href="#" class="btn btn-icon btn-trigger toggle" data-target="cardTools"><em class="icon ni ni-arrow-left"></em></a>
                                                </li><!-- li -->
                                                <li>
                                                    <div class="dropdown">
                                                        <a href="#" class="btn btn-trigger btn-icon dropdown-toggle" data-bs-toggle="dropdown">
                                                            <em class="icon ni ni-setting"></em>
                                                        </a>
                                                        <div class="dropdown-menu dropdown-menu-xs dropdown-menu-end">
                                                            <ul class="link-check">
                                                                <li><span>Show</span></li>
                                                                <li class="@(Model.PageSize == 10 ? "active" : "")"><a href="/devices-with-no-orders?page=1&pageSize=10">10</a></li>
                                                                <li class="@(Model.PageSize == 20 ? "active" : "")"><a href="/devices-with-no-orders?page=1&pageSize=20">20</a></li>
                                                                <li class="@(Model.PageSize == 40 ? "active" : "")"><a href="/devices-with-no-orders?page=1&pageSize=40">40</a></li>
                                                                <li class="@(Model.PageSize == 80 ? "active" : "")"><a href="/devices-with-no-orders?page=1&pageSize=80">80</a></li>
                                                            </ul>
                                                            <ul class="link-check">
                                                                <li><span>Order</span></li>
                                                                <li class="active"><a href="#">DESC</a></li>
                                                                <li><a href="#">ASC</a></li>
                                                            </ul>
                                                        </div>
                                                    </div><!-- .dropdown -->
                                                </li><!-- li -->
                                            </ul><!-- .btn-toolbar -->
                                        </div><!-- .toggle-content -->
                                    </div><!-- .toggle-wrap -->
                                </li><!-- li -->
                            </ul><!-- .btn-toolbar -->
                        </div><!-- .card-tools -->
                    </div><!-- .card-title-group -->
                    <div class="card-search search-wrap" data-search="search">
                        <div class="card-body">
                            <div class="search-content">
                                <a href="#" class="search-back btn btn-icon toggle-search" data-target="search"><em class="icon ni ni-arrow-left"></em></a>
                                <form action="/devices-with-no-contracts" method="get">
                                    <input name="searchTerm" type="text" class="form-control border-transparent form-focus-none" value="@Model?.SearchTerm" placeholder="Search by name">
                                    <button type="submit" class="search-submit btn btn-icon"><em class="icon ni ni-search"></em></button>
                                </form>
                            </div>
                        </div>
                    </div><!-- .card-search -->
                </div><!-- .card-inner -->

                <div class="card-inner p-0">
                    @if (Model.Errors.Any())
                    {
                        foreach (var error in Model.Errors)
                        {
                            <div class="alert alert-danger alert-icon alert-dismissible">
                                <em class="icon ni ni-cross-circle"></em>
                                <strong>Update failed</strong>! @error.
                                <button class="close" data-bs-dismiss="alert"></button>
                            </div>
                        }
                    }

                    <table class="table mb-0" style="white-space:nowrap;" data-key="devices-no-payments" data-page-size="@Model?.PageSize">
                        <thead>
                            <tr>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Account No</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">IMEI</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Dealer ID</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Dealer Name</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Enrolled On</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Last Connected</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Next Lock</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Status</th>
                                <th class="wl-th"></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (Model?.Devices != null)
                        {
                            foreach (var devices in Model.Devices)
                            {
                                <tr>
                                    <td><a href="/account-details/@devices.DeviceId" class="fw-medium">@devices.DeviceId</a></td>
                                    <td>@(string.IsNullOrWhiteSpace(devices.ImeiNo) ? "-" : devices.ImeiNo)</td>
                                    <td>@devices.DealerId</td>
                                    <td>@devices.DealerName</td>
                                    <td>@FormartUtcDate(devices.EnrolledOn)</td>
                                    <td>@FormartUtcDate(devices.LastConnectedAt)</td>
                                    <td>@FormartDateWithT(devices?.NextLockDateIsoFormat)</td>
                                    <td><span class="@SetLockStatusBadge(devices.Locked)">@SetLockStatusTextBadge(devices.Locked)</span></td>
                                    <td class="text-end">
                                        <div class="drodown">
                                            <a href="#" class="btn btn-sm btn-icon btn-trigger dropdown-toggle" data-bs-toggle="dropdown"><em class="icon ni ni-more-h"></em></a>
                                            <div class="dropdown-menu dropdown-menu-end">
                                                <ul class="link-list-opt no-bdr">
                                                    <li><a href="/account-details/@devices.DeviceId"><em class="icon ni ni-eye"></em><span>View Details</span></a></li>
                                                    <li>
                                                        <a href="#lock-device"
                                                           data-id="@devices.DeviceId"
                                                           data-bs-toggle="modal"><em class="icon ni ni-edit"></em><span>Lock Device</span></a>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div><!-- .card-inner -->
                <div class="card-inner">
                    <div class="nk-block-between-md g-3">
                        <div class="g">
                            <ul class="pagination justify-content-center justify-content-md-start">
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/devices-nopayments?page=@(Model.CurrentPage - 1)&pageSize=@(Model.PageSize)">Prev</a>
                                    </li>
                                }

                                @{
                                    var maxVisiblePages = 5;
                                    var startPage = Math.Max(1, Model.CurrentPage - 2);
                                    var endPage = Math.Min(Model.TotalPages, startPage + maxVisiblePages - 1);
                                    if (endPage - startPage < maxVisiblePages - 1)
                                    {
                                        startPage = Math.Max(1, endPage - maxVisiblePages + 1);
                                    }
                                }

                                @if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/devices-nopayments?page=1&pageSize=@(Model.PageSize)">1</a>
                                    </li>
                                    <li class="page-item">
                                        <span class="page-link"><em class="icon ni ni-more-h"></em></span>
                                    </li>
                                }

                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="/devices-nopayments?page=@i&pageSize=@(Model.PageSize)">@i</a>
                                    </li>
                                }

                                @if (endPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <span class="page-link"><em class="icon ni ni-more-h"></em></span>
                                    </li>
                                    <li class="page-item">
                                        <a class="page-link" href="/devices-nopayments?page=@Model.TotalPages">@Model.TotalPages</a>
                                    </li>
                                }

                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/devices-nopayments?page=@(Model.CurrentPage + 1)&pageSize=@(Model.PageSize)">Next</a>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="g">
                            <div class="pagination-goto d-flex justify-content-center justify-content-md-start gx-3">
                                <div>Page</div>
                                <div>
                                    <select class="form-select js-select2"
                                            data-search="on"
                                            data-dropdown="xs center"
                                            onchange="location.href='/devices-nopayments?page=' + this.value + '&pageSize=@(Model.PageSize)'">
                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            <option value="@i" @(Model.CurrentPage == i ? "selected" : "")>
                                                @i
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div>OF @Model.TotalPages</div>
                            </div>
                        </div><!-- .pagination-goto -->
                    </div><!-- .nk-block-between -->
                </div><!-- .card-inner -->

            </div>
        </div>
    </div>

</div>

<!-- Lock Device Pop Up-->
<div class="modal fade" tabindex="-1" id="lock-device">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <a href="#" class="close" data-bs-dismiss="modal" aria-label="Close">
                <em class="icon ni ni-cross-sm"></em>
            </a>
            <div class="modal-body modal-body-md">
                <h5 class="modal-title">Lock Device</h5>
                <form action="/lock-device" method="post" class="mt-2">
                    <div class="row g-gs">
                        <div class="col-12">
                            <div class="form-group">
                                <label class="form-label" for="modalDeviceId2">Account No.</label>
                                <div class="form-control-wrap">
                                    <input type="text" class="form-control" name="displayDeviceId" readonly id="modalDeviceId2" required>
                                </div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="form-group">
                                 <label class="form-label" for="edit-date">Lock Date</label>
                                <div class="form-control-wrap">
                                    <div class="form-icon form-icon-left">
                                        <em class="icon ni ni-calendar"></em>
                                    </div>
                                    <input type="text" name="lockDate" id="lock-date" class="form-control date-picker" data-date-format="yyyy-mm-dd" required>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <ul class="align-center flex-wrap flex-sm-nowrap gx-4 gy-2">
                                <li>
                                    <button type="submit" class="btn btn-lg btn-primary">Lock Device</button>
                                </li>
                                <li>
                                    <a href="#" data-bs-dismiss="modal" class="link link-gray">Cancel</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div><!-- .Edit Modal-Content -->

@section Scripts
            {
    <script>
        // Populate the modal fields directly from the triggering link's click,
        // rather than the modal's own 'show.bs.modal' event -- this app's
        // bundled Bootstrap build doesn't dispatch that as a native
        // CustomEvent, so a listener on the modal element never fires.
        document.addEventListener("DOMContentLoaded", function () {
            document.addEventListener('click', function (event) {
                var trigger = event.target.closest('a[data-bs-toggle="modal"][href="#lock-device"]');
                if (!trigger) return;

                document.getElementById('modalDeviceId2').value = trigger.getAttribute('data-id') || '';
            });
        });
    </script>
 }

