@using Ranalo.DataStore.DataModels
@using Ranalo.Models
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model UsersViewModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@functions {

    private string SetStatusBadge(UserStatus? status)
    {
        var statusClass = "";
        switch (status)
        {
            case UserStatus.Active:
                statusClass = "tb-status text-success";
                break;
            case UserStatus.Pending:
                statusClass = "tb-status text-warning";
                break;
            case UserStatus.Inactive:
                statusClass = "tb-status text-info";
                break;
            case UserStatus.Suspended:
                statusClass = "tb-status text-danger";
                break;
            default:
                statusClass = "tb-status text-danger";
                break;
        }

        return statusClass;
    }
    private string SetStatusText(UserStatus? status)
    {
        var statusClass = "";
        switch (status)
        {
            case UserStatus.Active:
                statusClass = "Active";
                break;
            case UserStatus.Pending:
                statusClass = "Pending";
                break;
            case UserStatus.Inactive:
                statusClass = "Inactive";
                break;
            case UserStatus.Suspended:
                statusClass = "Suspended";
                break;
            default:
                statusClass = "No Status";
                break;
        }

        return statusClass;
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return string.Empty;

        // Split by spaces and take first character of each word
        var initials = fullName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(word => char.ToUpper(word[0]))
            .Take(2) // only take first 2 initials
            .ToArray();

        return new string(initials);
    }
}

<link rel="stylesheet" href="~/css/watchlist-table.css?v=4">

<div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between">
            <div class="nk-block-head-content">
                <h3 class="nk-block-title page-title">Users</h3>
                <div class="nk-block-des text-soft">
                    <p>@Model.TotalRecords.ToString("N0") @(Model.Suspended ? "suspended" : "active") login@(Model.TotalRecords == 1 ? "" : "s")@(string.IsNullOrEmpty(Model.SearchTerm) ? "" : $" matching \"{Model.SearchTerm}\""). @(Model.Suspended ? "" : "Most recently seen first.")</p>
                </div>
                @{ var userSearch = Uri.EscapeDataString(Model.SearchTerm ?? ""); }
                <div class="btn-group mt-1" role="group" aria-label="Active or suspended logins">
                    <a href="/users?searchTerm=@userSearch" class="btn btn-sm @(Model.Suspended ? "btn-outline-light btn-white" : "btn-primary")">Active (@Model.ActiveCount)</a>
                    <a href="/users?suspended=true&searchTerm=@userSearch" class="btn btn-sm @(Model.Suspended ? "btn-primary" : "btn-outline-light btn-white")">Suspended (@Model.SuspendedCount)</a>
                </div>
            </div><!-- .nk-block-head-content -->
            <div class="nk-block-head-content">
                <div class="toggle-wrap nk-block-tools-toggle">
                    <a href="#" class="btn btn-icon btn-trigger toggle-expand me-n1" data-target="pageMenu"><em class="icon ni ni-menu-alt-r"></em></a>
                    <div class="toggle-expand-content" data-content="pageMenu">
                        <ul class="nk-block-tools g-3">
                            @* Admins add any role; dealers add their own agents and collectors (UserAdminRules). *@
                            @if (ViewBag.IsAdmin == true || ViewBag.IsDealer == true)
                            {
                                <li><a href="/adduser" class="btn btn-primary"><em class="icon ni ni-user-add"></em><span>Add User</span></a></li>
                            }
                        </ul>
                    </div>
                </div><!-- .toggle-wrap -->
            </div><!-- .nk-block-head-content -->
        </div><!-- .nk-block-between -->
    </div><!-- .nk-block-head -->
    @if (ViewBag.ResetRequests is List<Ranalo.DataStore.PasswordResetRequest> resetRequests && resetRequests.Any())
    {
        <div class="alert alert-warning alert-icon">
            <em class="icon ni ni-alert-circle"></em>
            <strong>Password reset requested:</strong>
            @foreach (var r in resetRequests)
            {
                <a href="/users/@r.UserId/edit" class="ms-2">@r.Name @r.LastName (@r.Email, @r.RequestedAtUtc.ToString("dd MMM HH:mm") UTC)</a>
            }
        </div>
    }
    <div class="nk-block">
        <div class="card card-bordered card-stretch">
            <div class="card-inner-group">
                <div class="card-inner position-relative card-tools-toggle">
                    <div class="card-title-group">
                        <div class="card-tools me-n1">
                            <a href="#" class="btn btn-icon search-toggle toggle-search" data-target="search"><em class="icon ni ni-search"></em></a>
                        </div>
                    </div><!-- .card-title-group -->
                    <div class="card-search search-wrap" data-search="search">
                        <div class="card-body">
                            <div class="search-content">
                                <a href="#" class="search-back btn btn-icon toggle-search" data-target="search"><em class="icon ni ni-arrow-left"></em></a>
                                <form action="/users" method="get">
                                    @if (Model.Suspended) { <input type="hidden" name="suspended" value="true"> }
                                    <input name="searchTerm" type="text" class="form-control border-transparent form-focus-none" value="@ViewBag.SearchTerm" placeholder="Search by name, email or phone">
                                    <button type="submit" class="search-submit btn btn-icon"><em class="icon ni ni-search"></em></button>
                                </form>
                            </div>
                        </div>
                    </div><!-- .card-search -->
                </div><!-- .card-inner -->
                <div class="card-inner p-0">
                    <div class="table-responsive">
                    <table class="table mb-0" style="white-space:nowrap;" data-key="users" data-page-size="10">
                        <thead>
                            <tr>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">User</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Role</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Dealer</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Phone</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Last Seen</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Last Login</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Status</th>
                                <th class="wl-th"></th>
                            </tr>
                        </thead>
                        <tbody>
                        @{
                            // SetViewBags has set a dealer's DealerId to their dealer.
                            var actor = Context.Items["UserSettings"] as Ranalo.DataStore.DataModels.User;
                        }
                        @if (Model.Users == null || Model.Users.Count == 0)
                        {
                            <tr><td colspan="9" class="text-center text-soft py-4">@(Model.Suspended ? "No suspended logins." : "No logins found.")</td></tr>
                        }
                        @foreach (var user in Model.Users ?? new List<Ranalo.DataStore.DataModels.User>())
                        {
                            <tr>
                                <td>
                                    <span class="fw-medium">@(string.IsNullOrWhiteSpace((user.Name + " " + user.LastName).Trim()) ? "(no name)" : (user.Name + " " + user.LastName).Trim())</span>
                                    <div class="small text-soft">@(string.IsNullOrWhiteSpace(user.Email) ? "-" : user.Email.Trim())</div>
                                </td>
                                <td>@user.RoleId</td>
                                <td>@Model.DealerName(user.DealerId)</td>
                                <td>@(string.IsNullOrWhiteSpace(user.Phone) ? "-" : user.Phone)</td>
                                @* Stored in UTC; shown in Kenya time, with the hour, so you can see who is using the system. *@
                                <td data-sort="@(user.LastSeen?.ToString("yyyyMMddHHmmss") ?? "0")">
                                    <span class="@(Ranalo.Services.LastSeenRules.ShouldStamp(user.LastSeen, DateTime.UtcNow) ? "" : "badge bg-success")">@(Ranalo.Services.LastSeenRules.Describe(user.LastSeen, DateTime.UtcNow))</span>
                                </td>
                                <td data-sort="@(user.LastLogin?.ToString("yyyyMMddHHmmss") ?? "0")">@(user.LastLogin?.AddHours(3).ToString("dd MMM yyyy HH:mm") ?? "Never")</td>
                                <td><span class="@SetStatusBadge(user.Status)">@SetStatusText(user.Status)</span></td>
                                <td class="text-end">
                                    @if (actor != null && actor.UserId == user.UserId)
                                    {
                                        <a href="/account" class="btn btn-sm btn-outline-light">My Account</a>
                                    }
                                    else if (actor != null && Ranalo.Services.UserAdminRules.CanManage(actor, actor.DealerId, user))
                                    {
                                        <a href="/users/@user.UserId/edit" class="btn btn-sm btn-primary">Edit</a>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    </div><!-- .table-responsive -->
                </div><!-- .card-inner -->
                <div class="card-inner">
                    @{
                        string PageLink(int p) => Url.Action("Users", "Home", new { page = p, searchTerm = ViewBag.SearchTerm, suspended = Model.Suspended ? true : (bool?)null })!;
                        var maxVisiblePages = 5;
                        var startPage = Math.Max(1, Model.CurrentPage - 2);
                        var endPage = Math.Min(Model.TotalPages, startPage + maxVisiblePages - 1);
                        if (endPage - startPage < maxVisiblePages - 1)
                        {
                            startPage = Math.Max(1, endPage - maxVisiblePages + 1);
                        }
                    }
                    <ul class="pagination justify-content-center justify-content-md-start">
                        @if (Model.CurrentPage > 1)
                        {
                            <li class="page-item"><a class="page-link" href="@PageLink(Model.CurrentPage - 1)">Prev</a></li>
                        }
                        @if (startPage > 1)
                        {
                            <li class="page-item"><a class="page-link" href="@PageLink(1)">1</a></li>
                            <li class="page-item"><span class="page-link"><em class="icon ni ni-more-h"></em></span></li>
                        }
                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")"><a class="page-link" href="@PageLink(i)">@i</a></li>
                        }
                        @if (endPage < Model.TotalPages)
                        {
                            <li class="page-item"><span class="page-link"><em class="icon ni ni-more-h"></em></span></li>
                            <li class="page-item"><a class="page-link" href="@PageLink(Model.TotalPages)">@Model.TotalPages</a></li>
                        }
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <li class="page-item"><a class="page-link" href="@PageLink(Model.CurrentPage + 1)">Next</a></li>
                        }
                    </ul><!-- .pagination -->
                </div><!-- .card-inner -->
            </div><!-- .card-inner-group -->
        </div><!-- .card -->
    </div><!-- .nk-block -->
</div>

@section Scripts
{
    <script src="~/js/watchlist-table.js"></script>
}
