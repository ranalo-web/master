@using Ranalo.DataStore.DataModels
@using Ranalo.Models
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model UsersViewModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@functions {

    private string SetStatusBadge(UserStatus? status)
    {
        var statusClass = "";
        switch (status)
        {
            case UserStatus.Active:
                statusClass = "tb-status text-success";
                break;
            case UserStatus.Pending:
                statusClass = "tb-status text-warning";
                break;
            case UserStatus.Inactive:
                statusClass = "tb-status text-info";
                break;
            case UserStatus.Suspended:
                statusClass = "tb-status text-danger";
                break;
            default:
                statusClass = "tb-status text-danger";
                break;
        }

        return statusClass;
    }
    private string SetStatusText(UserStatus? status)
    {
        var statusClass = "";
        switch (status)
        {
            case UserStatus.Active:
                statusClass = "Active";
                break;
            case UserStatus.Pending:
                statusClass = "Pending";
                break;
            case UserStatus.Inactive:
                statusClass = "Inactive";
                break;
            case UserStatus.Suspended:
                statusClass = "Suspended";
                break;
            default:
                statusClass = "No Status";
                break;
        }

        return statusClass;
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return string.Empty;

        // Split by spaces and take first character of each word
        var initials = fullName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(word => char.ToUpper(word[0]))
            .Take(2) // only take first 2 initials
            .ToArray();

        return new string(initials);
    }
}

<div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between">
            <div class="nk-block-head-content">
                <h3 class="nk-block-title page-title">Users Lists</h3>
                <div class="nk-block-des text-soft">
                    <p>You have total @Model.TotalRecords.ToString("N0") users.</p>
                </div>
            </div><!-- .nk-block-head-content -->
            <div class="nk-block-head-content">
                <div class="toggle-wrap nk-block-tools-toggle">
                    <a href="#" class="btn btn-icon btn-trigger toggle-expand me-n1" data-target="pageMenu"><em class="icon ni ni-menu-alt-r"></em></a>
                    <div class="toggle-expand-content" data-content="pageMenu">
                        <ul class="nk-block-tools g-3">
                            <li><a href="#" class="btn btn-white btn-outline-light"><em class="icon ni ni-download-cloud"></em><span>Export</span></a></li>
                        </ul>
                    </div>
                </div><!-- .toggle-wrap -->
            </div><!-- .nk-block-head-content -->
        </div><!-- .nk-block-between -->
    </div><!-- .nk-block-head -->
    <div class="nk-block">
        <div class="card card-bordered card-stretch">
            <div class="card-inner-group">
                <div class="card-inner position-relative card-tools-toggle">
                    <div class="card-title-group">
                        <div class="card-tools me-n1">
                            <a href="#" class="btn btn-icon search-toggle toggle-search" data-target="search"><em class="icon ni ni-search"></em></a>
                        </div>
                    </div><!-- .card-title-group -->
                    <div class="card-search search-wrap" data-search="search">
                        <div class="card-body">
                            <div class="search-content">
                                <a href="#" class="search-back btn btn-icon toggle-search" data-target="search"><em class="icon ni ni-arrow-left"></em></a>
                                <form action="/users" method="get">
                                    <input name="searchTerm" type="text" class="form-control border-transparent form-focus-none" value="@ViewBag.SearchTerm" placeholder="Search by name or email">
                                    <button type="submit" class="search-submit btn btn-icon"><em class="icon ni ni-search"></em></button>
                                </form>
                            </div>
                        </div>
                    </div><!-- .card-search -->
                </div><!-- .card-inner -->
                <div class="card-inner p-0">
                    <div class="nk-tb-list nk-tb-ulist is-compact">
                        <div class="nk-tb-item nk-tb-head">
                            <div class="nk-tb-col"><span class="sub-text">User</span></div>
                            <div class="nk-tb-col tb-col-md"><span class="sub-text">Role</span></div>
                            <div class="nk-tb-col tb-col-sm"><span class="sub-text">Email</span></div>
                            <div class="nk-tb-col tb-col-md"><span class="sub-text">Phone</span></div>
                            <div class="nk-tb-col tb-col-xxl"><span class="sub-text">City</span></div>
                            <div class="nk-tb-col tb-col-lg"><span class="sub-text">Verified</span></div>
                            <div class="nk-tb-col tb-col-xxl"><span class="sub-text">Last Login</span></div>
                            <div class="nk-tb-col"><span class="sub-text">Status</span></div>
                        </div><!-- .nk-tb-item -->
                        @foreach (var user in Model.Users)
                        {
                            <div class="nk-tb-item">
                                <div class="nk-tb-col">
                                    <div class="user-card">
                                        <div class="user-avatar xs bg-primary">
                                            <span>@GetInitials(user.Name + " " + user.LastName)</span>
                                        </div>
                                        <div class="user-name">
                                            <span class="tb-lead">@user.Name @user.LastName</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="nk-tb-col tb-col-md">
                                    <span>@user.RoleId</span>
                                </div>
                                <div class="nk-tb-col tb-col-sm">
                                    <span>@user.Email</span>
                                </div>
                                <div class="nk-tb-col tb-col-md">
                                    <span>@user.Phone</span>
                                </div>
                                <div class="nk-tb-col tb-col-xxl">
                                    <span>@user.City</span>
                                </div>
                                <div class="nk-tb-col tb-col-lg">
                                    <ul class="list-status">
                                        <li><em class="icon text-success ni ni-check-circle"></em> <span>Email</span></li>
                                    </ul>
                                </div>
                                <div class="nk-tb-col tb-col-xxl">
                                    <span>@(user.LastLogin?.ToString("MMM d, yyyy") ?? "Never")</span>
                                </div>
                                <div class="nk-tb-col">
                                    <span class="@SetStatusBadge(user.Status)">@SetStatusText(user.Status)</span>
                                </div>
                            </div>

                            <!-- .nk-tb-item -->
                        }


                    </div><!-- .nk-tb-list -->
                </div><!-- .card-inner -->
                <div class="card-inner">
                    @{
                        string PageLink(int p) => Url.Action("Users", "Home", new { page = p, searchTerm = ViewBag.SearchTerm })!;
                        var maxVisiblePages = 5;
                        var startPage = Math.Max(1, Model.CurrentPage - 2);
                        var endPage = Math.Min(Model.TotalPages, startPage + maxVisiblePages - 1);
                        if (endPage - startPage < maxVisiblePages - 1)
                        {
                            startPage = Math.Max(1, endPage - maxVisiblePages + 1);
                        }
                    }
                    <ul class="pagination justify-content-center justify-content-md-start">
                        @if (Model.CurrentPage > 1)
                        {
                            <li class="page-item"><a class="page-link" href="@PageLink(Model.CurrentPage - 1)">Prev</a></li>
                        }
                        @if (startPage > 1)
                        {
                            <li class="page-item"><a class="page-link" href="@PageLink(1)">1</a></li>
                            <li class="page-item"><span class="page-link"><em class="icon ni ni-more-h"></em></span></li>
                        }
                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")"><a class="page-link" href="@PageLink(i)">@i</a></li>
                        }
                        @if (endPage < Model.TotalPages)
                        {
                            <li class="page-item"><span class="page-link"><em class="icon ni ni-more-h"></em></span></li>
                            <li class="page-item"><a class="page-link" href="@PageLink(Model.TotalPages)">@Model.TotalPages</a></li>
                        }
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <li class="page-item"><a class="page-link" href="@PageLink(Model.CurrentPage + 1)">Next</a></li>
                        }
                    </ul><!-- .pagination -->
                </div><!-- .card-inner -->
            </div><!-- .card-inner-group -->
        </div><!-- .card -->
    </div><!-- .nk-block -->
</div>
