@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var posted = ViewBag.Posted as Microsoft.AspNetCore.Http.IFormCollection;
    string Val(string key) => posted?[key].ToString() ?? "";
    var suggested = ViewBag.SuggestedReference as string ?? "";
}

<div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between">
            <div class="nk-block-head-content">
                <h3 class="nk-block-title page-title">Create Dealer</h3>
                <div class="nk-block-des text-soft">
                    <p>Creates the dealer and their login in one step, linked to each other. The Dealer ID and the login's user ID are generated automatically.</p>
                </div>
            </div>
        </div>
    </div>

    @if (ViewBag.Error is string error)
    {
        <div class="alert alert-danger alert-icon">
            <em class="icon ni ni-cross-circle"></em> <strong>Not saved.</strong> @error
        </div>
    }

    <form action="/adddealer" method="post">
        <div class="nk-block">
            <div class="card card-bordered">
                <div class="card-inner">
                    <h6 class="overline-title text-soft mb-3">Dealer</h6>
                    <div class="row gy-3">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="dealer-name">Dealer name</label>
                                <input type="text" name="companyName" id="dealer-name" class="form-control" required value="@Val("companyName")" placeholder="e.g. Mali Mali" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="dealer-ref">Dealer reference</label>
                                <input type="text" name="dealerReference" id="dealer-ref" class="form-control" required inputmode="numeric" pattern="[0-9]+" value="@suggested" />
                                <span class="form-note">
                                    Pre-filled with the next number in sequence. <strong>If this dealer's phones are locked through Kose, enter their Kose device group number instead</strong>
                                    -- that's how their devices are matched to them. Phones enrolled through this app (Knox / PayTrigger) use whatever is saved here.
                                </span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="dealer-email">Dealer email</label>
                                <input type="email" name="email" id="dealer-email" class="form-control" required value="@Val("email")" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="dealer-phone">Phone</label>
                                <input type="tel" name="phone" id="dealer-phone" class="form-control" value="@Val("phone")" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="dealer-address">Address</label>
                                <input type="text" name="address" id="dealer-address" class="form-control" value="@Val("address")" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="dealer-city">City</label>
                                <input type="text" name="city" id="dealer-city" class="form-control" value="@Val("city")" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="nk-block">
            <div class="card card-bordered">
                <div class="card-inner">
                    <h6 class="overline-title text-soft mb-1">Dealer's login</h6>
                    <p class="text-soft small mb-3">The account the dealer signs in with. It's created with the Dealer role and linked to this dealer automatically.</p>
                    <div class="row gy-3">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="login-name">First name</label>
                                <input type="text" name="loginName" id="login-name" class="form-control" required value="@Val("loginName")" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="login-lastname">Last name</label>
                                <input type="text" name="loginLastName" id="login-lastname" class="form-control" value="@Val("loginLastName")" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="login-email">Login email</label>
                                <input type="email" name="loginEmail" id="login-email" class="form-control" value="@Val("loginEmail")" placeholder="Same as the dealer email if left blank" />
                            </div>
                        </div>
                        <div class="col-sm-6"></div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="login-password">Password</label>
                                <input type="password" name="loginPassword" id="login-password" class="form-control" required autocomplete="new-password" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="form-label" for="login-password2">Confirm password</label>
                                <input type="password" name="loginPasswordConfirm" id="login-password2" class="form-control" required autocomplete="new-password" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="nk-block">
            <button type="submit" class="btn btn-lg btn-primary">Create dealer and login</button>
            <a href="/dealers" class="btn btn-lg btn-outline-light btn-white ms-2">Cancel</a>
        </div>
    </form>
</div>
