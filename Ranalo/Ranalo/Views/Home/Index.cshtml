@section Scripts
{
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var table = document.querySelector('.nk-tb-list');
        if (!table) return;
        var headerRow = table.querySelector('.nk-tb-item.nk-tb-head');
        if (!headerRow) return;
        var headers = Array.prototype.slice.call(headerRow.querySelectorAll('.wl-th'));
        var activeHeader = null;
        var activeDir = 1;

        function cellValue(row, index, type) {
            var cell = row.children[index];
            if (!cell) return '';
            var valueEl = cell.querySelector('[data-sort-value]');
            var raw = valueEl ? valueEl.getAttribute('data-sort-value') : cell.textContent.trim();
            if (type === 'date') {
                return new Date(raw).getTime();
            }
            if (type === 'number') {
                return parseFloat(raw.replace(/[^0-9.\-]/g, '')) || 0;
            }
            return raw.toLowerCase();
        }

        headers.forEach(function (th) {
            th.addEventListener('click', function () {
                var index = Array.prototype.indexOf.call(headerRow.children, th);
                var type = th.getAttribute('data-sort-type') || 'text';
                var dir = (activeHeader === th) ? -activeDir : 1;
                activeHeader = th;
                activeDir = dir;

                headers.forEach(function (h) {
                    h.classList.remove('wl-sort-asc', 'wl-sort-desc');
                    var indicator = h.querySelector('.wl-sort-indicator');
                    if (indicator) indicator.textContent = '';
                });
                th.classList.add(dir === 1 ? 'wl-sort-asc' : 'wl-sort-desc');
                var indicator = th.querySelector('.wl-sort-indicator');
                if (indicator) indicator.textContent = dir === 1 ? '▲' : '▼';

                var rows = Array.prototype.slice.call(table.querySelectorAll('.nk-tb-item:not(.nk-tb-head)'));
                rows.sort(function (a, b) {
                    var va = cellValue(a, index, type);
                    var vb = cellValue(b, index, type);
                    if (va < vb) return -1 * dir;
                    if (va > vb) return 1 * dir;
                    return 0;
                });
                rows.forEach(function (row) { table.appendChild(row); });
            });
        });

        var statusHeader = headerRow.querySelector('[data-sort-key="status"]');
        var statusIndex = statusHeader ? Array.prototype.indexOf.call(headerRow.children, statusHeader) : -1;
        var joinedHeader = headerRow.querySelector('[data-sort-key="joined"]');
        var joinedIndex = joinedHeader ? Array.prototype.indexOf.call(headerRow.children, joinedHeader) : -1;
        var statusFilter = document.getElementById('statusFilter');
        var joinedFrom = document.getElementById('joinedFrom');
        var joinedTo = document.getElementById('joinedTo');
        var applyFilterBtn = document.getElementById('applyStatusFilter');
        var resetFilterBtn = document.getElementById('resetStatusFilter');

        function joinedDate(row) {
            if (joinedIndex === -1) return null;
            var cell = row.children[joinedIndex];
            if (!cell) return null;
            var valueEl = cell.querySelector('[data-sort-value]');
            var raw = valueEl ? valueEl.getAttribute('data-sort-value') : cell.textContent.trim();
            var time = new Date(raw).getTime();
            return isNaN(time) ? null : time;
        }

        function applyFilters() {
            var statusValue = statusFilter.value;
            var fromValue = joinedFrom.value ? new Date(joinedFrom.value + 'T00:00:00').getTime() : null;
            var toValue = joinedTo.value ? new Date(joinedTo.value + 'T23:59:59').getTime() : null;
            var rows = table.querySelectorAll('.nk-tb-item:not(.nk-tb-head)');
            rows.forEach(function (row) {
                var visible = true;

                if (statusValue !== 'any' && statusIndex !== -1) {
                    var cell = row.children[statusIndex];
                    var text = cell ? cell.textContent.trim() : '';
                    if (text !== statusValue) visible = false;
                }

                if (visible && (fromValue || toValue)) {
                    var joined = joinedDate(row);
                    if (joined === null) {
                        visible = false;
                    } else {
                        if (fromValue && joined < fromValue) visible = false;
                        if (toValue && joined > toValue) visible = false;
                    }
                }

                row.style.display = visible ? '' : 'none';
            });
        }

        if (applyFilterBtn) {
            applyFilterBtn.addEventListener('click', applyFilters);
        }
        if (resetFilterBtn) {
            resetFilterBtn.addEventListener('click', function (e) {
                e.preventDefault();
                statusFilter.value = 'any';
                joinedFrom.value = '';
                joinedTo.value = '';
                applyFilters();
            });
        }
    });
</script>
}
