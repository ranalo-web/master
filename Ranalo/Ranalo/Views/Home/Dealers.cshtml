@using Ranalo.DataStore.DataModels
@using Ranalo.Models
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model DealersViewModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@functions {

    private string SetStatusBadge(UserStatus? status)
    {
        var statusClass = "";
        switch (status)
        {
            case UserStatus.Active:
                statusClass = "tb-status text-success";
                break;
            case UserStatus.Pending:
                statusClass = "tb-status text-warning";
                break;
            case UserStatus.Inactive:
                statusClass = "tb-status text-info";
                break;
            case UserStatus.Suspended:
                statusClass = "tb-status text-danger";
                break;
            default:
                statusClass = "tb-status text-danger";
                break;
        }

        return statusClass;
    }
    private string SetStatusText(UserStatus? status)
    {
        var statusClass = "";
        switch (status)
        {
            case UserStatus.Active:
                statusClass = "Active";
                break;
            case UserStatus.Pending:
                statusClass = "Pending";
                break;
            case UserStatus.Inactive:
                statusClass = "Inactive";
                break;
            case UserStatus.Suspended:
                statusClass = "Suspended";
                break;
            default:
                statusClass = "No Status";
                break;
        }

        return statusClass;
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return string.Empty;

        // Split by spaces and take first character of each word
        var initials = fullName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(word => char.ToUpper(word[0]))
            .Take(2) // only take first 2 initials
            .ToArray();

        return new string(initials);
    }
}

<link rel="stylesheet" href="~/css/watchlist-table.css?v=4">

<div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between">
            <div class="nk-block-head-content">
                <h3 class="nk-block-title page-title">Dealers Lists</h3>
                <div class="nk-block-des text-soft">
                    <p>You have a total of @Model.TotalRecords @(Model.ShowClosed ? "closed" : "open") dealers@(string.IsNullOrEmpty(Model.SearchTerm) ? "" : $" matching \"{Model.SearchTerm}\"").</p>
                    @{ var dealerSearch = Uri.EscapeDataString(Model.SearchTerm ?? ""); }
                    <div class="btn-group mt-1" role="group" aria-label="Open or closed dealers">
                        <a href="/dealers?pageSize=@Model.PageSize&searchTerm=@dealerSearch" class="btn btn-sm @(Model.ShowClosed ? "btn-outline-light btn-white" : "btn-primary")">Open (@Model.OpenCount)</a>
                        <a href="/dealers?closed=true&pageSize=@Model.PageSize&searchTerm=@dealerSearch" class="btn btn-sm @(Model.ShowClosed ? "btn-primary" : "btn-outline-light btn-white")">Closed (@Model.ClosedCount)</a>
                    </div>
                </div>
            </div><!-- .nk-block-head-content -->
            <div class="nk-block-head-content">
                <div class="toggle-wrap nk-block-tools-toggle">
                    <a href="#" class="btn btn-icon btn-trigger toggle-expand me-n1" data-target="pageMenu"><em class="icon ni ni-menu-alt-r"></em></a>
                    <div class="toggle-expand-content" data-content="pageMenu">
                        <ul class="nk-block-tools g-3">
                            <li><a href="#" class="btn btn-white btn-outline-light"><em class="icon ni ni-download-cloud"></em><span>Export</span></a></li>
                            <li class="nk-block-tools-opt">
                                <div class="drodown">
                                    <a href="#" class="dropdown-toggle btn btn-icon btn-primary" data-bs-toggle="dropdown"><em class="icon ni ni-plus"></em></a>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        <ul class="link-list-opt no-bdr">
                                            <li><a href="/adddealer"><span>Add Dealer</span></a></li>
                                        </ul>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div><!-- .toggle-wrap -->
            </div><!-- .nk-block-head-content -->
        </div><!-- .nk-block-between -->
    </div><!-- .nk-block-head -->
    @if (TempData["DealerSuccess"] is string dealerSuccess)
    {
        <div class="alert alert-success alert-icon alert-dismissible"><em class="icon ni ni-check-circle"></em> @dealerSuccess <button class="close" data-bs-dismiss="alert"></button></div>
    }
    <div class="nk-block">
        <div class="card card-bordered card-stretch">
            <div class="card-inner-group">
                <div class="card-inner position-relative card-tools-toggle">
                    <div class="card-title-group">
                        <div class="card-tools">
                            <div class="form-inline flex-nowrap gx-3">
                                <div class="form-wrap w-150px">
                                    <select class="form-select js-select2" data-search="off" data-placeholder="Bulk Action">
                                        <option value="">Bulk Action</option>
                                        <option value="email">Send Email</option>
                                        <option value="group">Change Group</option>
                                        <option value="suspend">Suspend User</option>
                                        <option value="delete">Delete User</option>
                                    </select>
                                </div>
                                <div class="btn-wrap">
                                    <span class="d-none d-md-block"><button class="btn btn-dim btn-outline-light disabled">Apply</button></span>
                                    <span class="d-md-none"><button class="btn btn-dim btn-outline-light btn-icon disabled"><em class="icon ni ni-arrow-right"></em></button></span>
                                </div>
                            </div><!-- .form-inline -->
                        </div><!-- .card-tools -->
                        <div class="card-tools me-n1">
                            <ul class="btn-toolbar gx-1">
                                <li>
                                    <a href="#" class="btn btn-icon search-toggle toggle-search" data-target="search"><em class="icon ni ni-search"></em></a>
                                </li><!-- li -->
                                <li class="btn-toolbar-sep"></li><!-- li -->
                                <li>
                                    <div class="toggle-wrap">
                                        <a href="#" class="btn btn-icon btn-trigger toggle" data-target="cardTools"><em class="icon ni ni-menu-right"></em></a>
                                        <div class="toggle-content" data-content="cardTools">
                                            <ul class="btn-toolbar gx-1">
                                                <li class="toggle-close">
                                                    <a href="#" class="btn btn-icon btn-trigger toggle" data-target="cardTools"><em class="icon ni ni-arrow-left"></em></a>
                                                </li><!-- li -->
                                                <li>
                                                    <div class="dropdown">
                                                        <a href="#" class="btn btn-trigger btn-icon dropdown-toggle" data-bs-toggle="dropdown">
                                                            <em class="icon ni ni-setting"></em>
                                                        </a>
                                                        <div class="dropdown-menu dropdown-menu-xs dropdown-menu-end">
                                                            <ul class="link-check">
                                                                <li><span>Show</span></li>
                                                                @foreach (var size in DealersViewModel.PageSizes)
                                                                {
                                                                    <li class="@(Model.PageSize == size ? "active" : "")"><a href="/dealers?page=1&pageSize=@size@(PagingLinks.Keep(Context.Request, "pageSize"))">@size</a></li>
                                                                }
                                                            </ul>
                                                        </div>
                                                    </div><!-- .dropdown -->
                                                </li><!-- li -->
                                            </ul><!-- .btn-toolbar -->
                                        </div><!-- .toggle-content -->
                                    </div><!-- .toggle-wrap -->
                                </li><!-- li -->
                            </ul><!-- .btn-toolbar -->
                        </div><!-- .card-tools -->
                    </div><!-- .card-title-group -->
                    <div class="card-search search-wrap" data-search="search">
                        <div class="card-body">
                            <div class="search-content">
                                <a href="#" class="search-back btn btn-icon toggle-search" data-target="search"><em class="icon ni ni-arrow-left"></em></a>
                                <form action="/dealers" method="get" class="d-flex w-100">
                                    <input type="hidden" name="pageSize" value="@Model.PageSize">
                                    @if (Model.ShowClosed) { <input type="hidden" name="closed" value="true"> }
                                    <input name="searchTerm" type="text" value="@Model.SearchTerm" class="form-control border-transparent form-focus-none" placeholder="Search by name, reference, email or phone">
                                    <button type="submit" class="search-submit btn btn-icon"><em class="icon ni ni-search"></em></button>
                                </form>
                            </div>
                        </div>
                    </div><!-- .card-search -->
                </div><!-- .card-inner -->
                <div class="card-inner p-0">
                    <div class="table-responsive">
                    <table class="table mb-0" style="white-space:nowrap;" data-key="dealers" data-page-size="@Model.PageSize">
                        <thead>
                            <tr>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Dealer</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Code</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Sales</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">This month</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">In arrears</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Commission owed</th>
                                <th class="wl-th" onclick="Ranalo.sortTable(this)">Last seen</th>
                                <th class="wl-th"></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (Model.Dealers == null || Model.Dealers.Count == 0)
                        {
                            <tr><td colspan="8" class="text-soft">No dealers found.</td></tr>
                        }
                        @foreach (var dealer in Model.Dealers ?? new List<Ranalo.DataStore.Dealer>())
                        {
                            var st = Model.Stats.TryGetValue(dealer.DealerId, out var found) ? found : new Ranalo.Services.SalesTeamStats();
                            var seenAt = Model.LastSeen.TryGetValue(dealer.DealerId, out var ls) ? ls : null;
                            <tr>
                                <td>
                                    <span class="fw-medium">@dealer.CompanyName</span>
                                    <div class="small text-soft">@(string.Join(" · ", new[] { dealer.Email, dealer.Phone }.Where(x => !string.IsNullOrWhiteSpace(x))))</div>
                                </td>
                                <td>@dealer.DealerReference</td>
                                <td data-sort="@st.Sales">@st.Sales.ToString("N0")</td>
                                <td data-sort="@st.SalesThisMonth">@st.SalesThisMonth.ToString("N0")</td>
                                <td data-sort="@st.DefaultRatePct">
                                    @if (st.Sales > 0)
                                    {
                                        <span class="@(st.CommissionSuspended ? "text-danger fw-medium" : "")">@st.InArrears (@st.DefaultRatePct.ToString("0.#")%)</span>
                                        @if (st.CommissionSuspended) { <div class="small text-danger">Commission suspended</div> }
                                    }
                                    else { <span class="text-soft">-</span> }
                                </td>
                                <td data-sort="@st.Owed">KES @st.Owed.ToString("N0")</td>
                                <td data-sort="@(seenAt?.ToString("yyyyMMddHHmmss") ?? "0")">@Ranalo.Services.LastSeenRules.Describe(seenAt, DateTime.UtcNow)</td>
                                <td class="text-end"><a href="/agent-list?dealerId=@dealer.DealerId" class="btn btn-sm btn-outline-light">Agents</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    </div><!-- .table-responsive -->
                </div><!-- .card-inner -->
                <div class="card-inner">
@{
                        var start = Math.Max(1, Model.CurrentPage - 2);
                        var end = Math.Min(Model.TotalPages, start + 4);
                        start = Math.Max(1, end - 4);
                        string Url(int p) => $"/dealers?page={p}&pageSize={Model.PageSize}" + PagingLinks.Keep(Context.Request, "pageSize");
                    }
                    <div class="nk-block-between-md g-3">
                        <ul class="pagination justify-content-center justify-content-md-start">
                            @if (Model.CurrentPage > 1)
                            {
                                <li class="page-item"><a class="page-link" href="@Url(Model.CurrentPage - 1)">Prev</a></li>
                            }
                            @if (start > 1)
                            {
                                <li class="page-item"><a class="page-link" href="@Url(1)">1</a></li>
                                <li class="page-item"><span class="page-link"><em class="icon ni ni-more-h"></em></span></li>
                            }
                            @for (var i = start; i <= end; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")"><a class="page-link" href="@Url(i)">@i</a></li>
                            }
                            @if (end < Model.TotalPages)
                            {
                                <li class="page-item"><span class="page-link"><em class="icon ni ni-more-h"></em></span></li>
                                <li class="page-item"><a class="page-link" href="@Url(Model.TotalPages)">@Model.TotalPages</a></li>
                            }
                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <li class="page-item"><a class="page-link" href="@Url(Model.CurrentPage + 1)">Next</a></li>
                            }
                        </ul><!-- .pagination -->
                        <div class="text-soft">@Model.TotalRecords dealers · page @Model.CurrentPage of @Model.TotalPages</div>
                    </div>
                </div><!-- .card-inner -->
            </div><!-- .card-inner-group -->
        </div><!-- .card -->
    </div><!-- .nk-block -->
</div>

@section Scripts
{
    <script src="~/js/watchlist-table.js"></script>
}
