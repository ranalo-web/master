@using Ranalo.Models
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model AwaitingApprovalViewModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@functions
{
    private string SetStatusBadge(string status)
    {
        var statusClass = "";
        switch (status)
        {
            case "approval-waiting":
                statusClass = "tb-status text-warning";
                break;
            case "cancelled":
                statusClass = "tb-status text-danger";
                break;
            case "rejected":
                statusClass = "tb-status text-danger";
                break;
            case "approved":
                statusClass = "tb-status text-success";
                break;
            default:
                statusClass = "";
                break;
        }

        return statusClass;
    }

    private string SetSearchTerm()
    {
        if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            return Model.SearchTerm;
        }

        return "Search...";
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "string.Empty";

        // Split by spaces and take first character of each word
        var initials = fullName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(word => char.ToUpper(word[0]))
            .Take(2) // only take first 2 initials
            .ToArray();

        return new string(initials);
    }
}

<div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-between">
            <div class="nk-block-head-content">
                <h3 class="nk-block-title page-title">All Orders</h3>
                <div class="nk-block-des text-soft">
                    <p>You have total @Model?.TotalRecords orders.</p>
                </div>
            </div><!-- .nk-block-head-content -->
            <div class="nk-block-head-content">
                <div class="toggle-wrap nk-block-tools-toggle">
                    <a href="#" class="btn btn-icon btn-trigger toggle-expand me-n1" data-target="pageMenu"><em class="icon ni ni-menu-alt-r"></em></a>
                    <div class="toggle-expand-content" data-content="pageMenu">
                        <ul class="nk-block-tools g-3">
                            <li><a href="#" class="btn btn-white btn-outline-light"><em class="icon ni ni-download-cloud"></em><span>Export</span></a></li>
                            <li class="nk-block-tools-opt">
                                <div class="drodown">
                                    <a href="#" class="dropdown-toggle btn btn-icon btn-primary" data-bs-toggle="dropdown"><em class="icon ni ni-plus"></em></a>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        <ul class="link-list-opt no-bdr">
                                            <li><a href="#"><span>Add Customer</span></a></li>
                                            <li><a href="#"><span>Import Customer</span></a></li>
                                        </ul>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div><!-- .toggle-wrap -->
            </div><!-- .nk-block-head-content -->
        </div><!-- .nk-block-between -->
    </div><!-- .nk-block-head -->
    <div class="nk-block">
        <div class="card card-bordered card-stretch">
            <div class="card-inner-group">
                <div class="card-inner position-relative card-tools-toggle">
                    <div class="card-title-group">
                        <div class="card-tools me-n1">
                            <ul class="btn-toolbar gx-1">
                                <li>
                                    <a href="#" class="btn btn-icon search-toggle toggle-search" data-target="search"><em class="icon ni ni-search"></em></a>
                                </li><!-- li -->
                                <li class="btn-toolbar-sep"></li><!-- li -->
                                <li>
                                    <div class="toggle-wrap">
                                        <a href="#" class="btn btn-icon btn-trigger toggle" data-target="cardTools"><em class="icon ni ni-menu-right"></em></a>
                                        <div class="toggle-content" data-content="cardTools">
                                            <ul class="btn-toolbar gx-1">
                                                <li class="toggle-close">
                                                    <a href="#" class="btn btn-icon btn-trigger toggle" data-target="cardTools"><em class="icon ni ni-arrow-left"></em></a>
                                                </li><!-- li -->
                                                <li>
                                                    <div class="dropdown">
                                                        <a href="#" class="btn btn-trigger btn-icon dropdown-toggle" data-bs-toggle="dropdown">
                                                            <em class="icon ni ni-setting"></em>
                                                        </a>
                                                        <div class="dropdown-menu dropdown-menu-xs dropdown-menu-end">
                                                            <ul class="link-check">
                                                                <li><span>Show</span></li>
                                                                <li class="@(ViewBag.PageSize == 10 ? "active" : "")"><a href="/approver-orders?page=1&amp;pageSize=10&amp;searchTerm=@ViewBag.SearchTerm">10</a></li>
                                                                <li class="@(ViewBag.PageSize == 20 ? "active" : "")"><a href="/approver-orders?page=1&amp;pageSize=20&amp;searchTerm=@ViewBag.SearchTerm">20</a></li>
                                                                <li class="@(ViewBag.PageSize == 50 ? "active" : "")"><a href="/approver-orders?page=1&amp;pageSize=50&amp;searchTerm=@ViewBag.SearchTerm">50</a></li>
                                                            </ul>
                                                        </div>
                                                    </div><!-- .dropdown -->
                                                </li><!-- li -->
                                            </ul><!-- .btn-toolbar -->
                                        </div><!-- .toggle-content -->
                                    </div><!-- .toggle-wrap -->
                                </li><!-- li -->
                            </ul><!-- .btn-toolbar -->
                        </div><!-- .card-tools -->
                    </div><!-- .card-title-group -->
                    <div class="card-search search-wrap" data-search="search">
                        <div class="card-body">
                            <div class="search-content">
                                <form action="/approver-orders" method="get">
                                    <a href="#" class="search-back btn btn-icon toggle-search" data-target="search"><em class="icon ni ni-arrow-left"></em></a>
                                    <input name="searchTerm" type="text" class="form-control border-transparent form-focus-none" placeholder="Search by name, order #, mpesa code" value="@ViewBag.SearchTerm">
                                    <button type="submit" class="search-submit btn btn-icon"><em class="icon ni ni-search"></em></button>
                                </form>
                            </div>
                        </div>
                    </div><!-- .card-search -->
                </div><!-- .card-inner -->

                <div class="card-inner p-0">
                    <div class="table-responsive">
                    <div class="nk-tb-list nk-tb-ulist">
                        <div class="nk-tb-item nk-tb-head">
                            <div class="nk-tb-col nk-tb-col-check">
                                <div class="custom-control custom-control-sm custom-checkbox notext">
                                    <input type="checkbox" class="custom-control-input" id="cid">
                                    <label class="custom-control-label" for="cid"></label>
                                </div>
                            </div>

                            <div class="nk-tb-col"><span class="sub-text">Customer</span></div>
                            <div class="nk-tb-col"><span class="sub-text">Email</span></div>
                            <div class="nk-tb-col"><span class="sub-text">Phone</span></div>
                            <div class="nk-tb-col"><span class="sub-text">Dealer Name</span></div>
                            <div class="nk-tb-col"><span class="sub-text">Mpesa Code</span></div>
                            <div class="nk-tb-col"><span class="sub-text">Joined</span></div>
                            <div class="nk-tb-col"><span class="sub-text">Status</span></div>
                            <div class="nk-tb-col text-end"><span class="sub-text">Actions</span></div>
                        </div><!-- .nk-tb-item -->
                        @{
                            foreach (var order in Model.AwaitingApprovals)
                            {

                                <div class="nk-tb-item">
                                    <div class="nk-tb-col nk-tb-col-check">
                                        <div class="custom-control custom-control-sm custom-checkbox notext">
                                            <input type="checkbox" class="custom-control-input" id="cid1">
                                            <label class="custom-control-label" for="cid1"></label>
                                        </div>
                                    </div>
                                    <div class="nk-tb-col">
                                        <a href="/order-details/@order.OrderId">
                                            <div class="user-card">
                                                <div class="user-avatar xs bg-primary">
                                                    <span>@GetInitials(order.FirstName + " " + order.LastName)</span>
                                                </div>
                                                <div class="user-name">
                                                    <span class="tb-lead">@order.FirstName @order.LastName  <span class="dot dot-success d-lg-none ms-1"></span></span>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="nk-tb-col">
                                        <span class="sub-text">@order.Email</span>
                                    </div>
                                    <div class="nk-tb-col">
                                        <span class="sub-text">@order.Phone</span>
                                    </div>
                                    <div class="nk-tb-col">
                                        <span class="sub-text">@order.DealerRef</span>
                                    </div>
                                    <div class="nk-tb-col">
                                        <div class="icon-text">
                                            <em class="text-blue icon ni ni-visa"></em>
                                            <span class="sub-text">@order.MpesaDepositRef</span>
                                        </div>
                                    </div>
                                    <div class="nk-tb-col">
                                        <span class="sub-text">@order.DateCreated</span>
                                    </div>
                                    <div class="nk-tb-col">
                                        <span class="@SetStatusBadge(order.Status)">@order.Status</span>
                                    </div>
                                    <div class="nk-tb-col nk-tb-col-tools">
                                        <ul class="nk-tb-actions gx-1">
                                            <li class="nk-tb-action-hidden">
                                                <a href="/order-details/@order.OrderId" class="btn btn-trigger btn-icon" data-bs-toggle="tooltip" data-bs-placement="top" title="Details">
                                                    <em class="icon ni ni-eye-fill"></em>
                                                </a>
                                            </li>
                                            <li class="nk-tb-action-hidden">
                                                <a href="#" class="btn btn-trigger btn-icon" data-bs-toggle="tooltip" data-bs-placement="top" title="Send Email">
                                                    <em class="icon ni ni-mail-fill"></em>
                                                </a>
                                            </li>
                                            <li class="nk-tb-action-hidden">
                                                <a href="#" class="btn btn-trigger btn-icon" data-bs-toggle="tooltip" data-bs-placement="top" title="Suspend">
                                                    <em class="icon ni ni-cross-fill-c"></em>
                                                </a>
                                            </li>
                                            <li>
                                                <div class="drodown">
                                                    <a href="#" class="dropdown-toggle btn btn-icon btn-trigger" data-bs-toggle="dropdown"><em class="icon ni ni-more-h"></em></a>
                                                    <div class="dropdown-menu dropdown-menu-end">
                                                        <ul class="link-list-opt no-bdr">
                                                            <li><a href="/order-details/@order.OrderId"><em class="icon ni ni-eye"></em><span>View Details</span></a></li>
                                                            <li><a href="#"><em class="icon ni ni-mail"></em><span>Send Mail</span></a></li>
                                                            <li><a href="#"><em class="icon ni ni-cart"></em><span>Orders</span></a></li>
                                                            <li><a href="#"><em class="icon ni ni-na"></em><span>Suspend</span></a></li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            }
                        }


                        </div><!-- .nk-tb-list -->
                    </div><!-- responsive -->
                </div><!-- .card-inner -->

                <div class="card-inner">
                    <div class="nk-block-between-md g-3">
                        <div class="g">
                            <ul class="pagination justify-content-center justify-content-md-start">
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/approver-orders?page=@(Model.CurrentPage - 1)">Prev</a>
                                    </li>
                                }

                                @{
                                    var maxVisiblePages = 5;
                                    var startPage = Math.Max(1, Model.CurrentPage - 2);
                                    var endPage = Math.Min(Model.TotalPages, startPage + maxVisiblePages - 1);
                                    if (endPage - startPage < maxVisiblePages - 1)
                                    {
                                        startPage = Math.Max(1, endPage - maxVisiblePages + 1);
                                    }
                                }

                                @if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/approver-orders?page=1">1</a>
                                    </li>
                                    <li class="page-item">
                                        <span class="page-link"><em class="icon ni ni-more-h"></em></span>
                                    </li>
                                }

                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="/approver-orders?page=@i">@i</a>
                                    </li>
                                }

                                @if (endPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <span class="page-link"><em class="icon ni ni-more-h"></em></span>
                                    </li>
                                    <li class="page-item">
                                        <a class="page-link" href="/approver-orders?page=@Model.TotalPages">@Model.TotalPages</a>
                                    </li>
                                }

                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/approver-orders?page=@(Model.CurrentPage + 1)">Next</a>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="g">
                            <div class="pagination-goto d-flex justify-content-center justify-content-md-start gx-3">
                                <div>Page</div>
                                <div>
                                    <select class="form-select js-select2"
                                            data-search="on"
                                            data-dropdown="xs center"
                                            onchange="location.href='/approver-orders?page=' + this.value">
                                        >
                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            <option value="@i" @(Model.CurrentPage == i ? "selected" : "")>
                                                @i
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div>OF @Model.TotalPages</div>
                            </div>
                        </div><!-- .pagination-goto -->
                    </div><!-- .nk-block-between -->
                </div><!-- .card-inner -->

            </div><!-- .card-inner-group -->
        </div><!-- .card -->
    </div><!-- .nk-block -->
</div>