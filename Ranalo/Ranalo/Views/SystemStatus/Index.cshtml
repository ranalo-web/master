@functions {
    private string SetLockStatusBadge(bool status)
    {
        var statusClass = "";

        if (status == false)
        {
            return "badge badge-dim bg-danger";
        }
        else
        {
            return "badge badge-dim bg-success";
        }

        return statusClass;
    }

    private string SetLockStatusTextBadge(bool status)
    {
        if (status == false)
        {
            return "LOCKED";
        }
        else
        {
            return "UNLOCKED";
        }
    }
}

