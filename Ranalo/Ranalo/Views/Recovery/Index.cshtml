@using Ranalo.Models
@using Ranalo.Services
@model RecoveryListViewModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var tabs = new[] { ("open", "In progress"), ("moved", "Moved to Knox / Transsion"), ("ended", "Not catchable / closed"), ("all", "All") };
    string BrandOf(LockRecovery r) => RecoveryRules.IsSamsung(r.Make, r.Model) ? "samsung" : RecoveryRules.IsTranssion(r.Make) ? "transsion" : "other";
    string ResultOf(LockRecovery r) => r.LastStep == null ? "none" : r.LastStepSuccess == true ? "ok" : "failed";
    var statusOptions = Model.Recoveries.Select(r => RecoveryStatus.Label(r.Status, r.Make)).Distinct().OrderBy(s => s).ToList();
    var reasonOptions = Model.Recoveries.Select(r => r.Reason).Distinct().OrderBy(s => s).ToList();
    var stepOptions = Model.Recoveries.Where(r => r.LastStep != null).Select(r => r.LastStep!).Distinct().OrderBy(s => s).ToList();
}

<link rel="stylesheet" href="~/css/watchlist-table.css?v=4">

<div class="nk-content-body">
    <div class="nk-block-head nk-block-head-sm">
        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">Recovery</h3>
            <div class="nk-block-des text-soft">
                <p>Phones we're trying to get back under a lock, e.g. a Nuovo phone whose lock was removed. Samsung phones can be moved to Knox and itel, TECNO and Infinix phones to Transsion, one step at a time. Once the lock works, move it and the daily lock jobs use that locker from then on. A phone that can't be caught stays with its current locker.</p>
            </div>
        </div>
    </div>

    @if (TempData["RecoveryResult"] is string result)
    {
        <div class="alert alert-success alert-icon alert-dismissible">
            <em class="icon ni ni-check-circle"></em> @result
            <button class="close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["RecoveryError"] is string error)
    {
        <div class="alert alert-danger alert-icon alert-dismissible">
            <em class="icon ni ni-cross-circle"></em> @error
            <button class="close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="nk-block">
        <div class="card card-bordered">
            <div class="card-inner card-inner-md">
                <h6 class="title mb-2">Add a phone</h6>
                <form action="/recovery/add" method="post" class="d-flex flex-wrap align-items-end" style="gap:8px;">
                    <div>
                        <label class="form-label small mb-1" for="accountNo">Account</label>
                        <input type="number" id="accountNo" name="accountNo" required class="form-control form-control-sm" style="width:160px;" placeholder="e.g. 8511324" />
                    </div>
                    <div>
                        <label class="form-label small mb-1" for="reason">Reason</label>
                        <select id="reason" name="reason" class="form-select form-select-sm" style="width:auto;">
                            @foreach (var reason in RecoveryReason.All)
                            {
                                <option value="@reason">@reason</option>
                            }
                        </select>
                    </div>
                    <div style="flex:1; min-width:200px;">
                        <label class="form-label small mb-1" for="notes">Notes</label>
                        <input type="text" id="notes" name="notes" maxlength="1000" class="form-control form-control-sm" />
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary">Add</button>
                </form>
                <div id="lookup" class="small text-soft mt-2"></div>
            </div>
        </div>
    </div>

    <div class="nk-block">
        <div class="card card-bordered">
            <div class="card-inner card-inner-md">
                <ul class="nav nav-tabs nav-tabs-s2" style="border:0;">
                    @foreach (var (key, label) in tabs)
                    {
                        <li class="nav-item"><a class="nav-link @(Model.Status == key ? "active" : "")" href="/recovery?status=@key">@label</a></li>
                    }
                </ul>
            </div>
            <div class="card-inner p-0 border-top">
                @* Column filters: narrow the list without reloading. *@
                <div class="card-inner py-2 d-flex flex-wrap align-items-end" style="gap:8px;" id="filters">
                    <div style="flex:1; min-width:160px;">
                        <label class="form-label small mb-1" for="fSearch">Search</label>
                        <input type="search" id="fSearch" class="form-control form-control-sm" placeholder="Account, IMEI, customer or dealer" />
                    </div>
                    <div>
                        <label class="form-label small mb-1" for="fStatus">Status</label>
                        <select id="fStatus" class="form-select form-select-sm" style="width:auto;">
                            <option value="">All</option>
                            @foreach (var s in statusOptions) { <option value="@s">@s</option> }
                        </select>
                    </div>
                    <div>
                        <label class="form-label small mb-1" for="fBrand">Phone</label>
                        <select id="fBrand" class="form-select form-select-sm" style="width:auto;">
                            <option value="">All</option>
                            <option value="samsung">Samsung (Knox)</option>
                            <option value="transsion">itel / TECNO / Infinix (Transsion)</option>
                            <option value="other">Other brands</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label small mb-1" for="fReason">Reason</label>
                        <select id="fReason" class="form-select form-select-sm" style="width:auto;">
                            <option value="">All</option>
                            @foreach (var s in reasonOptions) { <option value="@s">@s</option> }
                        </select>
                    </div>
                    <div>
                        <label class="form-label small mb-1" for="fStep">Last step</label>
                        <select id="fStep" class="form-select form-select-sm" style="width:auto;">
                            <option value="">All</option>
                            @foreach (var s in stepOptions) { <option value="@s">@s</option> }
                        </select>
                    </div>
                    <div>
                        <label class="form-label small mb-1" for="fResult">Result</label>
                        <select id="fResult" class="form-select form-select-sm" style="width:auto;">
                            <option value="">All</option>
                            <option value="ok">OK</option>
                            <option value="failed">Failed</option>
                            <option value="none">No steps yet</option>
                        </select>
                    </div>
                    <div class="small text-soft pb-1" id="fCount"></div>
                </div>
                <form method="post" action="/recovery/send-many" id="sendForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="status" value="@Model.Status" />
                <div class="card-inner border-top py-2 d-flex flex-wrap align-items-center" style="gap:8px;">
                    <span class="small text-soft" id="selCount">0 ticked</span>
                    <button type="submit" class="btn btn-sm btn-primary"
                            onclick="return confirmSend();"
                            title="Samsung: Send to Knox (Veritech upload). itel/TECNO/Infinix: Send to Transsion. Only phones still being investigated can be ticked.">Send to Knox / Transsion</button>
                    <span class="small text-soft">Only phones still "Investigating" can be ticked. Knox phones are approved by the daily job once they reach Knox.</span>
                </div>
                <div class="table-responsive border-top">
                    <table class="table mb-0" style="white-space:nowrap;" id="recoveries">
                        <thead>
                            <tr>
                                <th class="wl-th" style="width:32px;"><input type="checkbox" id="pickAll" title="Tick every phone shown that can be sent" /></th>
                                @* Narrow screens keep account, status and the last update. *@
                                <th class="wl-th">Account</th>
                                <th class="wl-th d-none d-md-table-cell">Phone</th>
                                <th class="wl-th d-none d-xl-table-cell">IMEI</th>
                                <th class="wl-th d-none d-lg-table-cell">Customer</th>
                                <th class="wl-th d-none d-xxl-table-cell">Dealer</th>
                                <th class="wl-th d-none d-xl-table-cell">Reason</th>
                                <th class="wl-th d-none d-lg-table-cell">Locker now</th>
                                <th class="wl-th d-none d-sm-table-cell">Status</th>
                                <th class="wl-th">Last update</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Recoveries.Count == 0)
                            {
                                <tr><td colspan="10" class="text-center text-soft py-4">No phones here.</td></tr>
                            }
                            @foreach (var r in Model.Recoveries)
                            {
                                <tr class="rec-row"
                                    data-search="@($"{r.AccountNo} {r.Imei} {r.CustomerName} {r.DealerName}".ToLowerInvariant())"
                                    data-status="@RecoveryStatus.Label(r.Status, r.Make)" data-brand="@BrandOf(r)" data-reason="@r.Reason"
                                    data-step="@(r.LastStep ?? "")" data-result="@ResultOf(r)">
                                    <td>
                                        @if (RecoveryRules.FirstSendStep(r) is { } firstStep)
                                        {
                                            <input type="checkbox" name="ids" value="@r.Id" class="pick" title="@(firstStep == RecoveryAction.TranssionSend ? "Send to Transsion" : "Send to Knox")" />
                                        }
                                    </td>
                                    <td>
                                        <a href="/recovery/@r.Id" class="fw-medium">@r.AccountNo</a>
                                        <div class="small text-soft d-md-none">@r.Make @r.Model</div>
                                        <div class="d-sm-none mt-1"><span class="badge @(RecoveryStatus.IsMoved(r.Status) ? "bg-success" : r.Status == RecoveryStatus.NotCatchable ? "bg-danger" : "bg-light text-dark")">@RecoveryStatus.Label(r.Status, r.Make)</span></div>
                                    </td>
                                    <td class="d-none d-md-table-cell">@r.Make @r.Model</td>
                                    <td class="d-none d-xl-table-cell">@r.Imei</td>
                                    <td class="d-none d-lg-table-cell">@r.CustomerName</td>
                                    <td class="d-none d-xxl-table-cell">@r.DealerName</td>
                                    <td class="d-none d-xl-table-cell">@r.Reason</td>
                                    <td class="d-none d-lg-table-cell">@RecoveryRules.LockGroupName(r.CurrentLockGroup) @(r.Locked == true ? "· locked" : r.Locked == false ? "· unlocked" : "")</td>
                                    <td class="d-none d-sm-table-cell"><span class="badge @(RecoveryStatus.IsMoved(r.Status) ? "bg-success" : r.Status == RecoveryStatus.NotCatchable ? "bg-danger" : "bg-light text-dark")">@RecoveryStatus.Label(r.Status, r.Make)</span></td>
                                    <td style="white-space:normal; min-width:170px; max-width:360px; overflow-wrap:anywhere;">
                                        @if (r.LastStep != null)
                                        {
                                            <div>
                                                <span class="fw-medium">@r.LastStep</span>
                                                <span class="badge badge-dim @(r.LastStepSuccess == true ? "bg-success" : "bg-danger")">@(r.LastStepSuccess == true ? "OK" : "Failed")</span>
                                                <span class="small text-soft">@r.LastStepAtUtc?.ToLocalTime().ToString("dd/MM HH:mm")</span>
                                            </div>
                                            <div class="small text-soft" title="@r.LastReply">@r.LastReplySummary</div>
                                        }
                                        else
                                        {
                                            <span class="small text-soft">@r.UpdatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // Column filters: every filter must match; the count shows how many are left.
    (function () {
        var ids = { search: 'fSearch', status: 'fStatus', brand: 'fBrand', reason: 'fReason', step: 'fStep', result: 'fResult' };
        var rows = Array.prototype.slice.call(document.querySelectorAll('#recoveries .rec-row'));
        var count = document.getElementById('fCount');
        function value(id) { var el = document.getElementById(id); return el ? el.value.trim() : ''; }
        function apply() {
            var q = value(ids.search).toLowerCase(), shown = 0;
            rows.forEach(function (tr) {
                var ok = (!q || tr.dataset.search.indexOf(q) >= 0)
                    && (!value(ids.status) || tr.dataset.status === value(ids.status))
                    && (!value(ids.brand) || tr.dataset.brand === value(ids.brand))
                    && (!value(ids.reason) || tr.dataset.reason === value(ids.reason))
                    && (!value(ids.step) || tr.dataset.step === value(ids.step))
                    && (!value(ids.result) || tr.dataset.result === value(ids.result));
                tr.style.display = ok ? '' : 'none';
                if (ok) shown++;
            });
            if (count) count.textContent = shown + ' of ' + rows.length + ' shown';
            // A filtered-out phone is never sent.
            rows.forEach(function (tr) {
                if (tr.style.display === 'none') { var c = tr.querySelector('.pick'); if (c) c.checked = false; }
            });
            updatePicked();
        }
        function picked() { return document.querySelectorAll('#recoveries .pick:checked').length; }
        function updatePicked() {
            var out = document.getElementById('selCount');
            if (out) out.textContent = picked() + ' ticked';
        }
        window.confirmSend = function () {
            var n = picked();
            if (n === 0) { alert('Tick at least one phone first.'); return false; }
            return confirm('Send ' + n + ' phone' + (n === 1 ? '' : 's') + ' to Knox / Transsion?');
        };
        var all = document.getElementById('pickAll');
        if (all) all.addEventListener('change', function () {
            rows.forEach(function (tr) {
                var c = tr.querySelector('.pick');
                if (c) c.checked = all.checked && tr.style.display !== 'none';
            });
            updatePicked();
        });
        document.querySelectorAll('#recoveries .pick').forEach(function (c) { c.addEventListener('change', updatePicked); });
        Object.keys(ids).forEach(function (k) {
            var el = document.getElementById(ids[k]);
            if (el) el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'input', apply);
        });
        apply();
    })();

    (function () {
        var input = document.getElementById('accountNo');
        var out = document.getElementById('lookup');
        var timer;
        input.addEventListener('input', function () {
            clearTimeout(timer);
            var value = input.value.trim();
            if (value.length < 5) { out.textContent = ''; return; }
            timer = setTimeout(function () {
                fetch('/recovery/lookup?accountNo=' + encodeURIComponent(value))
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (d) {
                        if (input.value.trim() !== value) return;
                        if (!d) { out.textContent = 'No device on account ' + value + '.'; return; }
                        var lockers = { 2: 'Knox', 3: 'Transsion' };
                        out.textContent = [d.make, d.model].filter(Boolean).join(' ') + ', IMEI ' + (d.imei || '?')
                            + ', ' + (d.customerName || 'no name') + (d.dealerName ? ' (' + d.dealerName + ')' : '')
                            + ', on ' + (lockers[d.lockGroup] || 'Nuovo') + '.';
                    })
                    .catch(function () { out.textContent = ''; });
            }, 300);
        });
    })();
</script>
