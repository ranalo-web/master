@model Ranalo.Models.PhoneCardModel
@{
    var now = DateTime.UtcNow;
    // Not seen for more than 3 days: worth a look (a lock can't reach it).
    var stale = Model.LastConnectedUtc.HasValue && now - Model.LastConnectedUtc.Value > TimeSpan.FromDays(3);
    static string Or(string? s) => string.IsNullOrWhiteSpace(s) ? "-" : s.Trim();
    string Cap(string? s) => string.IsNullOrWhiteSpace(s) ? "-" : char.ToUpperInvariant(s.Trim()[0]) + s.Trim()[1..];

    // Always shown, in this order; the optional ones only when we have them.
    var rows = new List<(string Label, string Value, string? Note, string? Css)>
    {
        ("Make", Cap(Model.Make), null, null),
        ("Model", Or(Model.Model), null, null),
        ("IMEI", Or(Model.Imei), string.IsNullOrWhiteSpace(Model.Imei2) ? null : "IMEI 2: " + Model.Imei2, null),
        ("Lock service", Model.Service, null, null),
        ("Lock status", Model.Locked ? "Locked" : "Unlocked", null, Model.Locked ? "text-danger" : "text-success"),
        ("Next lock", Model.NextLock?.ToString("dd MMM yyyy, HH:mm") ?? Or(Model.NextLockText), null, null),
        ("Last connected",
            Model.LastConnectedUtc?.AddHours(3).ToString("dd MMM yyyy, HH:mm") ?? "Not recorded",
            Model.LastConnectedUtc.HasValue ? Ranalo.Models.PhoneCardModel.Ago(Model.LastConnectedUtc.Value, now) + (stale ? ": not seen lately" : "") : null,
            stale ? "text-danger" : null),
        ("Enrolled", Model.EnrolledUtc?.AddHours(3).ToString("dd MMM yyyy") ?? "-", null, null),
        ("Enrolment", Cap(Model.Enrolment), null, null),
        ("SIM-swap lock", Model.SimSwapLock ? "On" : "Off", null, null),
    };
    if (!string.IsNullOrWhiteSpace(Model.Serial)) rows.Add(("Serial no.", Model.Serial.Trim(), null, null));
    if (!string.IsNullOrWhiteSpace(Model.OsVersion)) rows.Add(("Android", Model.OsVersion.Trim(), null, null));
    if (!string.IsNullOrWhiteSpace(Model.SimNumber)) rows.Add(("SIM number", Model.SimNumber.Trim(), null, null));
    if (!string.IsNullOrWhiteSpace(Model.LockAppVersion)) rows.Add(("Lock app", Model.LockAppVersion.Trim(), null, null));
}
<style>
    .pc { border: 1px solid #e5e9f2; border-radius: 10px; overflow: hidden; }
    .pc-head { display: flex; align-items: center; gap: 14px; padding: 14px 16px; flex-wrap: wrap; background: #f8f9fc; border-bottom: 1px solid #e5e9f2; }
    .pc-icon { width: 46px; height: 46px; border-radius: 10px; background: #213b4a; color: #fff; display: grid; place-items: center; font-size: 24px; flex: none; }
    .pc-name { flex: 1; min-width: 0; }
    .pc-name .t { font-weight: 700; font-size: 16px; overflow-wrap: anywhere; }
    .pc-name .s { font-size: 13px; color: #8094ae; overflow-wrap: anywhere; }
    .pc-badges { display: flex; gap: 6px; flex-wrap: wrap; }
    .pc-badge { font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 999px; white-space: nowrap; }
    .pc-badge.locked { background: #fde8e8; color: #c0392b; }
    .pc-badge.open { background: #e6f6ee; color: #1e8e5a; }
    .pc-badge.svc { background: #eef1f6; color: #3c4d62; }
    .pc-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pc-row { display: flex; justify-content: space-between; gap: 12px; padding: 9px 16px; border-bottom: 1px solid #f0f2f7; min-width: 0; }
    .pc-row .k { color: #8094ae; white-space: nowrap; }
    .pc-row .v { font-weight: 600; text-align: right; overflow-wrap: anywhere; min-width: 0; }
    .pc-row .v small { display: block; font-weight: 400; color: #8094ae; }
    .pc-specs { display: flex; gap: 6px; flex-wrap: wrap; padding: 10px 16px; }
    .pc-spec { font-size: 12px; background: #f5f6fa; border: 1px solid #e5e9f2; border-radius: 6px; padding: 2px 8px; }
    @@media (min-width: 768px) { .pc-row:nth-child(odd) { border-right: 1px solid #f0f2f7; } }
    @@media (max-width: 767px) { .pc-list { grid-template-columns: 1fr; } }
</style>
<div class="pc">
    <div class="pc-head">
        <div class="pc-icon"><em class="icon ni ni-mobile"></em></div>
        <div class="pc-name">
            <div class="t">@Model.Title</div>
            <div class="s">@(Model.Specs.Any() ? string.Join(" · ", Model.Specs) : "IMEI " + Or(Model.Imei))</div>
        </div>
        <div class="pc-badges">
            <span class="pc-badge @(Model.Locked ? "locked" : "open")">@(Model.Locked ? "Locked" : "Unlocked")</span>
            <span class="pc-badge svc">@Model.Service</span>
        </div>
    </div>
    <div class="pc-list">
        @foreach (var r in rows)
        {
            <div class="pc-row">
                <span class="k">@r.Label</span>
                <span class="v @r.Css">@r.Value@if (r.Note != null) {<small>@r.Note</small>}</span>
            </div>
        }
    </div>
</div>
