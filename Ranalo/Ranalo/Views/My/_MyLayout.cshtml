@{
    // The customer app's own layout: nothing from the staff site, built for
    // a phone first. Signed-in pages pass ViewBag.Tab for the bottom bar.
    var tab = ViewBag.Tab as string;
    var unread = ViewBag.Unread is int u ? u : 0;
    dynamic? newest = ViewBag.NewestNotice;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#213b4a" />
    <meta name="robots" content="noindex" />
    <title>@(ViewBag.Title ?? "Ranalo") · Ranalo</title>
    <link rel="icon" href="/images/brand/ranalo-icon.png" />
    <link rel="manifest" href="/my/manifest.json" />
    <link rel="apple-touch-icon" href="/images/brand/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <style>
        :root {
            --brand: #213b4a; --brand-dark: #172a36; --brand-soft: #e7edf1; --peach: #fcdfb0; --peach-dark: #d0b999;
            --ink: #16202a; --soft: #5b6b7b; --line: #e3e8ee; --page: #f4f6f8; --card: #ffffff;
            --warn: #8a4b00; --warn-soft: #fff1da; --bad: #b3261e; --bad-soft: #fdecea; --good: #1d6b46; --good-soft: #e5f4ec;
        }
        * { box-sizing: border-box; }
        html, body { margin: 0; background: var(--page); color: var(--ink);
            font: 16px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; -webkit-text-size-adjust: 100%; }
        a { color: var(--brand); }
        .top { background: var(--brand); color: #fff; border-bottom: 4px solid var(--peach); padding: calc(14px + env(safe-area-inset-top)) 16px 14px;
            display: flex; align-items: center; justify-content: space-between; gap: 12px; }
        .brand { font-weight: 700; font-size: 20px; letter-spacing: .3px; color: #fff; text-decoration: none; display: flex; align-items: center; gap: 10px; }
        .brand img { width: 34px; height: 34px; border-radius: 8px; background: #fff; padding: 3px; }
        .top form button { background: transparent; border: 1px solid rgba(255,255,255,.5); color: #fff;
            border-radius: 999px; padding: 6px 12px; font-size: 14px; }
        main { max-width: 560px; margin: 0 auto; padding: 16px 16px calc(96px + env(safe-area-inset-bottom)); }
        .card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 16px; margin-bottom: 12px; }
        h1 { font-size: 22px; margin: 4px 0 12px; }
        h2 { font-size: 16px; margin: 0 0 8px; color: var(--soft); font-weight: 600; }
        .muted { color: var(--soft); font-size: 14px; }
        .big { font-size: 28px; font-weight: 700; }
        .row { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--line); }
        .row:last-child { border-bottom: 0; }
        .row span:last-child { font-weight: 600; text-align: right; }
        label { display: block; font-weight: 600; margin: 12px 0 6px; }
        input { width: 100%; font-size: 18px; padding: 14px; border: 1px solid #c7d0da; border-radius: 10px; background: #fff; }
        input:focus { outline: 3px solid var(--brand-soft); border-color: var(--brand); }
        .btn { display: block; width: 100%; text-align: center; border: 0; border-radius: 12px; padding: 15px;
            font-size: 17px; font-weight: 700; background: var(--brand); color: #fff; text-decoration: none; margin-top: 14px; }
        .btn:active { background: var(--brand-dark); }
        .btn.ghost { background: transparent; color: var(--brand); border: 1px solid var(--brand); }
        .note { border-radius: 10px; padding: 12px 14px; margin-bottom: 12px; font-size: 15px; }
        .note.bad { background: var(--bad-soft); color: var(--bad); }
        .note.warn { background: var(--warn-soft); color: var(--warn); }
        .note.good { background: var(--good-soft); color: var(--good); }
        .bar { height: 12px; background: var(--brand-soft); border-radius: 999px; overflow: hidden; margin: 10px 0 6px; }
        .bar > div { height: 100%; background: linear-gradient(90deg, var(--peach-dark), var(--peach)); border-radius: 999px; }
        .bar { border: 1px solid var(--peach-dark); }
        .device { display: flex; gap: 14px; align-items: center; }
        .device img, .device .ph { width: 72px; height: 72px; object-fit: contain; border-radius: 12px; background: var(--page); flex: none; }
        .device .ph { display: grid; place-items: center; font-size: 34px; }
        .tabs { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-top: 1px solid var(--line);
            display: flex; padding-bottom: env(safe-area-inset-bottom); }
        .tabs a { flex: 1; min-width: 0; text-align: center; padding: 10px 2px 12px; font-size: 12px; color: var(--soft); text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .tabs a b { display: block; font-size: 20px; line-height: 1.2; }
        .tabs a.on { color: var(--brand); font-weight: 700; }
        .steps { margin: 0; padding-left: 20px; } .steps li { margin: 4px 0; }
        table { width: 100%; border-collapse: collapse; font-size: 15px; }
        td { padding: 10px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
        td:last-child { text-align: right; }
        .code-input { letter-spacing: 10px; text-align: center; font-size: 26px; font-weight: 700; }
        .tabs a b { position: relative; }
        .dot { position: absolute; top: -4px; right: -14px; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 999px;
            background: var(--bad); color: #fff; font-size: 11px; font-weight: 700; line-height: 18px; text-align: center; }
        .toast { position: fixed; left: 12px; right: 12px; top: calc(12px + env(safe-area-inset-top)); z-index: 50; max-width: 536px; margin: 0 auto;
            background: var(--brand); color: #fff; border-left: 6px solid var(--peach); border-radius: 12px; padding: 12px 14px;
            box-shadow: 0 8px 24px rgba(0,0,0,.25); text-decoration: none; display: block; }
        .toast[hidden] { display: none; }
        .toast-kind { display: inline-block; font-size: 12px; font-weight: 700; color: var(--brand); background: var(--peach); border-radius: 999px; padding: 1px 8px; }
        .toast-title { display: block; font-weight: 700; margin-top: 6px; }
        .toast-hint { display: block; font-size: 13px; opacity: .8; }
    </style>
</head>
<body>
    <header class="top">
        <a class="brand" href="/my"><img src="/images/brand/ranalo-icon.png" alt="" />Ranalo</a>
        @if (tab != null)
        {
            <form method="post" action="/my/logout">@Html.AntiForgeryToken()<button type="submit">@(ViewBag.Preview is true ? "Exit preview" : "Sign out")</button></form>
        }
    </header>
    @if (ViewBag.Preview is true)
    {
        <div style="background:#fcdfb0;color:#213b4a;padding:10px 16px;font-size:14px;font-weight:600;text-align:center;">
            Staff preview by @ViewBag.PreviewBy: what the customer sees, read-only. Nothing is paid, saved or sent.
        </div>
    }
    <main>
        @RenderBody()
        <p class="muted" style="text-align:center;margin-top:20px;">Help: call @ViewBag.HelpLine · <a href="/my/privacy">Privacy policy</a></p>
    </main>
    @if (tab != null)
    {
        <nav class="tabs">
            <a href="/my" class="@(tab == "home" ? "on" : "")"><b>⌂</b>Account</a>
            <a href="/my/pay" class="@(tab == "pay" ? "on" : "")"><b>＋</b>Pay</a>
            <a href="/my/statement" class="@(tab == "statement" ? "on" : "")"><b>☰</b>Statement</a>
            <a href="/my/inbox" class="@(tab == "inbox" ? "on" : "")"><b>✉@if (unread > 0) {<span class="dot" id="inbox-count">@(unread > 99 ? "99+" : unread.ToString())</span>}</b>Notifications</a>
            <a href="/my/details" class="@(tab == "details" ? "on" : "")"><b>☺</b>Details</a>
        </nav>
    }
    @if (tab != null && ViewBag.Preview is not true)
    {
        @* New messages: a pop-up for each new one, once (remembered in this
           browser), and a check every minute while the app is open. *@
        <a id="toast" class="toast" href="/my/inbox" hidden>
            <span class="toast-kind" id="toast-kind"></span>
            <span class="toast-title" id="toast-title"></span>
            <span class="toast-hint">Tap to read</span>
        </a>
        <script>
            (function () {
                var key = 'ranalo.lastNotice';
                function seen() { try { return Number(localStorage.getItem(key) || 0); } catch (e) { return 0; } }
                function remember(at) { try { localStorage.setItem(key, String(at)); } catch (e) { } }
                function show(n) {
                    if (!n || !n.at || n.at <= seen() || location.pathname === '/my/inbox') return;
                    remember(n.at);
                    document.getElementById('toast-kind').textContent = n.kind || 'Message';
                    document.getElementById('toast-title').textContent = n.title || 'New message from Ranalo';
                    var t = document.getElementById('toast');
                    t.hidden = false;
                    setTimeout(function () { t.hidden = true; }, 8000);
                    var badge = document.getElementById('inbox-count');
                    if (n.unread && badge) badge.textContent = n.unread > 99 ? '99+' : n.unread;
                }
                @if (newest != null)
                {
                    <text>show({ title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)newest.Title)), kind: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)newest.Kind)), at: @newest.At, unread: @unread });</text>
                }
                if (location.pathname === '/my/inbox') { remember(Date.now() * 10000 + 621355968000000000); }
                setInterval(function () {
                    if (document.hidden) return;
                    fetch('/my/notifications', { credentials: 'same-origin', cache: 'no-store' })
                        .then(function (r) { return r.ok ? r.json() : null; })
                        .then(function (n) {
                            if (!n) return;
                            if (n.unread > 0 && !document.getElementById('inbox-count')) location.reload();
                            else show(n);
                        })
                        .catch(function () { });
                }, 60000);
            })();
        </script>
    }
    <script>
        // Installable app + offline page (wwwroot/my/sw.js). Never stores account pages.
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/my/sw.js', { scope: '/my/' }).catch(function () { });
        }
    </script>
</body>
</html>
