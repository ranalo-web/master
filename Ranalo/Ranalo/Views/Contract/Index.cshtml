                <div class="card-inner">
                    <div class="nk-block-between-md g-3">
                        <div class="g">
                            <ul class="pagination justify-content-center justify-content-md-start">
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/contracts?page=@(Model.CurrentPage - 1)">Prev</a>
                                    </li>
                                }

                                @{
                                    var maxVisiblePages = 5;
                                    var startPage = Math.Max(1, Model.CurrentPage - 2);
                                    var endPage = Math.Min(Model.TotalPages, startPage + maxVisiblePages - 1);
                                    if (endPage - startPage < maxVisiblePages - 1)
                                    {
                                        startPage = Math.Max(1, endPage - maxVisiblePages + 1);
                                    }
                                }

                                @if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/contracts?page=1">1</a>
                                    </li>
                                    <li class="page-item">
                                        <span class="page-link"><em class="icon ni ni-more-h"></em></span>
                                    </li>
                                }

                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="/contracts?page=@i">@i</a>
                                    </li>
                                }

                                @if (endPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <span class="page-link"><em class="icon ni ni-more-h"></em></span>
                                    </li>
                                    <li class="page-item">
                                        <a class="page-link" href="/contracts?page=@Model.TotalPages">@Model.TotalPages</a>
                                    </li>
                                }

                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="/contracts?page=@(Model.CurrentPage + 1)">Next</a>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="g">
