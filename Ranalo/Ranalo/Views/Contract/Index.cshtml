@section Scripts
{
        <script>
    document.addEventListener("DOMContentLoaded", function () {
            var modal = document.getElementById('edit-contract');
        modal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget; // Button that triggered the modal
            var deviceId = button.getAttribute('data-id');
                var name = button.getAttribute('data-name');
                var deposit = button.getAttribute('data-deposit');
                var daily = button.getAttribute('data-daily');
                var monthly = button.getAttribute('data-monthly');
                var weekly = button.getAttribute('data-weekly');
                var interval = button.getAttribute('data-interval');
                var loan = button.getAttribute('data-loan');
                var cost = button.getAttribute('data-cost');

                    document.getElementById('modalDeviceId').value = deviceId;
                    document.getElementById('hiddenDeviceId').value = deviceId;
                    
                document.getElementById('modalFirstName').value = name;
                document.getElementById('edit-deposit').value = deposit;
                document.getElementById('edit-daily').value = daily;
                document.getElementById('edit-monthly').value = monthly;
                document.getElementById('edit-weekly').value = weekly;
                document.getElementById('edit-interval').value = interval;
                document.getElementById('edit-loan').value = loan;
                document.getElementById('edit-cost').value = cost;

        });
    });
    </script>
}

