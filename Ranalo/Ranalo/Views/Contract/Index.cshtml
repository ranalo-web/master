                                <div class="form-control-wrap">
                                    <input type="text" class="form-control" name="displayDeviceId" disabled id="modalDeviceId" required>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="edit-deposit">Deposit</label>
                                <div class="form-control-wrap">
                                    <input type="number" step="0.01" class="form-control" name="deposit" id="edit-deposit" required>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
