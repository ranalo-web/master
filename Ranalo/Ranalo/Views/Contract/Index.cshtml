                                <label class="form-label" for="edit-monthly">Monthly</label>
                                <div class="form-control-wrap">
                                    <input type="number" name="monthly" step="0.01" class="form-control" id="edit-monthly" required>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="edit-interval">Interval</label>
                                <div class="form-control-wrap">
                                    <input type="text" name="interval" class="form-control" id="edit-interval" required>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="edit-loan">Total Loan</label>
                                <div class="form-control-wrap">
                                    <input type="number" name="loan" step="0.01" class="form-control" id="edit-loan" required>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" for="edit-cost">Total Cost</label>
                                <div class="form-control-wrap">
                                    <input type="number" step="0.01" name="cost" class="form-control" id="edit-cost" required>
                                </div>
