                                <div>Page</div>
                                <div>
                                    <select class="form-select js-select2"
                                            data-search="on"
                                            data-dropdown="xs center"
                                            onchange="location.href='/contracts?page=' + this.value">
                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            <option value="@i" @(Model.CurrentPage == i ? "selected" : "")>
                                                @i
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div>OF @Model.TotalPages</div>
                            </div>
                        </div><!-- .pagination-goto -->
                    </div><!-- .nk-block-between --><!-- .pagination -->
                </div><!-- .card-inner -->
