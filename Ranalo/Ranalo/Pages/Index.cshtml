@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
@functions
{

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "string.Empty";

        // Split by spaces and take first character of each word
        var initials = fullName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(word => char.ToUpper(word[0]))
            .Take(2) // only take first 2 initials
            .ToArray();

        return new string(initials);
    }

    double PercentageChange(double oldValue, double newValue)
    {
        if (oldValue == 0)
        {
            if (newValue == 0) return 0;   // no change
            return 100;                    // from 0 to something = 100% increase
        }

        double percentageChange = ((newValue - oldValue) / oldValue) * 100.0;
        percentageChange = Math.Round(percentageChange, 2);

        return percentageChange;
    }
}

